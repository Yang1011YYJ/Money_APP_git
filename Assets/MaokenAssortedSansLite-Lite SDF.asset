    characterSequence: "\u51FA\u767C\u4ECA\u5929\u8981\u5B58\u591A\u5C11\u9322?\u5143\u7DE8\u8F2F\u52A0\u522A&()./12358:?ABCDIMNOPQSWXabcdefghijklmnopqrstuvwxyz\u201D\u3002\u4E00\u4E0A\u4E0B\u4E0D\u4E14\u4E16\u4E1F\u4E3B\u4E4B\u4E86\u4E8B\u4EBA\u4EC0\u4ED6\u4EE3\u4EE5\u4EF6\u4F46\u4F60\u4F7F\u4F86\u500B\u503C\u505A\u50CF\u50F9\u5148\u5165\u5167\u5168\u51FA\u5206\u5225\u5230\u5236\u525B\u5287\u529B\u52D5\u5305\u5361\u539F\u53BB\u53C8\u53E3\u53EA\u53EB\u53EF\u53F0\u53F3\u540D\u5411\u5426\u5427\u5462\u54C1\u54E1\u54EA\u554F\u5594\u55CE\u5668\u56DE\u56E0\u5728\u5730\u591A\u5947\u597D\u59CB\u5B50\u5B9A\u5BA4\u5BB6\u5BB9\u5BDF\u5BE6\u5C07\u5C0D\u5C0F\u5C11\u5C31\u5C6C\u5DE5\u5DE6\u5DF2\u5E02\u5E63\u5EA6\u5EF6\u5F04\u5F35\u5F85\u5F8C\u5927\u53E3\u559D\u5287\u60C5\u5927\u7DB1\uFF1A\r\u78B0\u6A5F\u68B0\u96F6\u4EF6\u64CD\u8FD4\u56DE_-\u597D\u50CF\u9084\u9700\u8981\u4EC0\u9EBC\u6771\u897F......\u8F38\u5165\u683C\u5F0F\u932F\u8AA4\u65E5\u671F\u5408\u7406\n\u9019\u597D\u50CF\u662F\u611F\u61C9\u5F0F\u7684\u9580\uFF1F\u5E74\u6708\u65E5\u91D1\u984D\u8F38\u5165\u6B04\u4F4D\n\u4E3B\u89D2\u5728\u5BE6\u9A57\u5BA4\u4E2D\u9192\u4F86\uFF0C\u4E26\u4E0D\u77E5\u9053\u81EA\u5DF1\u8EAB\u8655\u54EA\u88E1\u3002\u4ED6\u8A18\u5F97\u81EA\u5DF1\u7684\u540D\u5B57\uFF0C\u4F46\u6C92\u6709\u95DC\u65BC\u5BB6\u7684\u8A18\u61B6\u3002\u4ED6\u767C\u73FE\u4ED6\u7684\u8A18\u61B6\u5F88\u597D\uFF0C\u4F46\u6C92\u6709\u5BB6\u7684\u8A18\u61B6\u5F88\u5947\u602A\uFF0C\u65BC\u662F\u4E3B\u89D2\u6C7A\u5B9A\u53BB\u5C0B\u627E\u6240\u8B02\u7684\u201D\u5BB6\u201D\u3002\u5F9E\u5BE6\u9A57\u5BA4\u5F97\u77E5\u81EA\u5DF1\u7684\u7269\u7A2E\u5F8C\uFF0C\u9593\u63A5\u5F97\u77E5\u81EA\u5DF1\u61C9\u8A72\u8981\u4F4F\u5728\u68EE\u6797\u88E1\u3002\r\n\u5C0B\u627E\u7684\u904E\u7A0B\u4E2D\u4E3B\u89D2\u88AB\u6162\u6162\u5F15\u5C0E\u524D\u5F80\u4E0D\u540C\u7684\u5730\u9EDE\uFF0C\u4ED6\u6703\u6162\u6162\u767C\u73FE\u4E00\u4E9B\u8207\u8A8D\u77E5\u4E2D\u5F88\u4E0D\u4E00\u6A23\u7684\u4E8B\u60C5\u3002\r\n\u4F46\u5728\u6700\u5F8C\u624D\u767C\u73FE\uFF0C\u539F\u4F86\u4ED6\u548C\u5176\u4ED6\u52D5\u7269\u8207\u773E\u4E0D\u540C\u3002\r\n\r\n\r\n\u2003\r\n\u6545\u4E8B\u8173\u672C\uFF1A\r\n\u6BB5\u843D\t\u756B\u9762\u8207\u5C0D\u8A71\t\u5099\u8A3B\r\n\u5BE6\u9A57\u5BA4\r\n\u5287\u60C5\u8D70\u5411\uFF1A\r\n\u4E3B\u89D2\u5728\u5BE6\u9A57\u5BA4\u9192\u4F86\uFF0C\u4ED6\u8A18\u5F97\u81EA\u5DF1\u7684\u540D\u5B57\u548C\u8EAB\u5206\uFF0C\u5F88\u591A\u5C0F\u7D30\u7BC0\u7684\u8A18\u61B6\u90FD\u8A18\u5F97\u6E05\u695A\uFF0C\u4F46\u4ED6\u4E0D\u8A18\u5F97\u5BB6\u5728\u54EA\u88E1\u3002\u5F9E\u5BE6\u9A57\u5BA4\u4EBA\u54E1\u53E3\u4E2D\u77E5\u9053\u81EA\u5DF1\u7684\u5BB6\u61C9\u8A72\u662F\u68EE\u6797\uFF0C\u4E0D\u61C9\u8A72\u662F\u5BE6\u9A57\u5BA4\uFF0C\u56E0\u6B64\u8E0F\u4E0A\u56DE\u5BB6\u7684\u65C5\u7A0B\u3002\r\n\u9019\u6BB5\u5287\u60C5\u6211\u5011\u5229\u7528\u62FE\u7372\u7684\u7269\u4EF6\uFF0C\u4F86\u63ED\u9732\u4E3B\u89D2\u4F7F\u7528\u7684\u7269\u4EF6\u8DDF\u73A9\u5BB6\u4E00\u822C\u8A8D\u77E5\u4E0D\u540C\u3002\u4F8B\u5982\u73A9\u5BB6\u8A8D\u77E5\u4E2D\u53EF\u4EE5\u559D\u7684\u6C34\uFF0C\u5C0D\u65BC\u4E3B\u89D2\u4F86\u8AAA\u662F\u4E0D\u80FD\u559D\u7684\uFF1B\u800C\u4FEE\u7406\u6A5F\u68B0\u7684\u6A5F\u6CB9\uFF0C\u7576\u73A9\u5BB6\u4F01\u5716\u53BB\u4F7F\u7528\u7684\u6642\u5019\u537B\u662F\u53EF\u4EE5\u7528\u7684\uFF0C\u4E26\u4E14\u4F7F\u7528\u5F8C\u4E3B\u89D2\u95DC\u65BC\u300C\u751F\u547D\u9700\u6C42\u300D\u7684\u6578\u503C\u6703\u63D0\u5347\u3002\r\n\u5287\u60C5\u4E2D\u6240\u6709\u8CC7\u8A0A\u6703\u56E0\u4E3B\u89D2\u7684\u884C\u70BA\u5F71\u97FF\uFF0C\u5C0D\u8A71\u4E2D\u53EF\u4EE5\u7372\u5F97\u7684\u8CC7\u8A0A\u6703\u96A8\u8457\u4E3B\u89D2\u7684\u8A8D\u77E5\u6EFE\u52D5\u66F4\u65B0\u3002\r\n
      \r\n\u968E\u6BB501\t\u756B\u9762\t\u7728\u773C\u7684\u52D5\u756B\u7D50\u675F\u5F8C\uFF0C\u9032\u5165\u5C0D\u8A71\u3002\t\u904A\u6232\u958B\u59CB\u5F8C\u6703\u76F4\u63A5\u9032\u5165\u7728\u773C\u52D5\u756B\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u2026\u2026\r\n\u65C1\u767D\uFF1A\uFF08\u4F60\u5DE6\u53F3\u89C0\u5BDF\uFF09\r\n\u4E3B\u89D2\uFF1A\u9019\u662F\u54EA\u88E1\u2026?\r\n\u4E3B\u89D2\uFF1A\u6211\u53C8\u662F\u8AB0?\r\n\u4E3B\u89D2\uFF1A\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u7D93\u904E\u4E00\u756A\u56DE\u60F3\u4E4B\u5F8C\uFF0C\u4F60\u60F3\u8D77\u4F86\u4E86\u4F60\u662F\u96BB\u9CE5\uFF0C\u4F46\u9019\u88E1\u53C8\u662F\u54EA\u88E1\uFF1F)\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u4F60\u600E\u9EBC\u6703\u5728\u9019\u88E1?\u3000[1]\r\n\u65C1\u767D\uFF1A\uFF08\u6709\u4EBA\u8D70\u4E86\u904E\u4F86\uFF09\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u6211\u770B\u4F60\u7684\u6A23\u5B50\uFF0C\u4F60\u4E0D\u8A72\u51FA\u73FE\u5728\u9019\u88E1\u624D\u5C0D\u3002\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u4F60\u8D95\u7DCA\u96E2\u958B\u9019\u88E1\u5427\uFF01\t[1]
      \u7576\u524D\u73A9\u5BB6\u5C1A\u4E0D\u77E5\u9053\u642D\u8A71\u8005\u662F\u8AB0\u3002\r\n\u968E\u6BB502\t\u756B\u9762\t\u51FA\u73FE\u5169\u500B\u9078\u9805\u300C\u8A62\u554F\u300D\u3001\u300C\u7121\u8996\u300D\uFF0C\u9078\u64C7\u8A62\u554F\u6703\u89F8\u767C\u4E0B\u5217\u5C0D\u8A71\uFF0C\u9078\u64C7\u7121\u8996\u6703\u8DF3\u904E\u5269\u9918\u5C0D\u8A71\u76F4\u63A5\u9032\u5165\u5BE6\u9A57\u5BA4\u7684\u63A2\u7D22\u74B0\u7BC0\u3002\t[1]\u9078\u64C7\u8A62\u554F\u4E0D\u61C9\u8A72\u51FA\u73FE\u7684\u7406\u7531\uFF0C\u89F8\u767C\u5BE6\u9A57\u5BA4\u4EBA\u54E1\u89E3\u91CB\u7684\u5287\u60C5\uFF1B\u82E5\u9078\u7121\u8996\u9078\u9805\u5247\u4E0D\u6703\u89F8\u767C\u4E0B\u5217\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t[1]
      \r\n\u4E3B\u89D2\uFF1A\u70BA\u4EC0\u9EBC\uFF1F\u9019\u88E1\u662F\u54EA\uFF1F\r\n\uFF1F\uFF1F\uFF1F\uFF1A\uFF1F\uFF01\u4F60\u9084\u6703\u8AAA\u8A71\uFF1F\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u7B97\u4E86\uFF0C\u9019\u4E16\u4EE3\u6703\u51FA\u73FE\u4EC0\u9EBC\u90FD\u4E0D\u7A00\u5947\u4E86\u3002\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u4F60\u8D95\u5FEB\u8D70\u5C31\u5C0D\u4E86\uFF0C\u4E0D\u8981\u554F\u90A3\u9EBC\u591A\uFF0C\u4E0D\u95DC\u4F60\u7684\u4E8B\u60C5\u3002\r\n\u4E3B\u89D2\uFF1A\u70BA\u4EC0\u9EBC\u6211\u6703\u5728\u9019\u88E1\uFF1F\u662F\u4F60\u5011\u628A\u6211\u6293\u5230\u9019\u88E1\u7684\u55CE\uFF1F\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u6211\u600E\u9EBC\u6703\u77E5\u9053\u4F60\u4E00\u96BB\u9CE5\u70BA\u4EC0\u9EBC\u6703\u51FA\u73FE\u5728\u9019\u88E1\uFF1F\uFF01\u6211\u53EA\u662F\u4E00\u500B\u505A\u6253\u96DC\u7684\u5C0F\u54E1\u5DE5\u3002\r\n\u54E1\u5DE5\uFF1A\u800C\u4E14\u4F60\u597D\u597D\u7684\u68EE\u6797\u4E0D\u5F85\u8457\u8DD1\u4F86\u5BE6\u9A57\u5BA4\u88E1\u9762\uFF0C\u5C0D\u4F60\u6709\u4EC0\u9EBC\u597D\u8655\u55CE\uFF1F\uFF01\r\n\u65C1\u767D\uFF1A(\u6C92\u932F\uFF0C\u4F60\u60F3\u8D77\u4F86\u4E86\uFF0C\u4F60\u662F\u96BB\u70CF\u9D09---\u9019\u4E5F\u5F88\u660E\u986F\uFF0C\u9CE5\u7684\u5916\u89C0\uFF0C\u9ED1\u6F06\u6F06\u7684\u7FBD\u6BDB\uFF0C\u9664\u4E86\u662F\u70CF\u9D09\u4F60\u9084\u80FD\u662F\u4EC0\u9EBC\uFF1F)\r\n\u65C1\u767D\uFF1A(\u800C\u4E14\u4ED6\u8AAA\u7684\u4E5F\u6C92\u6709\u932F\uFF0C\u4E00\u96BB\u70CF\u9D09\u5C31\u61C9\u8A72\u5728\u6A39\u6797\u4E2D\u7684\u5929\u7A7A\u4E2D\u81EA\u7531\u7684\u98DB\uFF0C\u800C\u4E0D\u662F\u88AB\u56F0\u5728\u9019\u500B\u53EB\u505A\u5BE6\u9A57\u5BA4\u7684\u5730\u65B9\u3002)\r\n\u54E1\u5DE5\uFF1A\u4F60\u5FEB\u9EDE\u96E2\u958B\u5427\uFF0C\u9580\u53E3\u5C31\u5728\u90A3\u908A\u3002\r\n\u4E3B\u89D2\uFF1A\u597D\uFF0C\u6211\u77E5\u9053\u4E86\uFF0C\u8B1D\u8B1D\u4F60\u3002\r\n\u54E1\u5DE5\uFF1A\u53BB\u53BB\u53BB\uFF0C\u4E0D\u8981\u628A\u5730\u677F\u5F04\u9AD2\u4E86\uFF01\uFF01\t\r\n\u968E\u6BB503\r\nVM1\t\u756B\u9762\t\u9032\u5165\u90FD\u5E02\u5F8C\uFF0C\u5F85\u7576\u524D\u5834\u666F\u6587\u5B57\u63D0\u793A\u7D50\u675F\u5F8C\u9032\u5165\u5C0D\u8A71\u3002\t\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u2026\u2026\r\n\u4E3B\u89D2\uFF1A\u2026\u2026\u9019\u53C8\u662F\u54EA\u88E1\uFF1F\t\r\n\u968E\u6BB504\r\nVM2\t\u756B\u9762\t[1]
      \u8CA9\u8CE3\u6A5F\u653E\u5927\u5716\u793A\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u653E\u5927\u5716\u793A\u7684\u4E0A\u5C64\u3002\t[1]\u82E5\u73A9\u5BB6\u884C\u8D70\u904E\u7A0B\u4E2D\u767C\u73FE\u8CA9\u8CE3\u6A5F\uFF0C\u9078\u64C7\u8207\u8CA9\u8CE3\u6A5F\u4E92\u52D5\u4FBF\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u9019\u662F\u4E00\u53F0\u820A\u6587\u660E\u6642\u4EE3\u907A\u7559\u7684\u98F2\u6599\u6A5F\uFF0C\u53EF\u4EE5\u62FF\u5230\u60F3\u8981\u7684\u98F2\u54C1\u3002\uFF09\r\n\u4E3B\u89D2\uFF1A\u6B63\u597D\u6211\u6709\u9EDE\u6E34\u4E86\uFF0C\u4F86\u62FF\u4E00\u9EDE\u6C34\u5427\uFF01\t\r\n\u968E\u6BB504\r\nVM3\t\u756B\u9762\t[1]
      \u8CA9\u8CE3\u6A5F\u653E\u5927\u5716\u793A\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u653E\u5927\u5716\u793A\u7684\u4E0A\u5C64\u3002\t[1]\u82E5\u73A9\u5BB6\u884C\u8D70\u904E\u7A0B\u4E2D\u767C\u73FE\u8CA9\u8CE3\u6A5F\uFF0C\u9078\u64C7\u8207\u8CA9\u8CE3\u6A5F\u4E92\u52D5\u4FBF\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u73A9\u5BB6\u8207\u8CA9\u8CE3\u6A5F\u4E92\u52D5\uFF0C\u53EF\u4EE5\u7372\u5F97\u9053\u5177\uFF1A\u4E00\u74F6\u6C34\u3002\r\n\u6C34\u7684\u63CF\u8FF0\uFF1A\u770B\u8D77\u4F86\u6709\u9EDE\u9ED1\u9ED1\u7684\uFF0C\u4E0D\u77E5\u9053\u662F\u4E0D\u662F\u4E0D\u592A\u4E7E\u6DE8\u3002\r\n[4]\u6771\u897F\u6389\u4E0B\u4F86\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u6389\u51FA\u4E86\u4E00\u74F6\u201D\u6C34\u201D\uFF09
      [2][4]\r\n\u65C1\u767D\uFF1A\u4F60\u6709\u9EDE\u6E34\u4E86\uFF0C\u8ACB\u7528\u6389\u9019\u74F6\u6C34\u3002\uFF08\u9019\u74F6\u6C34\u53EF\u4EE5\u5728\u80CC\u5305\u88E1\u627E\u5230\u3002\uFF09\t\r\n\u968E\u6BB504\r\nVM4\t\u756B\u9762\t[1]
      \u8CA9\u8CE3\u6A5F\u653E\u5927\u5716\u793A\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u653E\u5927\u5716\u793A\u7684\u4E0A\u5C64\u3002\t[1]\u82E5\u73A9\u5BB6\u884C\u8D70\u904E\u7A0B\u4E2D\u767C\u73FE\u8CA9\u8CE3\u6A5F\uFF0C\u9078\u64C7\u8207\u8CA9\u8CE3\u6A5F\u4E92\u52D5\u4FBF\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n[3]\u73A9\u5BB6\u4F7F\u7528\u6389\u6C34\u6703\u89F8\u767C\u5287\u60C5\uFF0C\u4E3B\u89D2\u751F\u547D\u9700\u6C42\u6578\u503C\u56DE\u5FA9\u81F3\u6EFF\u3002\r\n[5]\u5982\u679C\u627E\u7684\u5230\u4E86\u8A71\uFF0C\u6703\u662F\u541E\u56A5\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\uFF08\u5927\u53E3\u559D\uFF09
      [3][5]\r\n\r\n\u4E3B\u89D2\uFF1A\u611F\u89BA\u597D\u591A\u4E86\uFF0C\u6574\u500B\u8EAB\u9AD4\u90FD\u6709\u52D5\u529B\u4E86\u3002\t\r\n\u968E\u6BB505\r\n\u5C0F\u5B691\t\u756B\u9762\t[1]\u5C0F\u5B69\u7684\u653E\u5927\u5716\u793A\u8DF3\u51FA\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u756B\u9762\u4E0B\u65B9\uFF0C\u8986\u84CB\u5728\u5C0F\u5B69\u4E0A\u5C64\u3002\t[1]\u73A9\u5BB6\u9078\u64C7\u8207\u5C0F\u5B69\u4E92\u52D5\u5F8C\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u5C0F\u5B69\uFF1A\u54C7\uFF01\r\n\u5C0F\u5B69\uFF1A\u4F60\u662F\u4EC0\u9EBC\u6771\u897F\uFF1F\r\n\u4E3B\u89D2\uFF1A\uFF08\u662F\u5728\u8AAA\u6211\u55CE\uFF1F\uFF09\r\n\u4E3B\u89D2\uFF1A\u311C\u2026\u4F60\u597D\u2026.\u807D\u8AAA\u6211\u662F\u4E00\u96BB\u9CE5\u3002\r\n\u5C0F\u5B69\uFF1A\u597D\u9177\uFF01\u6211\u8981\u628A\u4F60\u5E36\u56DE\u5BB6\uFF01\r\n\u4E3B\u89D2\uFF1A
      \u554A\uFF1F\r\n\u4E3B\u89D2\uFF1A \u6211\u77E5\u9053\u4F60\u5F88\u6FC0\u52D5\uFF0C\u4F46\u4F60\u5148\u5225\u6FC0\u52D5\u3002\r\n\u4E3B\u89D2\uFF1A
      \u6211\u73FE\u5728\u6B63\u5728\u627E\u68EE\u6797\u7684\u8DEF\uFF0C\u4F60\u77E5\u9053\u600E\u9EBC\u8D70\u55CE\uFF1F\r\n\u5C0F\u5B69\uFF1A\u68EE\u6797\uFF1F\u6211\u6709\u807D\u8AAA\u904E\u9019\u500B\u5730\u65B9\uFF01\t\r\n\u968E\u6BB506\r\n\u5C0F\u5B692\t\u756B\u9762\t\u7070\u8272\u534A\u900F\u660E\u906E\u7F69\u8986\u84CB\u6240\u6709\u756B\u9762\uFF0C\u660E\u4FE1\u7247\u51FA\u73FE\u4E26\u4E14\u4E0A\u9762\u756B\u8457\u68EE\u6797\u7684\u5716\u7247\u3002\t[1]\u9EDE\u9078\u7A7A\u767D\u8655\u95DC\u9589\u5F8C\u7E7C\u7E8C\u5287\u60C5\u3002
      \r\n\t\u5C0D\u8A71\t[1]\r\n\u5C0F\u5B69\uFF1A\u9019\u662F\u6211\u5728xxx\u627E\u5230\u7684\u6771\u897F\uFF0C\u807D\u8AAA\u4E0A\u9762\u9019\u500B\u5730\u65B9\u5C31\u662F\u68EE\u6797\u3002\r\n\u4E3B\u89D2\uFF1A\uFF08\u9019\u908A\u61C9\u8A72\u5C31\u662F\u6211\u4E4B\u524D\u4F4F\u7684\u5730\u65B9\u4E86\u2026\u4F46\u6211\u8981\u600E\u9EBC\u53BB\u9019\u908A\u5462\uFF1F\uFF09\r\n\u4E3B\u89D2\uFF1A\u9019\u5F35\u660E\u4FE1\u7247\u53EF\u4EE5\u7D66\u6211\u55CE\uFF1F\u6211\u5F88\u9700\u8981\u5B83\u3002\r\n\u5C0F\u5B69\uFF1A\u53EF\u4EE5\uFF0C\u4F46\u4F60\u8981\u8B93\u6211\u6478\u4E00\u4E0B\uFF01\t\r\n\u968E\u6BB507\r\n\u5C0F\u5B693\t\u756B\u9762\t\u756B\u9762\u88AB\u9ED1\u8272\u4E0D\u660E\u7269\u9AD4\u906E\u4F4F\u5DE6\u4E0A\u65B9\u89D2\u843D\uFF0C\u906E\u4E86\u53C8\u79FB\u958B\u5169\u6B21\u5F8C\u7E7C\u7E8C\u5287\u60C5\u3002\t[1]\u53EA\u80FD\u9078\u64C7\u300C\u597D\u300D\uFF0C\u6478\u5B8C\u5F8C\u89F8\u767C\u5287\u60C5\uFF0C\u4E26\u4E14\u6703\u7372\u5F97\u4E00\u5F35\u660E\u4FE1\u7247\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u5C0F\u5B69\uFF1A\u8036\uFF01\u6211\u8981\u56DE\u53BB\u8DDF\u7238\u7238\u70AB\u8000\u6211\u9047\u5230\u4E00\u96BB\u9CE5\uFF01\t\r\n\u968E\u6BB508\t\u756B\u9762\t\u4E3B\u89D2\u7E7C\u7E8C\u5F80\u524D\u8D70\u3002[1]\t[1]\u73A9\u5BB6\u9047\u5230\u6A5F\u5668\u4EBA\uFF0C\u9078\u64C7\u8207\u6A5F\u5668\u4EBA\u4E92\u52D5\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u6771\u897F\u7838\u843D\u6216\u6389\u843D\u6216\u649E\u64CA\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u9762\u524D\u7684\u6A5F\u5668\u4EBA\u624B\u4E0A\u62FF\u8457\u5F88\u591A\u6771\u897F\u3002\uFF09\r\n\u9CE5\uFF1A\u90A3\u500B\u2026\u8ACB\u554F\u2026\uFF1F\r\n\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u7B49\u4E00\u4E0B\u2026\u54C7\u554A\u554A\u554A\uFF01\r\n\u65C1\u767D\uFF1A\uFF08\u91AB\u751F\u624B\u4E0A\u7684\u6771\u897F\u5168\u90E8\u7838\u5230\u4E86\u4F60\u8EAB\u4E0A\u3002\uFF09[2]\t\r\n\u968E\u6BB509\t\u756B\u9762\t\u77ED\u66AB\u5E7E\u6B21\u756B\u9762\u9ED1\u6697\uFF0C\u4EE5\u8868\u793A\u88AB\u7269\u54C1\u7838\u5230\u906E\u4F4F\u8996\u7DDA\u3002\t\r\n\t\u5C0D\u8A71\t\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u554A\u554A\u554A\u6211\u5F88\u62B1\u6B49\uFF0C\u4F60\u9084\u597D\u55CE\uFF1F\r\n\u65C1\u767D\uFF1A\uFF08\u4F60\u7684\u610F\u8B58\u6A21\u7CCA\u4E86\u3002\uFF09\t\r\n\u968E\u6BB510\t\u756B\u9762\t\u7728\u773C\u4E26\u4E14\u756B\u9762\u9010\u6F38\u6A21\u7CCA\uFF0C\u4E26\u4E14\u5728\u775C\u958B\u773C\u775B\u5F8C\u756B\u9762\u4F9D\u820A\u6A21\u7CCA\u3002\t[1]\u756B\u9762\u6DE1\u51FA\u8B8A\u9ED1\u3002\r\n\t\u5C0D\u8A71\t\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u6B38\u6B38\u6B38\uFF01\u5582\uFF01\r\n\u65C1\u767D\uFF1A\uFF08\u56E0\u70BA\u53D7\u5230\u649E\u64CA\uFF0C\u4F60\u660F\u4E86\u904E\u53BB\u3002\uFF09[1]\t\r\n\u968E\u6BB511\t\u756B\u9762\t\u756B\u9762\u7728\u4E86\u5169\u6B21\u773C\uFF0C\u6DE1\u5165\u5F8C\u89F8\u767C\u5287\u60C5\u3002\t[1]\u91D1\u5C6C\u6572\u64CA\u8072\u3001\u96FB\u947D\u8072\u7B49\uFF0C\u6703\u51FA\u73FE\u5728\u6A5F\u68B0\u5BE6\u9A57\u5BA4\u7684\u97F3\u6548\uFF0C\u662F\u4E00\u7A2E\u63D0\u793A\uFF0C\u63D0\u793A\u73A9\u5BB6\u4E3B\u89D2\u4F3C\u4E4E\u4E0D\u662F\u4E00\u822C\u7684\u9CE5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u4E0D\u77E5\u9053\u904E\u4E86\u591A\u4E45\uFF0C\u4F60\u5728\u4E00\u9663\u91D1\u5C6C\u6572\u64CA\u8072\u4E2D\u9192\u904E\u4F86\u3002\uFF09[1]\r\n\u4E3B\u89D2\uFF1A\u5443\u2026\u73FE\u5728\u662F\u4EC0\u9EBC\u60C5\u6CC1\uFF1F\r\n\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u62B1\u6B49\u554A\uFF01\u6211\u7E3D\u662F\u9019\u6A23\u7B28\u624B\u7B28\u8173\u7684\u2026\u2026\u4F60\u73FE\u5728\u597D\u9EDE\u4E86\u55CE\uFF1F\t\r\n\u968E\u6BB512\t\u756B\u9762\t\u6A5F\u5668\u4EBA(\u91AB\u751F)\u7684\u653E\u5927\u5716\u793A\u51FA\u73FE\u5728\u756B\u9762\u4E2D\u592E\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u5176\u4E0A\u9762\u3002\t[1]\u63D0\u793A\u73A9\u5BB6\uFF0C\u9019\u88E1\u9700\u8981\u4F7F\u7528\u660E\u4FE1\u7247\uFF0C\u5982\u679C\u4E0D\u4F7F\u7528\u5C31\u7121\u6CD5\u89F8\u767C\u63A5\u4E0B\u4F86\u7684\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u6211\u60F3\u61C9\u8A72\u662F\u597D\u591A\u4E86\u2026\u2026\u662F\u4F60\u628A\u6211\u6CBB\u597D\u7684\u55CE\uFF1F\r\n\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u7B97\u662F\u5427\uFF01\u5927\u5BB6\u90FD\u53EB\u6211\u91AB\u751F\uFF0C\u9019\u9644\u8FD1\u7684\u5C45\u6C11\u90FD\u8A8D\u8B58\u6211\u3002\u4F60\u7684\u60C5\u6CC1\u4E0D\u56B4\u91CD\uFF0C\u6211\u5F88\u5FEB\u5C31\u5E6B\u4F60\u8655\u7406\u597D\u4E86\u3002\r\n\u91AB\u751F\uFF1A\u7136\u5F8C\u5462\uFF1F\u4F60\u539F\u672C\u627E\u6211\u662F\u6709\u4EC0\u9EBC\u4E8B\u60C5\u55CE\uFF1F\u6709\u4EC0\u9EBC\u6771\u897F\u8981\u7DAD\u4FEE\u55CE\uFF1F\r\n\u4E3B\u89D2\uFF1A\u7DAD\u4FEE\uFF1F\r\n\u4E3B\u89D2\uFF1A\uFF08\u600E\u9EBC\u4E0D\u662F\u300C\u91AB\u6CBB\u300D\uFF1F\u2026\u2026\u7B97\u4E86\uFF0C\u53EF\u80FD\u53EA\u662F\u53E3\u8AA4\u5427\uFF01\uFF09\r\n\u4E3B\u89D2\uFF1A\u6211\u662F\u60F3\u8981\u554F\u4F60\u8DEF\u7684\u3002\r\n\u4E3B\u89D2\uFF1A\u5982\u4F60\u6240\u898B\uFF0C\u6211\u662F\u4E00\u96BB\u9CE5\uFF0C\u4F46\u6211\u8FF7\u8DEF\u4E86\u3002\u6211\u60F3\u8981\u56DE\u68EE\u6797\uFF0C\u4F46\u6211\u4E0D\u8A18\u5F97\u68EE\u6797\u600E\u9EBC\u8D70\u3002\r\n\u4E3B\u89D2\uFF1A\u6211\u9019\u88E1\u6709\u4E00\u5F35\u660E\u4FE1\u7247\uFF0C\u53EF\u4EE5\u5E6B\u6211\u770B\u4E00\u4E0B\u9019\u662F\u54EA\u88E1\u7684\u68EE\u6797\u55CE\uFF1F[1]\t\r\n\u968E\u6BB513\t\u756B\u9762\t[1]\u660E\u4FE1\u7247\u51FA\u73FE\uFF0C\u4E26\u4E14\u6703\u8986\u84CB\u5230\u5C0D\u8A71\u6846\u4E0A\uFF0C\u80CC\u666F\u6703\u7531\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u84CB\u4F4F\u3002[2]\t[1]\u4F7F\u7528\u660E\u4FE1\u7247\u624D\u80FD\u5920\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u9EDE\u9078\u7A7A\u767D\u8655\u6703\u95DC\u6389\u660E\u4FE1\u7247\uFF0C\u4F46\u660E\u4FE1\u7247\u6703\u88AB\u4F7F\u7528\u6389\u3002\r\n[3]\u6536\u5230\u9053\u5177\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u91AB\u751F\u63A5\u904E\u4F60\u7684\u660E\u4FE1\u7247\u3002\uFF09\r\n\u91AB\u751F\uFF1A\u55EF\uFF1F\u4F60\u8AAA\u9019\u662F\u4F60\u5BB6\u55CE\uFF1F\r\n\u65C1\u767D\uFF1A\uFF08\u91AB\u751F\u4F4E\u8457\u982D\uFF0C\u82E5\u6709\u6240\u601D\u3002\uFF09\r\n\u91AB\u751F\uFF1A\u55EF\u2026\u6211\u77E5\u9053\u4E86\uFF0C\u6211\u4E0D\u592A\u77E5\u9053\u68EE\u6797\u7684\u8DEF\u8981\u600E\u9EBC\u8D70\u3002\r\n\u91AB\u751F\uFF1A\u4F46\u4F60\u5F80\u524D\u4E00\u76F4\u8D70\u7684\u8A71\uFF0C\u61C9\u8A72\u6703\u9047\u5230\u4E00\u53F0\u5730\u5716\u6A5F\u5668\u4EBA\u3002\u4ED6\u77E5\u9053\u6240\u6709\u7684\u8DEF\u8A72\u600E\u9EBC\u8D70\uFF0C\u4F60\u628A\u660E\u4FE1\u7247\u7D66\u4ED6\u770B\uFF0C\u6216\u8A31\u6703\u6709\u4F60\u8981\u7684\u7B54\u6848\u3002\r\n\u91AB\u751F\uFF1A\u9084\u6709\u2026\u9019\u4E9B\u6771\u897F\u4F60\u62FF\u8457\uFF01\u5927\u6982\u662F\u4F60\u6389\u7684\u5427\uFF1F[3]\t\r\n\u968E\u6BB514\t\u756B\u9762\t\u7372\u5F97\u7684\u9053\u5177\u6703\u64FA\u6210\u4E00\u5B57\u5728\u756B\u9762\u4E0A\uFF0C\u73A9\u5BB6\u9EDE\u64CA\u5C31\u53EF\u4EE5\u62FE\u53D6\u3002[1]\t[1]\u9053\u5177\u9EDE\u64CA\u53EF\u4EE5\u62FE\u53D6\uFF0C\u9053\u5177\u672C\u8EAB\u5468\u570D\u6703\u6709\u4E00\u5708\u5149\u63D0\u793A\u662F\u53EF\u4EE5\u9EDE\u7684\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u597D\u7684\uFF0C\u8B1D\u8B1D\u4F60\uFF0C\u91AB\u751F\uFF01\r\n\u9CE5\uFF1A\uFF08\u5947\u602A\uFF0C\u9019\u5169\u584A\u91D1\u5C6C\u662F\u6211\u6389\u7684\u55CE\uFF1F\uFF09\r\n\u91AB\u751F\uFF1A\u5982\u679C\u6709\u9047\u5230\u4EC0\u9EBC\u56F0\u96E3\uFF0C\u5118\u7BA1\u4F86\u627E\u6211\u5427\uFF01\t\r\n\u968E\u6BB515\t\u756B\u9762\t\u6597\u7BF7\u602A\u5496\u5728\u756B\u9762\u4E2D\u592E\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u602A\u5496\u4E0A\u5C64\u3002\t\r\n\t\u5C0D\u8A71\t\u6597\u7BF7\u602A\u5496\uFF1A\u2026\u2026\r\n\u65C1\u767D\uFF1A\uFF08\u773C\u524D\u7684\u4EBA\u62AB\u8457\u4E00\u4EF6\u6597\u7BF7\uFF0C\u4E00\u8A00\u4E0D\u767C\u7684\u770B\u8457\u4F60\u3002\uFF09\r\n\u4E3B\u89D2\uFF1A\uFF08\u9019\u500B\u4EBA\u770B\u8D77\u4F86\u6709\u9EDE\u5947\u602A...\u9084\u662F\u4E0D\u8981\u63A5\u8FD1\u4ED6\u597D\u4E86\u3002\uFF09\t\r\n\u968E\u6BB516\t\u756B\u9762\t\u6597\u7BF7\u602A\u5496\u6703\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5982\u679C\u9078\u64C7\u300C\u518D\u5077\u770B\u4ED6\u4E00\u4E0B\u300D\u624D\u6703\u89F8\u767C\u5287\u60C5\uFF1B\u5426\u5247\u76F4\u63A5\u7D50\u675F\u4E26\u4E14\u7121\u6CD5\u518D\u9032\u5165\u5287\u60C5\u3002\t[1]\u5927\u7B11\uFF0C\u4E26\u4E14\u662F\u5632\u7B11\u610F\u5473\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u6597\u7BF7\u602A\u5496\uFF1A\u4F60\u770B\u4EC0\u9EBC\u770B\uFF1F\r\n\u4E3B\u89D2\uFF1A\uFF08\u5616\uFF0C\u614B\u5EA6\u600E\u9EBC\u9019\u9EBC\u5DEE\uFF0C\u9084\u662F\u5148\u8D70\u70BA\u5999\u5427\uFF01\uFF09\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u7B49\u4E00\u4E0B\uFF0C\u65E2\u7136\u4F60\u90FD\u505C\u4E0B\u4F86\u4E86\u2026\u2026\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u90A3\u4F60\u7D66\u6211\u9EDE\u5403\u7684\u5427\uFF0C\u6211\u5DF2\u7D93\u597D\u5E7E\u5929\u6C92\u6709\u5403\u6771\u897F\u4E86\u3002\r\n\u65C1\u767D\uFF1A\uFF08\u773C\u524D\u9019\u500B\u4EBA\u7684\u8B1B\u8A71\u8A9E\u6C23\u4F3C\u4E4E\u548C\u524D\u9762\u9047\u5230\u7684\u4EBA\u4E0D\u4E00\u6A23\uFF0C\u80FD\u5F88\u8F15\u6613\u7684\u611F\u89BA\u51FA\u4ED6\u7684\u60C5\u7DD2\u3002\uFF09\r\n\u4E3B\u89D2\uFF1A\u6211\u624D\u6C92\u7A7A\u7406\u4F60\uFF0C\u6211\u8981\u8D95\u5FEB\u56DE\u53BB\u68EE\u6797\uFF01\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u5E79\u561B\u56DE\u68EE\u6797\uFF1F\r\n\u4E3B\u89D2\uFF1A\u90A3\u88E1\u662F\u6211\u5BB6\uFF0C\u6211\u7576\u7136\u8981\u56DE\u53BB\u554A\uFF01\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u56DE\u5BB6\uFF1F\r\n\u65C1\u767D\uFF1A\uFF08\u6597\u7BF7\u602A\u5496\u4E0A\u4E0B\u6253\u91CF\u4F60\u4E00\u756A\uFF0C\u7136\u5F8C\u7A81\u7136\u958B\u59CB\u5927\u7B11\u3002\uFF09[1]\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u54C8\u54C8\u54C8\u54C8\u2026\u2026\u4F60\u7ADF\u7136\u8AAA\u8981\u56DE\u5BB6\u2026\u2026\u5BE6\u5728\u662F\u592A\u6709\u8DA3\u4E86\uFF0C\u679C\u7136\u90FD\u5E02\u88E1\u4EC0\u9EBC\u90FD\u6709\uFF01\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u4E0D\u7136\u9019\u6A23\u5427\uFF01\u6211\u770B\u4F60\u62FF\u8457\u5169\u584A\u91D1\u5C6C\uFF0C\u770B\u8D77\u4F86\u633A\u503C\u9322\u7684\u3002\u53CD\u6B63\u4F60\u4E00\u96BB\u9CE5\u4E5F\u7528\u4E0D\u8457\uFF0C\u4E0D\u5982\u8B93\u6211\u62FF\u53BB\u8CE3\u4E86\u63DB\u9EDE\u9322\u3002\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u6211\u6703\u7D66\u4F60\u597D\u6771\u897F\u7684\uFF0C\u7D55\u5C0D\u4E0D\u6703\u8667\u5F85\u4F60\uFF01\r\n\u4E3B\u89D2\uFF1A\uFF08\u4ED6\u5230\u5E95\u662F\u4EC0\u9EBC\u610F\u601D\u2026\u6211\u8981\u7D66\u4ED6\u55CE\uFF1F\uFF09\t\r\n\u968E\u6BB517\t\u756B\u9762\t\u6597\u7BF7\u602A\u5496\u5728\u756B\u9762\u4E2D\u592E\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u602A\u5496\u4E0A\u5C64\u3002\t[1]\u9078\u64C7\u300C\u7D66\u300D\u89F8\u767C\u968E\u6BB517\u5287\u60C5\uFF0C\u6703\u5931\u53BB\u4E00\u500B\u91D1\u5C6C\u652F\u67B6\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\u597D\u5427\uFF01\u9019\u500B\u652F\u67B6\u7D66\u4F60\u3002\u6211\u7D66\u4F60\u4E86\uFF0C\u90A3\u4F60\u80FD\u7D66\u6211\u4EC0\u9EBC\uFF1F\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u563F\u563F\u563F\u2026\u2026\u9019\u500B\u4F60\u62FF\u8457\u5427\uFF01\u7B49\u4F60\u771F\u7684\u5230\u4E86\u68EE\u6797\u4E4B\u5F8C\u6703\u6D3E\u4E0A\u7528\u5834\u7684\u2026\u2026\t\r\n\u968E\u6BB518\t\u756B\u9762\t\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u906E\u64CB\u4F4F\u6240\u6709\u7269\u4EF6\uFF0C\u5716\u9A30\u6703\u8986\u84CB\u5728\u756B\u9762\u4E2D\u592E\u3001\u906E\u7F69\u4E4B\u4E0A\uFF0C\u9EDE\u64CA\u7A7A\u767D\u8655\u53EF\u4EE5\u95DC\u9589\u3002\t[1]\u7372\u5F97\u9053\u5177\uFF1A\u5947\u602A\u7684\u5716\u9A30\u3002\r\n\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\uFF08\u4EC0\u9EBC\u561B\u2026\u7D66\u4E86\u4E00\u500B\u4E0D\u77E5\u9053\u4EC0\u9EBC\u7684\u6771\u897F\u2026\u9084\u662F\u5FEB\u8D70\u5427\uFF01\uFF09\t\r\n\u968E\u6BB519\t\u756B\u9762\t\u5C0D\u8A71\u6846\u4F4D\u65BC\u756B\u9762\u4E0B\u65B9\u3002\t[1]\u4E0D\u6703\u767C\u751F\u4EFB\u4F55\u4E8B\u3002\r\n[2]\u51B7\u7B11\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\u6211\u624D\u4E0D\u8981\u7D66\u4F60\uFF0C\u6211\u8981\u8D70\u4E86\uFF01\r\n\u6597\u7BF7\u602A\u5496\uFF1A[2]\u90A3\u4F60\u53EF\u5225\u5F8C\u6094\u2026\u2026\t\r\n\u968E\u6BB520\t\u756B\u9762\t[1]\u6A5F\u5668\u4EBA\u653E\u5927\u5716\u793A\u4F4D\u65BC\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5C0D\u8A71\u6846\u4F4D\u65BC\u756B\u9762\u4E0B\u65B9\u4E14\u6703\u8986\u84CB\u5728\u6A5F\u5668\u4EBA\u4E0A\u5C64\u3002\t[1]\u8207\u6A5F\u5668\u4EBA\u4E92\u52D5\u624D\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u9019\u61C9\u8A72\u5C31\u662F\u91AB\u751F\u8AAA\u7684\u5730\u5716\u6A5F\u5668\u4EBA\u4E86\u2026\u2026\uFF1F\r\n\u6A5F\u5668\u4EBA\uFF1A\u55F6\u55F6\u2026\u60A8\u4ECA\u5929\u60F3\u53BB\u54EA\u88E1\uFF1F\t\r\n\u968E\u6BB521\t\u756B\u9762\t[1]\u660E\u4FE1\u7247\u653E\u5927\u5716\u793A\u4F4D\u65BC\u6B63\u4E2D\u592E\uFF0C\u6383\u63CF\u7D05\u7DDA\u6703\u6383\u904E\u660E\u4FE1\u7247\uFF0C\u63A5\u8457\u660E\u4FE1\u7247\u6D88\u5931\u4E26\u89F8\u767C\u5C0D\u8A71\u3002\t[1]\u4F7F\u7528\u660E\u4FE1\u7247\u5F8C\u89F8\u767C(\u5982\u672A\u62FF\u5230\u660E\u4FE1\u7247\u6703\u7121\u6CD5\u89F8\u767C\u5287\u60C5)\u3002\r\n[2]\u55F6\u55F6\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u6A5F\u5668\u4EBA\uFF1A\u8FA8\u8B58\u4E2D\u2026\u2026[2]\r\n\u6A5F\u5668\u4EBA\uFF1A\u60A8\u8981\u524D\u5F80\u7684\u5730\u65B9\u70BA\u68EE\u6797\uFF0C\u5C1A\u672A\u958B\u767C\uFF0C\u6709\u4E00\u5B9A\u7A0B\u5EA6\u5371\u96AA\u3002\r\n\u6A5F\u5668\u4EBA\uFF1A\u82E5\u8981\u524D\u5F80\u68EE\u6797\uFF0C\u8ACB\u7E7C\u7E8C\u5F80\u524D\u884C\uFF0C\u518D\u7A7F\u8D8A\u6C99\u6F20\u5F8C\u5373\u53EF\u62B5\u9054\u3002\r\n\u9CE5\uFF1A(\u6C99\u6F20\u53C8\u662F\u4EC0\u9EBC\u5730\u65B9\uFF1F\u6211\u53EA\u60F3\u8D95\u5FEB\u56DE\u5BB6\u3002)\r\n\u9CE5\uFF1A\u6211\u77E5\u9053\u4E86\uFF0C\u8B1D\u8B1D\u4F60\uFF01\t\r\n\u968E\u6BB522\t\u756B\u9762\t\u5834\u666F\u63D0\u793A\u6587\u5B57\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u80CC\u666F\u662F\u9ED1\u8272\u906E\u7F69\u906E\u4F4F\u6574\u500B\u756B\u9762\uFF0C\u6587\u5B57\u9583\u720D\u5F8C\u6D88\u5931\uFF0C\u7ACB\u523B\u89F8\u767C\u5287\u60C5\u3002\t\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u539F\u4F86\u9019\u908A\u5C31\u662F\u6C99\u6F20\u963F\uFF01\r\n\u65C1\u767D\uFF1A(\u4F60\u653E\u773C\u671B\u53BB\uFF0C\u53EA\u6709\u4E00\u7247\u7684\u6C99\u4E18\u3002)\r\n\u65C1\u767D\uFF1A(\u6C99\u5B50\uFF0C\u6C99\u5B50\uFF0C\u9084\u662F\u7121\u804A\u7684\u6C99\u5B50\u3002\u9019\u8DDF\u4F60\u7684\u5BB6\u5712\u7DA0\u610F\u76CE\u7136\u7684\u6A23\u5B50\u53EF\u4EE5\u8AAA\u662F\u5DEE\u591A\u4E86\u3002)\r\n\u4E3B\u89D2\uFF1A\u9019\u908A\u771F\u7684\u6703\u6709\u751F\u7269\u55CE\u2026\u2026?\t\r\n\u968E\u6BB523\t\u756B\u9762\t\u6A5F\u5668\u4EBA\u653E\u5927\u5716\u793A\u51FA\u73FE\u5728\u756B\u9762\u4E2D\u592E\u3002[1]\t[1]\u8207\u6A5F\u5668\u4EBA\u4E92\u52D5\u5F8C\u89F8\u767C\u5C0D\u8A71\u3002\r\n[2]\u756B\u9762\u6416\u6643\u9707\u52D5\u3002\r\n[3]\u9019\u908A\u5728\u63D0\u793A\u73A9\u5BB6\uFF0C\u4E3B\u89D2\u662F\u6A5F\u5668\u4EBA\u7684\u540C\u4F34\uFF0C\u4E5F\u5C31\u4EE3\u8868\u4E3B\u89D2\u4E5F\u662F\u6A5F\u5668\u4EBA\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u770B\u8457\u773C\u524D\u4E0D\u52D5\u7684\u6A5F\u5668\u4EBA\uFF0C\u9084\u5728\u601D\u8003\u70BA\u4EC0\u9EBC\u6703\u51FA\u73FE\u5728\u9019\u88E1\u3002)\r\n\u6A5F\u5668\u4EBA\uFF1A@#/?%%@!\r\n\u4E3B\u89D2\uFF1A\u55DA\u54C7\u554A\u554A\u554A\u554A\uFF01[2]\r\n\u65C1\u767D\uFF1A(\u4F60\u88AB\u7A81\u7136\u9192\u4F86\u7684\u6A5F\u5668\u4EBA\u5687\u4E86\u4E00\u5927\u8DF3\u3002)\r\n\u6A5F\u5668\u4EBA\uFF1A\u62B1\u6B49\u963F\uFF01\u6211\u525B\u525B\u7A81\u7136\u7576\u6A5F\u4E86\u4E00\u4E0B\uFF0C\u4E0D\u662F\u8981\u6545\u610F\u5687\u4F60\u7684\u3002\r\n\u4E3B\u89D2\uFF1A\u662F\u6C92\u95DC\u4FC2\uFF0C\u4F46\u70BA\u4EC0\u9EBC\u6A5F\u5668\u4EBA\u6703\u51FA\u73FE\u5728\u9019\u88E1\uFF1F\r\n\u6A5F\u5668\u4EBA\uFF1A\u5C31\u50CF\u4F60\u70BA\u4EC0\u9EBC\u6703\u51FA\u73FE\u5728\u9019\u88E1\u7684\u539F\u56E0\u4E00\u6A23\uFF0C\u6211\u7684\u670B\u53CB\u3002\r\n\u6A5F\u5668\u4EBA\uFF1A\u73FE\u5728\u79D1\u6280\u5DF2\u7D93\u975E\u5E38\u767C\u9054\u4E86\uFF0C\u5230\u54EA\u88E1\u90FD\u6709\u6211\u5011\u7684\u540C\u4F34\u3002\u771F\u662F\u7F8E\u597D\uFF01[3]\t\r\n\u968E\u6BB524\t\u756B\u9762\t\u99F1\u99DD\u653E\u5927\u5716\u793A\u986F\u793A\u5728\u756B\u9762\u6B63\u4E2D\u592E[1]\u3002\t[1]\u5982\u679C\u627E\u7684\u5230\u4E86\u8A71\uFF0C\u6703\u6709\u99F1\u99DD\u53EB\u8072\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u5F9E\u4F86\u6C92\u770B\u904E\u9019\u9EBC\u5947\u602A\u7684\u751F\u7269\u3002)\r\n\u65C1\u767D\uFF1A(\u56DB\u96BB\u8173\uFF0C\u9577\u9577\u7684\u8116\u5B50\uFF0C\u80CC\u4E0A\u9084\u6709\u51F8\u8D77\u4F86\u7684\u5C71\u4E18-\u4E0D\u7BA1\u54EA\u9EDE\u5C0D\u4F60\u4F86\u8AAA\u770B\u8D77\u4F86\u90FD\u592A\u53E4\u602A\u4E86\u3002)\r\n\u99F1\u99DD\uFF1A\u5594\uFF1F\u4F60\u9019\u662F\u4EC0\u9EBC\u52D5\u7269\uFF0C\u9577\u7684\u9084\u771F\u5947\u602A\u3002\r\n\u4E3B\u89D2\uFF1A\u6211\u624D\u89BA\u5F97\u4F60\u5947\u602A\u5462\uFF01\u4F60\u7684\u80CC\u4E0A\u600E\u9EBC\u6703\u6709\u5169\u500B\u5C0F\u5C71\u4E18\uFF1F\r\n\u99F1\u99DD\uFF1A\u539F\u4F86\u5982\u6B64\uFF0C\u6211\u61C2\u4E86\u3002\u4F60\u4E0D\u662F\u9019\u88E1\u7684\u5C45\u6C11\u3002\r\n\u99F1\u99DD\uFF1A\u6211\u662F\u96BB\u99F1\u99DD\uFF0C\u80CC\u4E0A\u7684\u7684\u5C0F\u5C71\u4E18\u662F\u6211\u5E73\u5E38\u5132\u5B58\u6C34\u7684\u5730\u65B9\u3002\u5728\u9019\u6C99\u6F20\u751F\u5B58\u53EF\u4E0D\u80FD\u6C92\u6709\u6C34\u5462\uFF01\r\n\u4E3B\u89D2\uFF1A(\u9019\u96BB\u99F1\u99DD\u610F\u5916\u7684\u5F88\u6709\u79AE\u8C8C\uFF1F)\r\n\u4E3B\u89D2\uFF1A\u6211\u77E5\u9053\u4E86\uFF0C\u8B1D\u8B1D\u4F60\u7684\u5FE0\u544A\u3002\u6211\u662F\u4E00\u96BB\u9CE5\uFF0C\u73FE\u5728\u6B63\u5728\u627E\u56DE\u5230\u68EE\u6797\u7684\u8DEF\u3002\u4F60\u77E5\u9053\u8981\u600E\u9EBC\u8D70\u55CE\uFF1F\r\n\u99F1\u99DD\uFF1A\u68EE\u6797\uFF1F\u6211\u6C92\u6709\u807D\u8AAA\u904E\uFF0C\u62B1\u6B49\u5E6B\u4E0D\u4E0A\u4F60\u7684\u5FD9\u3002\r\n\u99F1\u99DD\uFF1A\u4F46\u662F\u76F8\u9022\u5C31\u662F\u6709\u7DE3\uFF0C\u9019\u74F6\u6C34\u7D66\u4F60\u5427\uFF01\t\r\n\u968E\u6BB525\t\u756B\u9762\t\u4E00\u74F6\u6C34\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5176\u9918\u756B\u9762\u6703\u88AB\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u906E\u4F4F\u3002[1]\t[1]\u9EDE\u64CA\u6C34\u6703\u6D88\u5931\uFF0C\u4E26\u4E14\u5728\u756B\u9762\u4E0B\u65B9\u51FA\u73FE\u300C\u7372\u5F97\u9053\u5177\uFF1A\u4E00\u74F6\u6C34\u300D\u7684\u63D0\u793A\u6587\u5B57\u3002\r\n\t\u5C0D\u8A71\t\u99F1\u99DD\uFF1A\u53E6\u5916\uFF0C\u6C99\u6F20\u7684\u591C\u665A\u53EF\u662F\u975E\u5E38\u5BD2\u51B7\u7684\uFF0C\u9019\u689D\u570D\u5DFE\u4F60\u4E5F\u62FF\u8457\u5427\uFF01\u4FDD\u6696\u53EF\u662F\u975E\u5E38\u91CD\u8981\u3002\r\n\u99F1\u99DD\uFF1A\u5E0C\u671B\u4F60\u53EF\u4EE5\u627E\u5230\u56DE\u5BB6\u7684\u8DEF\uFF0C\u6211\u7684\u670B\u53CB\uFF01\t\r\n\u968E\u6BB526\t\u756B\u9762\t\u4E00\u689D\u570D\u5DFE\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5176\u9918\u756B\u9762\u6703\u88AB\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u906E\u4F4F\u3002[1][2]\t[1]
      \u9EDE\u64CA\u570D\u5DFE\u6703\u6D88\u5931\uFF0C\u4E26\u4E14\u5728\u756B\u9762\u4E0B\u65B9\u51FA\u73FE\u300C\u7372\u5F97\u9053\u5177\uFF1A\u4E00\u689D\u570D\u5DFE\u300D\u7684\u63D0\u793A\u6587\u5B57\u3002\r\n[2]\u5F37\u5236\u4F7F\u7528\u570D\u5DFE\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A(\u5BD2\u51B7\uFF1F\u6211\u600E\u9EBC\u6C92\u6709\u611F\u89BA\uFF1F\u800C\u4E14\u9019\u570D\u5DFE\u597D\u5F71\u97FF\u98DB\u884C\u3002)\r\n\u4E3B\u89D2\uFF1A(\u5927\u6982\u662F\u56E0\u70BA\u6211\u7FBD\u6BDB\u6BD4\u8F03\u591A\u624D\u4E0D\u6703\u51B7\u3002\u96D6\u7136\u5F88\u5C0D\u4E0D\u8D77\u99F1\u99DD\uFF0C\u4F46\u9084\u662F\u628A\u570D\u5DFE\u62FF\u4E0B\u4F86\u5427\uFF01)\t\r\n\u968E\u6BB527\t\u756B\u9762\t\u4E00\u96BB\u86C7\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\u3002[1]\t[1]\u86C7\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u770B\u5230\u4E86\u4E00\u689D\u86C7\u3002)\r\n\u65C1\u767D\uFF1A(\u96D6\u7136\u90FD\u8AAA\u4E0D\u80FD\u4EE5\u8C8C\u53D6\u4EBA\uFF0C\u4F46\u7260\u770B\u8D77\u4F86\u5BE6\u5728\u662F\u592A\u72E1\u733E\u4E86)\r\n\u65C1\u767D\uFF1A(\u5C24\u5176\u662F\u5728\u4F60\u7684\u8A18\u61B6\u4E2D\uFF0C\u4F60\u9084\u807D\u8AAA\u904E\u6709\u4E9B\u86C7\u6703\u6355\u98DF\u9CE5\u985E\u2500\u2500\u5C0D\u65BC\u4E00\u96BB\u60F3\u56DE\u5BB6\u7684\u9CE5\u4F86\u8AAA\uFF0C\u9019\u53EF\u4E0D\u662F\u4F60\u60F3\u767C\u751F\u7684\u4E8B\u60C5\u3002)\t\r\n\u968E\u6BB528\t\u756B\u9762\t\u9078\u64C7\u5F8C\u89F8\u767C\u5C0D\u8A71\u3002[1]\t[1]\u9078\u64C7\u8207\u86C7\u5C0D\u8A71\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u51FA\u73FE\u9078\u9805\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u4F60\u2026\u4F60\u597D\uFF1F\r\n\u86C7\uFF1A\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u9019\u96BB\u86C7\u5C31\u53EA\u662F\u4E00\u76F4\u770B\u8457\u4F60\uFF0C\u4E00\u53E5\u8A71\u4E5F\u6C92\u6709\u8AAA\u3002)\r\n\u4E3B\u89D2\uFF1A(\u55DA\u54C7\u2026\u4ED6\u771F\u7684\u6709\u5920\u602A\u7684\uFF0C\u65E9\u77E5\u9053\u5C31\u4E0D\u7406\u4ED6\u4E86\u3002)\r\n\u86C7\uFF1A\u4F60\u6709\u6C34\u55CE\uFF1F\r\n\u4E3B\u89D2\uFF1A\u4EC0\u9EBC\uFF1F\r\n\u86C7\uFF1A\u4F60\u807D\u5230\u4E86\uFF0C\u6211\u9700\u8981\u4E00\u9EDE\u6C34\u3002\u4F5C\u70BA\u4EA4\u63DB\uFF0C\u6211\u6703\u7D66\u4F60\u4E00\u4E9B\u597D\u6771\u897F\u7684\u3002\r\n\u4E3B\u89D2\uFF1A\u600E\u9EBC\u8FA6\u2026\u8981\u7D66\u4ED6\u55CE\uFF1F[2]\t\r\n\u968E\u6BB529\t\u756B\u9762\t\u86C7\u51FA\u73FE\u5728\u6B63\u4E2D\u592E\u3002\t[1]\u9078\u64C7\u4E0D\u7D66\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\u6211\u6C92\u6709\u6C34\uFF0C\u62B1\u6B49\u3002\r\n\u65C1\u767D\uFF1A(\u4F60\u5FEB\u901F\u5730\u9060\u96E2\u86C7\u4E86\uFF0C\u4F46\u9019\u6A23\u771F\u7684\u597D\u55CE\uFF1F)\t\r\n\u968E\u6BB530\t\u756B\u9762\t\u9078\u64C7\u8207\u86C7\u4E92\u52D5\uFF0C\u518D\u4F7F\u7528\u6C34\u6703\u89F8\u767C\u5287\u60C5\u3002\t[1]\u9078\u64C7\u7D66\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\u597D\u5427\uFF0C\u4F46\u4F60\u53EA\u80FD\u559D\u4E00\u9EDE\u9EDE\u5594\uFF01\r\n\u86C7\uFF1A\u597D\u5566\u597D\u5566\uFF0C\u5FEB\u7D66\u6211\u5427\uFF0C\u6211\u5FEB\u6E34\u6B7B\u4E86\u3002\t\r\n\u968E\u6BB531\t\u756B\u9762\t\u9078\u64C7\u8207\u86C7\u4E92\u52D5\uFF0C\u518D\u4F7F\u7528\u6C34\u6703\u89F8\u767C\u5287\u60C5\u3002\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u628A\u6C34\u7D66\u4E86\u86C7\u3002)\r\n\u86C7\uFF1A\u592A\u597D\u4E86\uFF0C\u5728\u9019\u908A\u597D\u4E45\u90FD\u6C92\u559D\u5230\u6C34\u4E86\uFF01\u8B93\u6211\u4F86\u2026.\u54B3\u54B3\u2026\u6B38\uFF01\r\n\u65C1\u767D\uFF1A(\u86C7\u628A\u6C34\u5410\u4E86\u4E00\u5730\uFF0C\u74F6\u5B50\u88E1\u9762\u4E5F\u4E00\u6EF4\u4E0D\u5269\u4E86\u3002)\r\n\u86C7\uFF1A\u4F60\u9019\u54EA\u662F\u4EC0\u9EBC\u6C34\u554A\uFF01\u4F60\u5206\u660E\u662F\u60F3\u5BB3\u6B7B\u8001\u5B50\uFF01\r\n\u65C1\u767D\uFF1A(\u86C7\u8AAA\u5B8C\u5C31\u4E00\u6E9C\u7159\u8DD1\u8D70\u4E86\uFF0C\u8AAA\u597D\u8981\u7D66\u4F60\u7684\u597D\u6771\u897F\u4E5F\u6C92\u6709\u7D66\u4F60\u3002\u539F\u4F86\u4ED6\u771F\u7684\u5F88\u72E1\u733E\u3002)\r\n\u4E3B\u89D2\uFF1A\u4EC0\u9EBC\u561B\u2026\u65E9\u77E5\u9053\u4E0D\u8981\u7576\u597D\u4EBA\u4E86\u2026\t\r\n\u968E\u6BB532\t\u756B\u9762\t\u9078\u64C7\u8207\u99F1\u99DD\u4E92\u52D5\uFF0C\u6703\u89F8\u767C\u5287\u60C5\u3002\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4E0D\u77E5\u9053\u70BA\u4EC0\u9EBC\uFF0C\u4F60\u77E5\u9053\u9019\u662F\u4E00\u96BB\u9D15\u9CE5\u2500\u2500\u5373\u4F7F\u4ED6\u9577\u5F97\u8DDF\u4F60\u4E00\u9EDE\u95DC\u4FC2\u90FD\u6C92\u6709\uFF0C\u9019\u6A23\u4ED6\u9084\u80FD\u53EB\u505A\u4E00\u96BB\u9CE5\u55CE\uFF1F)\r\n\u65C1\u767D\uFF1A(\u4F46\u4F60\u7BA1\u4E0D\u4E86\u90A3\u9EBC\u591A\u4E86\uFF0C\u6B64\u6642\u6B64\u523B\u4F60\u53EA\u60F3\u5FEB\u9EDE\u96E2\u958B\u9019\u500B\u9B3C\u5730\u65B9\u3002)\r\n\u9D15\u9CE5\uFF1A\u6B38\u2026\u4F60\u662F\uFF1F\r\n\u65C1\u767D\uFF1A(\u4F60\u4E0D\u60F3\u7406\u4ED6\uFF0C\u4F46\u4E00\u5207\u90FD\u4F86\u4E0D\u53CA\u4E86\u3002\u9019\u96BB\u300C\u9CE5\u300D\u5BE6\u5728\u662F\u592A\u71B1\u60C5\u4E86\uFF0C\u4F60\u53EA\u80FD\u5E0C\u671B\u4ED6\u4E0D\u6703\u518D\u9A19\u8D70\u4F60\u4EC0\u9EBC\u6771\u897F\u3002)\r\n\u4E3B\u89D2\uFF1A\u5148\u8AAA\u597D\uFF0C\u6211\u53EF\u4E0D\u6703\u7D66\u4F60\u4EC0\u9EBC\u6771\u897F\uFF01\r\n\u9D15\u9CE5\uFF1AWo
      Wo Wo\uFF0C\u4F60\u5148\u51B7\u975C\u9EDE\u6211\u7684\u670B\u53CB\uFF0C\u6211\u4E26\u6C92\u6709\u4EC0\u9EBC\u60E1\u610F\u3002\u53EF\u4EE5\u8DDF\u6211\u8B1B\u767C\u751F\u4EC0\u9EBC\u4E8B\u60C5\u4E86\u55CE\uFF1F\u4F60\u770B\u8D77\u4F86\u5FC3\u4E8B\u91CD\u91CD\u7684\u3002\r\n\u65C1\u767D\uFF1A(\u4F60\u628A\u525B\u525B\u767C\u751F\u7684\u4E8B\u60C5\u90FD\u8DDF\u4ED6\u8AAA\u4E86\uFF0C\u5305\u542B\u4F60\u8981\u56DE\u5BB6\u7684\u4E8B\u60C5\u3002)\r\n\u9D15\u9CE5\uFF1A\u539F\u4F86\u5982\u6B64\uFF0C\u90A3\u53EF\u771F\u662F\u59D4\u5C48\u4F60\u4E86\u3002\r\n\u9D15\u9CE5\uFF1A\u4E0D\u7136\u9019\u6A23\u5427\uFF01\u6211\u65C1\u908A\u525B\u597D\u662F\u4E00\u7247\u7DA0\u6D32\uFF0C\u6211\u5E6B\u4F60\u88DD\u9EDE\u6C34\u5427\uFF01\u5E0C\u671B\u4F60\u56DE\u5BB6\u7684\u8DEF\u7A0B\u9806\u5229\uFF01\t\r\n\u968E\u6BB533\t\u756B\u9762\t\u4E00\u74F6\u6C34\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5176\u9918\u756B\u9762\u6703\u88AB\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u906E\u4F4F\u3002[1]\t[1]\u9EDE\u64CA\u6C34\u6703\u6D88\u5931\uFF0C\u4E26\u4E14\u5728\u756B\u9762\u4E0B\u65B9\u51FA\u73FE\u300C\u7372\u5F97\u9053\u5177\uFF1A\u4E00\u74F6\u6C34\u300D\u7684\u63D0\u793A\u6587\u5B57\u3002\r\n\t\u5C0D\u8A71\t\u9D15\u9CE5\uFF1A\u5C31\u9019\u6A23\u5427\uFF0C\u90A3\u6211\u5148\u8D70\u4E86\uFF01\r\n\u4E3B\u89D2\uFF1A(\u96D6\u7136\u5F88\u8B1D\u8B1D\u4ED6\uFF0C\u4E0D\u904E\u600E\u9EBC\u611F\u89BA\u4ED6\u7D66\u6211\u7684\u6C34\u559D\u8D77\u4F86\u6709\u9EDE\u4E0D\u592A\u4E00\u6A23\u2026)\t\r\n\u968E\u6BB534\t\u756B\u9762\t\u98F2\u6599\u6A5F\u653E\u5927\u5716\u793A\u3002[1]\t[1]\u9078\u64C7\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u6C34\u5566\uFF0C\u6709\u98F2\u6599\u6A5F\uFF01\r\n\u65C1\u767D\uFF1A(\u4F60\u4ED4\u7D30\u89C0\u5BDF\u4E4B\u5F8C\u767C\u73FE\uFF0C\u9019\u53F0\u6599\u6A5F\u4F3C\u4E4E\u6709\u9EDE\u6545\u969C\u3002)\r\n\u4E3B\u89D2\uFF1A\u4ED6\u597D\u50CF\u6709\u9EDE\u58DE\u6389\u4E86\uFF0C\u600E\u9EBC\u8FA6\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u4F60\u7A81\u7136\u60F3\u8D77\u4F86\u91AB\u751F\u7D66\u4F60\u7684\u96F6\u4EF6\uFF0C\u6216\u8A31\u53EF\u4EE5\u6D3E\u4E0A\u7528\u5834)\t\r\n\u968E\u6BB535\t\u756B\u9762\t\u8CA9\u8CE3\u6A5F\u8B8A\u56DE\u4FEE\u597D\u7684\u6A21\u6A23\u3002\t[1]\u9078\u64C7\u4F7F\u7528\u96F6\u4EF6\uFF0C\u4E26\u4E14\u5177\u6709\u91D1\u5C6C\u652F\u67B6\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u592A\u597D\u4E86\uFF01\u5E78\u597D\u7576\u521D\u6C92\u6709\u7D66\u90A3\u500B\u602A\u4EBA\u96F6\u4EF6\uFF0C\u770B\u4F86\u9084\u662F\u6709\u597D\u4E8B\u60C5\u767C\u751F\u7684\uFF01\t\r\n\u968E\u6BB536\t\u756B\u9762\t\u8CA9\u8CE3\u6A5F\u9084\u662F\u58DE\u6389\u7684\u6A23\u5B50\u3002\t[1]
      \u9078\u64C7\u4F7F\u7528\u96F6\u4EF6\uFF0C\u4E26\u4E14\u4E0D\u5177\u6709\u91D1\u5C6C\u652F\u67B6\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u5509\u2026\u2026\u6211\u600E\u9EBC\u8001\u662F\u505A\u51FA\u932F\u8AA4\u7684\u9078\u64C7\u2026\u2026\t\r\n\u968E\u6BB537\t\u756B\u9762\t\u9032\u5165\u68EE\u6797\u5F8C\u51FA\u73FE\u9ED1\u8272\u906E\u7F69\uFF0C\u4E2D\u592E\u6709\u6587\u5B57\u9583\u720D\uFF0C\u4E09\u79D2\u5F8C\u6703\u6D88\u5931\u3002[1]\t[1]\u6587\u5B57\u6D88\u5931\u5F8C\u81EA\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u5728\u7A7F\u8D8A\u4E86\u6574\u500B\u6C99\u6F20\u4E4B\u5F8C\uFF0C\u5728\u4F60\u773C\u524D\u51FA\u73FE\u7684\u662F\u4E00\u7247\u7DA0\u610F\u76CE\u7136\uFF0C\u5145\u6EFF\u751F\u6A5F\u7684\u5730\u65B9\uFF09\r\n\u4E3B\u89D2\uFF1A\u9019\u88E1\u5C31\u662F\u68EE\u6797\u4E86\u55CE\uFF0C\u7D42\u65BC\u56DE\u5230\u5BB6\u4E86\uFF01\r\n\u4E3B\u89D2\uFF1A\u592A\u597D\u4E86\uFF0C\u9019\u88E1\u8DDF\u8A18\u61B6\u4E2D\u770B\u8D77\u4F86\u5DEE\u4E0D\u2026\u2026\r\n\u4E3B\u89D2\uFF1A\u8A18\u61B6\u4E2D\u2026\u2026\uFF1F\t\r\n\u968E\u6BB538\t\u756B\u9762\t[1]\t[1]\u8207\u72FC\u4E92\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u773C\u524D\u7684\u72FC\u66AE\u6C23\u6C89\u6C89\u7684\u6A21\u6A23\uFF0C\u5F77\u5F7F\u88AB\u4EC0\u9EBC\u7D66\u675F\u7E1B\u4F4F\u7684\u6A23\u5B50\u3002)\r\n\u4E3B\u89D2\uFF1A\u4E0D\u597D\u610F\u601D\u2026\u2026\u60F3\u8ACB\u554F\u4E00\u4E0B\uFF0C\u9019\u88E1\u662F\u68EE\u6797\u55CE\uFF1F\r\n\u65C1\u767D\uFF1A(\u773C\u524D\u7684\u72FC\u53EA\u662F\u773C\u795E\u7280\u5229\u7684\u770B\u8457\u4F60\u2500\u2500\u4F60\u80FD\u5F9E\u4ED6\u7684\u773C\u775B\u88E1\u770B\u51FA\u4ED6\u90A3\u4E9B\u66FE\u7D93\u98A8\u5149\u7684\u65E5\u5B50\uFF0C\u4F46\u7D42\u7A76\u62B5\u64CB\u4E0D\u904E\u6B72\u6708\u7684\u6D41\u901D\u3002)\r\n\u72FC\uFF1A\u4F60\u662F\u8AB0\uFF1F\r\n\u4E3B\u89D2\uFF1A\u6211\u662F\u4E00\u96BB\u70CF\u9D09\uFF0C\u6211\u5F9E\u57CE\u5E02\u4F86\u5230\u9019\u88E1\uFF0C\u662F\u70BA\u4E86\u627E\u5230\u6211\u7684\u5BB6\u9109\u8DDF\u5BB6\u4EBA\u3002\r\n\u72FC\uFF1A\u5BB6\u963F\u2026\u2026\u8A71\u8AAA\u6211\u7684\u5169\u500B\u5152\u5B50\u4E5F\u51FA\u9580\u597D\u4E45\u4E86\u2026\u2026\r\n\u72FC\uFF1A\u4F60\u6C92\u4F86\u932F\u5730\u65B9\uFF0C\u9019\u88E1\u5C31\u662F\u68EE\u6797\u3002\u4F46\u6211\u4E0D\u6E05\u695A\u4F60\u7684\u5925\u4F34\u5728\u54EA\u88E1\uFF0C\u6211\u53EA\u80FD\u5E6B\u4F60\u5230\u9019\u88E1\u4E86\u3002\r\n\u65C1\u767D\uFF1A(\u525B\u525B\u767C\u751F\u7684\u4E00\u9023\u4E32\u4E8B\u60C5\uFF0C\u5C0E\u81F4\u4F60\u73FE\u5728\u5C0D\u65BC\u6BCF\u500B\u4EBA\u90FD\u4E0D\u662F\u5F88\u4FE1\u4EFB\u3002)\r\n\u4E3B\u89D2\uFF1A\u90A3\u500B\u2026\u2026\u4F60\u78BA\u5B9A\u55CE\uFF1F\u7576\u7136\u4E0D\u662F\u8981\u61F7\u7591\u4F60\u5566\u2026\u2026\u54C8\u54C8\u54C8\u2026\u2026\r\n\u72FC\uFF1A\u4F60\u662F\u5728\u61F7\u7591\u6211\uFF1F\u6211\u6700\u8A0E\u53AD\u9A19\u5B50\u4E86\uFF0C\u600E\u9EBC\u9084\u6703\u9A19\u4F60\u3002\r\n\u65C1\u767D\uFF1A(\u5F9E\u4ED6\u7684\u8A9E\u6C23\u53CA\u773C\u795E\u88E1\u4F60\u611F\u53D7\u5230\u4ED6\u5728\u904E\u53BB\u53EF\u80FD\u767C\u751F\u4E86\u4EC0\u9EBC\u4E8B\u60C5\uFF0C\u624D\u4F7F\u4ED6\u5C0D\u65BC\u6B3A\u9A19\u8005\u7121\u6CD5\u5BB9\u5FCD\u3002)\r\n\u65C1\u767D\uFF1A(\u4F46\u4F60\u5BE6\u5728\u662F\u7BA1\u4E0D\u8457\u90A3\u9EBC\u591A\u4E86\uFF0C\u4F60\u53EA\u60F3\u8D95\u5FEB\u96E2\u958B\u9019\u96BB\u6050\u6016\u7684\u751F\u7269\uFF0C\u4E26\u627E\u5230\u4F60\u7684\u5BB6\u4EBA\u5011\u3002)\r\n\u4E3B\u89D2\uFF1A\u597D\u6211\u77E5\u9053\u4E86\uFF0C\u8B1D\u8B1D\u4F60\u7684\u5E6B\u5FD9\uFF01\t\r\n\u968E\u6BB539\t\u756B\u9762\t[1]\t[1]\u8207\u677E\u9F20\u4E92\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u7D42\u65BC\u51FA\u73FE\u4E86\u4E00\u96BB\u9AD4\u578B\u548C\u4F60\u5DEE\u4E0D\u591A\u7684\u52D5\u7269\uFF0C\u4F60\u611F\u5230\u975E\u5E38\u6B23\u6170\u3002)\r\n\u65C1\u767D\uFF1A(\u9019\u4E0B\u5B50\u4F60\u975E\u5E38\u6709\u4FE1\u5FC3\u53EF\u4EE5\u548C\u773C\u524D\u7684\u52D5\u7269\u4F86\u4E00\u5834\u548C\u5E73\u7684\u5C0D\u8A71\u3002)\r\n\u4E3B\u89D2\uFF1A\u54C8\u56C9\uFF01\u60F3\u8ACB\u554F\u4E00\u4E0B\u4F60\u77E5\u4E0D\u77E5\u9053\u2026\u2026\r\n\u677E\u9F20\uFF1A\u5594\uFF1F\u4F60\u662F\u8AB0\uFF1F\u7B49\u4E00\u4E0B\u7B49\u4E00\u4E0B\uFF0C\u4F60\u5148\u4E0D\u8981\u8AAA\u3002\r\n\u677E\u9F20\uFF1A\u770B\u4F60\u7684\u5916\u8868\u770B\u8D77\u4F86\u61C9\u8A72\u662F\u9CE5\u3002\u563F\u563F\u563F\uFF0C\u5C31\u8DDF\u90A3\u96BB\u7B28\u8001\u9DF9\u4E00\u6A23\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u9019\u96BB\u677E\u9F20\u975E\u5E38\u7C97\u9B6F\u7684\u6253\u65B7\u4E86\u4F60\u7684\u554F\u984C\uFF0C\u800C\u4E14\u6ED4\u6ED4\u4E0D\u7D55\u5730\u8B1B\u500B\u4E0D\u505C\u3002\u5728\u9019\u500B\u77AC\u9593\uFF0C\u4F60\u5DF2\u7D93\u77E5\u9053\u826F\u597D\u7684\u5C0D\u8A71\u5DF2\u7D93\u662F\u4E0D\u53EF\u80FD\u4E86\u3002)\r\n\u677E\u9F20\uFF1A\u6211\u525B\u525B\u5DF2\u7D93\u6253\u807D\u5230\u4E86\uFF0C\u4F60\u662F\u8981\u4F86\u627E\u4F60\u7684\u5925\u4F34\u7684\u3002\u6211\u662F\u4E0D\u77E5\u9053\u4F60\u7684\u5925\u4F34\u5728\u54EA\u88E1\u5566\uFF0C\u6211\u771F\u7684\u4E0D\u77E5\u9053\u5594\uFF01\r\n\u4E3B\u89D2\uFF1A\u4F60\u53EF\u4EE5\u5148\u8B93\u6211\u2026\u2026\r\n\u677E\u9F20\uFF1A\u4E0D\u904E\u4F60\u53EF\u4EE5\u554F\u770B\u770B\u5728\u6A39\u4E0A\u7684\u90A3\u96BB\u8001\u9DF9\uFF0C\u7562\u7ADF\u4ED6\u53EF\u4EE5\u98DB\u5F97\u5F88\u9AD8\uFF0C\u8AAA\u4E0D\u5B9A\u53EF\u4EE5\u770B\u5230\u4F60\u7684\u5BB6\u4EBA\u3002\r\n\u677E\u9F20\uFF1A\u4E0D\u904E\u9084\u4E0D\u662F\u88AB\u6211\u7684\u8A71\u641E\u7684\u5718\u5718\u8F49\uFF0C\u563F\u563F\u563F\u2026\u2026\r\n\u4E3B\u89D2\uFF1A\u90A3\u2026\u2026\r\n\u677E\u9F20\uFF1A\u4F60\u771F\u7684\u4E0D\u7528\u8B1D\u8B1D\u6211\u5566\uFF0C\u771F\u7684\u4E0D\u7528\u5566\uFF01\r\n\u65C1\u767D\uFF1A(\u677E\u9F20\u5C31\u9019\u6A23\u8DD1\u6389\u4E86\uFF0C\u4F60\u9023\u500B\u5B8C\u6574\u7684\u53E5\u5B50\u90FD\u6C92\u8AAA\u51FA\u4F86\uFF0C\u4F46\u81F3\u5C11\u4F60\u7372\u5F97\u4E86\u4E0D\u932F\u7684\u8CC7\u8A0A\u3002)\r\n\u4E3B\u89D2\uFF1A(\u600E\u9EBC\u5728\u9019\u88E1\u7684\u5927\u5BB6\u4E5F\u90FD\u602A\u602A\u7684\u2026\u2026)\t\r\n\u968E\u6BB540\t\u756B\u9762\t[1]\t[1]\u8207\u8001\u9DF9\u4E92\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u98DB\u4E86\u5F88\u9AD8\u5F88\u9AD8\uFF0C\u4F60\u624D\u9047\u5230\u4E86\u4E00\u96BB\u8001\u9DF9\u3002\u96D6\u7136\u4F60\u4E00\u76F4\u90FD\u662F\u5728\u98DB\u884C\uFF0C\u4F46\u4F60\u9084\u662F\u64D4\u5FC3\u4F60\u4E4B\u524D\u5728\u57CE\u5E02\u53D7\u7684\u50B7\u6703\u4E0D\u6703\u8B93\u4F60\u7A81\u7136\u5F9E\u9AD8\u7A7A\u6389\u4E0B\u4F86\u3002)\r\n\u8001\u9DF9\uFF1A\u6211\u77E5\u9053\u4F60\u662F\u8AB0\uFF0C\u677E\u9F20\u5DF2\u7D93\u8DDF\u6211\u8AAA\u904E\u4E86\u3002\r\n\u8001\u9DF9\uFF1A\u5305\u542B\u4F60\u5728\u6C99\u6F20\u9047\u5230\u86C7\u7684\u4E8B\u60C5\uFF0C\u6211\u5C31\u77E5\u9053\u86C7\u90FD\u4E0D\u662F\u4EC0\u9EBC\u597D\u6771\u897F\uFF01\r\n\u4E3B\u89D2\uFF1A(\u9019\u96BB\u677E\u9F20\u53EF\u771F\u662F\u516B\u5366\u3002)\r\n\u4E3B\u89D2\uFF1A\u90A3\u6211\u60F3\u8ACB\u554F\u4E00\u4E0B\uFF0C\u4F60\u6709\u770B\u5230\u6211\u7684\u5925\u4F34\u5011\u55CE\uFF1F\r\n\u8001\u9DF9\uFF1A\u4F60\u5925\u4F34\u7684\u5DE2\u5C31\u5728\u524D\u9762\uFF0C\u4E0D\u904E\u4ED6\u5011\u633A\u6392\u5916\u7684\uFF0C\u4F60\u53EF\u8981\u81EA\u5DF1\u5C0F\u5FC3\u3002\r\n\u8001\u9DF9\uFF1A\u8A71\u8AAA\u4F60\u4E00\u8DEF\u5F9E\u57CE\u5E02\u98DB\u904E\u4F86\u9019\u88E1\uFF0C\u7406\u8AD6\u4E0A\u4F86\u8AAA\u4F60\u61C9\u8A72\u7D2F\u58DE\u4E86\u2026\u2026\r\n\u8001\u9DF9\uFF1A\u4F60\u771F\u7684\u662F\u96BB\u9CE5\u55CE\uFF1F//\u9019\u53E5\u8A71\u5728\u904A\u6232\u88E1\u9762\u6539\u7D05\u8272\u7684\u5B57\r\n\u4E3B\u89D2\uFF1A(\u4ED6\u600E\u9EBC\u958B\u59CB\u8B1B\u4E00\u4E9B\u5947\u602A\u7684\u8A71\u2026\u2026\u6211\u4E0D\u662F\u96BB\u9CE5\u9084\u80FD\u662F\u4EC0\u9EBC\uFF1F)\r\n\u4E3B\u89D2\uFF1A\u6211\u7576\u7136\u662F\u96BB\u9CE5\uFF0C\u662F\u96BB\u70CF\u9D09\uFF0C\u4F60\u770B\u770B\u6211\u7684\u6A23\u5B50\u5C31\u77E5\u9053\u4E86\uFF01\r\n\u65C1\u767D\uFF1A(\u8001\u9DF9\u610F\u5473\u6DF1\u9577\u5730\u770B\u8457\u4F60\uFF0C\u4E00\u8A00\u4E0D\u767C\u7684\u5C31\u96E2\u958B\u4E86)\t\r\n\u968E\u6BB541\t\u756B\u9762\t\u70CF\u9D09\u7FA4[1][2]\u3002\t[1]
      \u8207\u70CF\u9D09\u7FA4\u4E92\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u70CF\u9D09\u53EB\u8072\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u7D42\u65BC\uFF01\u4F60\u6B77\u7D93\u4E86\u5343\u8F9B\u842C\u82E6\uFF0C\u4F60\u7D42\u65BC\u770B\u5230\u4E86\u4F60\u7684\u5BB6\u4EBA\u2500\u2500\u4ED6\u5011\u9577\u5F97\u8DDF\u4F60\u4E00\u6A21\u4E00\u6A23\uFF0C\u6709\u4E00\u6A23\u7684\u984F\u8272\uFF0C\u4E00\u6A23\u7684\u6BDB\u9AEE\u3002\u4F60\u5E7E\u4E4E\u53EF\u4EE5\u78BA\u5B9A\uFF0C\u4F60\u7D42\u65BC\u56DE\u5230\u2026\u2026)\r\n\u4E3B\u89D2\uFF1A\u5404\u4F4D\uFF0C\u6211\u56DE\u4F86\u4E86\uFF01\r\n\u65C1\u767D\uFF1A(\u7136\u800C\uFF0C\u4F60\u9810\u60F3\u4E2D\u7684\u611F\u4EBA\u91CD\u9022\u6C92\u6709\u767C\u751F\u3002)\r\n\u65C1\u767D\uFF1A(\u4F60\u773C\u524D\u7684\u70CF\u9D09\u7FA4\u53EA\u662F\u51B7\u51B7\u5730\u770B\u8457\u4F60\uFF0C\u9732\u51FA\u4E00\u81C9\u964C\u751F\u7684\u8868\u60C5\uFF0C\u4E26\u4E14\u4E0D\u505C\u7ACA\u7ACA\u79C1\u8A9E\u3002)\r\n\u4E3B\u89D2\uFF1A\u5404\u4F4D\u2026\u2026\uFF1F\r\n\u4E3B\u89D2\uFF1A\u5C0D\u4E86\uFF0C\u4F60\u5011\u4E00\u5B9A\u53EA\u662F\u9694\u4E86\u592A\u4E45\u8A8D\u4E0D\u51FA\u6211\uFF01\u6211\u8DDF\u4F60\u5011\u4E00\u6A23\uFF0C\u6211\u5728\u57CE\u5E02\u88E1\u8FF7\u8DEF\u4E86\uFF0C\u6211\u98DB\u4E86\u597D\u4E45\u624D\u2026\u2026\r\n\u70CF\u9D09\uFF1A\u6211\u5011\u70CF\u9D09\u662F\u4E0D\u6703\u5206\u958B\u884C\u52D5\u7684\uFF0C\u4F60\u662F\u8AB0\uFF1F\r\n\u65C1\u767D\uFF1A(\u4F60\u591A\u9EBC\u5E0C\u671B\u9019\u53EA\u662F\u5834\u6574\u4EBA\u7BC0\u76EE\uFF0C\u4F46\u4ED6\u5011\u7684\u8A9E\u6C23\u5DF2\u7D93\u5145\u8DB3\u7684\u8868\u9054\u51FA\u2500\u2500\u4F60\u548C\u4ED6\u5011\u4E26\u4E0D\u662F\u540C\u985E\u3002)\r\n\u4E3B\u89D2\uFF1A\u600E\u9EBC\u6703\u2026\u2026\u6211\u53EA\u662F\u8FF7\u8DEF\u4E86\u800C\u5DF2\u2026\u2026\r\n\u70CF\u9D09\uFF1A\u90A3\u4F60\u4ED4\u7D30\u60F3\u60F3\uFF0C\u4F60\u8A8D\u5F97\u6211\u5011\u55CE\uFF1F\r\n\u4E3B\u89D2\uFF1A\u7576\u7136\uFF0C\u6211\u2026\u2026\t\r\n\u968E\u6BB542\t\u756B\u9762\t\u50CF\u64A5\u653E\u6295\u5F71\u7247\u4E00\u6A23\u6ED1\u904E\u5E7E\u5F35\u5716\u7247\uFF0C\u5206\u5225\u662F\u5BE6\u9A57\u5BA4\u3001\u90FD\u5E02\u9047\u5230\u7684\u89D2\u8272\u3001\u6C99\u6F20\u9047\u5230\u7684\u89D2\u8272\u3001\u548C\u9032\u5165\u68EE\u6797\u5F8C\u9047\u5230\u7684\u89D2\u8272\u3002\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u5728\u9019\u77AC\u9593\uFF0C\u4F60\u56DE\u60F3\u4E86\u4E00\u4E9B\u4E4B\u524D\u767C\u751F\u7684\u4E8B\u60C5\u3002)\r\n\u65C1\u767D\uFF1A(\u4F46\u4E0D\u8AD6\u4F60\u600E\u9EBC\u601D\u8003\uFF0C\u8A18\u61B6\u53EA\u5F9E\u4F60\u5F9E\u5BE6\u9A57\u5BA4\u9192\u4F86\u90A3\u4E00\u5E55\u958B\u59CB\uFF0C\u4F60\u6C92\u6709\u66F4\u4E45\u4E4B\u524D\u7684\u8A18\u61B6\u3002)\r\n\u4E3B\u89D2\uFF1A\u2026\u2026\r\n\u70CF\u9D09\uFF1A\u6211\u662F\u9019\u7FA4\u70CF\u9D09\u7684\u9996\u9818\uFF0C\u53EB\u505A\u9727\u5C3C\u3002\r\n\u9727\u5C3C\uFF1A\u6211\u5C31\u76F4\u63A5\u8AAA\u4E86\u5427\uFF0C\u6211\u5011\u5F9E\u4F86\u6C92\u6709\u770B\u904E\u4F60\u9019\u96BB\u70CF\u9D09\u2500\u2500\u81F3\u5C11\u6211\u8A18\u61B6\u4E2D\u6C92\u6709\uFF0C\u4F46\u6211\u7684\u8A18\u61B6\u662F\u4E0D\u53EF\u80FD\u51FA\u932F\u7684\u3002\r\n\u9727\u5C3C\uFF1A\u4F60\u4ED4\u7D30\u89C0\u5BDF\u81EA\u5DF1\u5427\uFF01\u4F60\u90A3\u7FC5\u8180\u5DF2\u7D93\u53D7\u50B7\u7684\u90A3\u9EBC\u56B4\u91CD\u4E86\uFF0C\u70BA\u4EC0\u9EBC\u4F60\u9084\u80FD\u82E5\u7121\u5176\u4E8B\u7684\u98DB\u884C\uFF1F\r\n\u4E3B\u89D2\uFF1A\u56E0\u70BA\u91AB\u751F\u6709\u5E6B\u6211\u6CBB\u7642\uFF0C\u4ED6\u9084\u8DDF\u6211\u8AAA\u6709\u4E8B\u60C5\u53EF\u4EE5\u627E\u4ED6\u2026\u2026\r\n\t\r\n\u968E\u6BB543\t\u756B\u9762\t\u9ED1\u8272\u906E\u7F69\u906E\u4F4F\u756B\u9762\uFF0C\u6D6E\u73FE\u51FA\u5169\u500B\u91D1\u5C6C\u652F\u67B6\u548C\u5728\u90FD\u5E02\u9047\u5230\u7684\u91AB\u751F\u3002\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u731B\u7136\u60F3\u8D77\uFF0C\u70BA\u4EC0\u9EBC\u91AB\u751F\u6703\u7D66\u4F60\u5169\u584A\u91D1\u5C6C\u652F\u67B6\uFF1F\u800C\u4E14\u9084\u662F\u6709\u53D7\u5230\u640D\u50B7\u7684\u91D1\u5C6C\u2026\u2026)\r\n\u4E3B\u89D2\uFF1A\u4E0D\u6703\u5427\u2026\u2026\r\n\u9727\u5C3C\uFF1A\u770B\u4F86\u4F60\u6CE8\u610F\u5230\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u6211\u597D\u6B79\u4E5F\u6D3B\u4E86\u5F88\u9577\u4E00\u6BB5\u6642\u9593\uFF0C\u4E5F\u77E5\u9053\u4E86\u4E0D\u5C11\u4E8B\u60C5\u3002\r\n\u9727\u5C3C\uFF1A\u6211\u6709\u807D\u8AAA\u73FE\u5728\u5916\u9762\u7684\u4E16\u754C\u79D1\u6280\u8D8A\u4F86\u8D8A\u767C\u9054\uFF0C\u5DF2\u7D93\u9060\u8D85\u51FA\u6211\u5011\u7684\u60F3\u50CF\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u6211\u539F\u672C\u9084\u5728\u64D4\u5FC3\u6703\u4E0D\u6703\u5F15\u60F3\u5230\u6211\u5011\u9019\u7247\u68EE\u6797\uFF0C\u6C92\u60F3\u5230\u9019\u4E00\u5929\u9019\u9EBC\u5FEB\u5C31\u4F86\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u4F60\u6839\u672C\u4E0D\u662F\u96BB\u70CF\u9D09\uFF0C\u4F60\u53EA\u662F\u96BB\u6A5F\u5668\u4EBA\u3002\r\n\u9727\u5C3C\uFF1A\u4F60\u53EA\u662F\u8A8D\u70BA\u81EA\u5DF1\u662F\u96BB\u70CF\u9D09\uFF0C\u4F46\u5BE6\u969B\u4E0A\u4F60\u6839\u672C\u4E0D\u5C6C\u65BC\u9019\u88E1\u3002\u4F60\u53EA\u662F\u5F9E\u4F60\u300C\u8166\u888B\u300D\u88E1\u641C\u5C0B\u51FA\u4E86\u6700\u9069\u5408\u4F60\u5C45\u4F4F\u7684\u5730\u65B9\u3002\t\r\n\u968E\u6BB544\t\u756B\u9762\t\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u5C0D\u65BC\u4ED6\u5011\u8AAA\u7684\u4E8B\u60C5\uFF0C\u4F60\u4E0D\u9858\u76F8\u4FE1\uFF0C\u4F46\u4ED4\u7D30\u56DE\u60F3\u9019\u4E00\u8DEF\u767C\u751F\u7684\u4E8B\u60C5\uFF0C\u6709\u592A\u591A\u4E0D\u5408\u7406\u7684\u5730\u65B9\u4E86)\r\n\u65C1\u767D\uFF1A(\u70BA\u4EC0\u9EBC\u6211\u6C92\u6709\u4E4B\u524D\u7684\u8A18\u61B6\uFF1F\u70BA\u4EC0\u9EBC\u6211\u4E0D\u611F\u89BA\u4E0D\u5230\u99F1\u99DD\u8AAA\u7684\u51B7\uFF1F\u70BA\u4EC0\u9EBC\u9D15\u9CE5\u7D66\u6211\u7684\u6C34\u8DDF\u5728\u57CE\u5E02\u62FF\u5230\u7684\u6C34\u4E0D\u4E00\u6A23\uFF1F)\r\n\u65C1\u767D\uFF1A(\u5230\u6700\u5F8C\uFF0C\u4F60\u4E0D\u5F97\u4E0D\u627F\u8A8D\u2026\u2026)\r\n\u65C1\u767D\uFF1A(\u4F60\u4E26\u4E0D\u662F\u96BB\u70CF\u9D09\uFF0C\u4F60\u53EA\u662F\u9AD8\u79D1\u6280\u4E0B\u7684\u7522\u7269\u3002)\r\n\u65C1\u767D\uFF1A(\u4F60\u6C92\u6709\u547C\u5438\uFF0C\u4F60\u6C92\u6709\u5FC3\u8DF3\uFF0C\u4F60\u6240\u6709\u7684\u4E00\u5207\u53EA\u662F\u75311\u548C0\u7D44\u5408\u8D77\u4F86\u7684\u3002)\t\r\n\u968E\u6BB545\t\u756B\u9762\t\u6A5F\u5668\u4EBA\u653E\u5927\u5716\u793A\u3002\t\r\n\t\u5C0D\u8A71\t\u5435\u96DC\u7684\u6A5F\u5668\u4EBA\u8072\u97F3\uFF1A\u6211\u525B\u525B\u770B\u5230\u4ED6\u5F80\u9019\u88E1\u8D70\u4E86\uFF01\u8A72\u6B7B\u7684\u5BE6\u9A57\u54C1\uFF0C\u600E\u9EBC\u9019\u9EBC\u80FD\u8DD1\uFF01\r\n\u65C1\u767D\uFF1A(\u56DE\u982D\u671B\u53BB\uFF0C\u4F60\u770B\u898B\u4E86\u8A31\u591A\u57CE\u5E02\u88E1\u898B\u904E\u7684\u6A5F\u5668\u4EBA\u3002\u4F60\u5F88\u5FEB\u7684\u610F\u8B58\u5230\uFF0C\u4ED6\u5011\u53E3\u4E2D\u7684\u5BE6\u9A57\u54C1\u5C31\u662F\u6307\u4F60\uFF0C\u4ED6\u5011\u662F\u4F86\u8FFD\u6355\u4F60\u7684\u3002)\r\n\u4E3B\u89D2\uFF1A\u8A72\u600E\u9EBC\u8FA6\u2026\u2026\u6211\u8A72\u53BB\u54EA\u88E1\uFF1F\r\n\u9727\u5C3C\uFF1A\u4F60\u8DDF\u4ED6\u5011\u8D70\u5427\uFF0C\u4F60\u548C\u6211\u5011\u4E26\u4E0D\u662F\u540C\u985E\uFF0C\u4E0D\u8981\u518D\u5E36\u7D66\u6211\u5011\u56F0\u64FE\u4E86\u3002\t\r\n\u968E\u6BB546\t\u756B\u9762\t[1]\t[1]\u6C92\u6709\u5F9E\u6597\u7BF7\u602A\u5496\u90A3\u88CF\u7372\u5F97\u5716\u9A30(\u7D66\u4E88\u91D1\u5C6C\u652F\u67B6\u5F8C\u6703\u7372\u5F97)\u89F8\u767C\u6B64\u8655\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u807D\u5B8C\u9727\u5C3C\u7684\u8A71\uFF0C\u4F60\u53EA\u80FD\u7D55\u671B\u5730\u770B\u8457\u70CF\u9D09\u5011\u98DB\u96E2\u4F60\uFF0C\u4ED6\u5011\u6C92\u6709\u4E00\u7D72\u7684\u7336\u8C6B\u3002)\r\n\u65C1\u767D\uFF1A(\u4F60\u60F3\u653E\u8072\u5927\u54ED\uFF0C\u4E0D\u9858\u63A5\u53D7\u9019\u500B\u4E8B\u5BE6\u3002\u4F46\u4F60\u4E5F\u53EA\u662F\u96BB\u6A5F\u5668\u9CE5\uFF0C\u4F60\u9023\u54ED\u6CE3\u7684\u529F\u80FD\u90FD\u6C92\u6709\uFF0C\u53EA\u80FD\u773C\u775C\u775C\u7684\u770B\u8457\u6A5F\u5668\u4EBA\u5011\u6293\u4F4F\u4F60\u51B0\u51B7\u7684\u8EAB\u9AD4\u3002)\r\n\u5435\u96DC\u7684\u6A5F\u5668\u4EBA\u8072\u97F3\uFF1A\u7D42\u65BC\u88AB\u6211\u6293\u5230\u4F60\u4E86\uFF01002\u865F\uFF0C\u8DDF\u6211\u56DE\u5BE6\u9A57\u5BA4\u5427\uFF0C\u6211\u5011\u5F97\u597D\u597D\u7814\u7A76\u4F60\u90FD\u505A\u4E86\u4E9B\u4EC0\u9EBC\u4E8B\u60C5\uFF01\r\n\u65C1\u767D\uFF1A(\u5C31\u9019\u6A23\uFF0C\u4F60\u7684\u5C0B\u5BB6\u4E4B\u65C5\u7D50\u675F\u4E86\u3002)\r\n\u65C1\u767D\uFF1A(\u6216\u8005\u8AAA\uFF0C\u73FE\u5728\u624D\u662F\u771F\u7684\u8981\u56DE\u5230\u5C6C\u65BC\u4F60\u7684\u300C\u5BB6\u300D\u2026.)\t\r\n\u968E\u6BB547\t\u756B\u9762\t[1]\u5716\u9A30\u51FA\u73FE\u5728\u756B\u9762\u4E0A\u3002\t[1]\u6709\u62FF\u5230\u5716\u9A30\u5F8C\u5728\u6B64\u8655\u6703\u81EA\u52D5\u4F7F\u7528\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u807D\u5B8C\u9727\u5C3C\u8AAA\u7684\u8A71\uFF0C\u4F60\u5446\u5750\u5728\u539F\u5730\uFF0C\u4E0D\u9858\u63A5\u53D7\u9019\u500B\u4E8B\u5BE6\u3002)\r\n\u9727\u5C3C\uFF1A\u4F60\u9019\u662F\u54EA\u4F86\u7684\uFF1F\r\n\u65C1\u767D\uFF1A(\u9727\u5C3C\u9707\u9A5A\u5730\u770B\u8457\u4F60\u63E1\u8457\u7684\u5716\u9A30\u2500\u2500\u662F\u90FD\u5E02\u88E1\u90A3\u500B\u6597\u7BF7\u602A\u5496\u7D66\u4F60\u7684\uFF0C\u4F60\u5728\u6C99\u6F20\u6642\u56E0\u70BA\u6C92\u6709\u559D\u5230\u98F2\u6599\u800C\u611F\u5230\u975E\u5E38\u751F\u6C23\u3002)
      \r\n\u4E3B\u89D2\uFF1A\u9019\u662F\u6211\u5728\u90FD\u5E02\u88E1\u9047\u5230\u4E00\u500B\u7A7F\u8457\u6597\u7BF7\u7684\u602A\u4EBA\uFF0C\u5E6B\u52A9\u4ED6\u4E4B\u5F8C\u4ED6\u7D66\u6211\u7684\u8B1D\u79AE\u3002\r\n\u65C1\u767D\uFF1A(\u9727\u5C3C\u807D\u5B8C\u4E4B\u5F8C\u5F77\u5F7F\u60F3\u8D77\u4E86\u4EC0\u9EBC\uFF0C\u6C89\u601D\u4E86\u4E00\u6703\u3002)\r\n\u9727\u5C3C\uFF1A\u66FE\u7D93\u6211\u5011\u6709\u4E00\u500B\u540C\u4F34\uFF0C\u4ED6\u56AE\u5F80\u81EA\u7531\u3001\u4E0D\u88AB\u5BB6\u65CF\u7BA1\u7406\u7684\u751F\u6D3B\uFF0C\u65BC\u662F\u4ED6\u6BC5\u7136\u6C7A\u7136\u7684\u96E2\u958B\u4E86\u70CF\u9D09\u7FA4\u9AD4\uFF0C\u671D\u8457\u9060\u65B9\u98DB\u53BB\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u5F88\u5947\u602A\u5427\uFF01\u660E\u660E\u5DF2\u7D93\u8EAB\u70BA\u9CE5\u4E86\uFF0C\u537B\u9084\u60F3\u8457\u81EA\u7531\u7684\u751F\u6D3B\u3002\r\n\u4E3B\u89D2\uFF1A\u4F46\u4F60\u4E0D\u662F\u8AAA\u70CF\u9D09\u4E0D\u80FD\u7368\u81EA\u751F\u6D3B\u55CE\uFF1F\r\n\u9727\u5C3C\uFF1A\u5C0D\uFF0C\u6240\u4EE5\u6211\u5011\u5927\u5BB6\u90FD\u8A8D\u70BA\u4ED6\u5DF2\u7D93\u96E2\u4E16\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u9019\u662F\u6211\u7576\u521D\u4EA4\u4ED8\u7D66\u4ED6\u7684\u4FE1\u7269\uFF0C\u9019\u6A23\u6211\u5011\u624D\u80FD\u8A8D\u51FA\u4F86\u3002\r\n\u9727\u5C3C\uFF1A\u4F60\u62FF\u5230\u4E86\u4FE1\u7269\uFF0C\u90A3\u7576\u521D\u90A3\u500B\u7A7F\u6597\u7BF7\u7684\u602A\u4EBA\u61C9\u8A72\u5C31\u662F\u4ED6\u3002\u5927\u6982\u662F\u4F60\u5E6B\u52A9\u4E86\u4ED6\uFF0C\u4ED6\u624D\u6703\u5C07\u9019\u4FE1\u7269\u4EA4\u7D66\u4F60\u3002\r\n\u9727\u5C3C\uFF1A\u4ED6\u9084\u662F\u4E00\u6A23\u90A3\u9EBC\u50BB\uFF0C\u653E\u68C4\u4E86\u81EA\u5DF1\u56DE\u5BB6\u7684\u6A5F\u6703\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u9727\u5C3C\u8AAA\u5B8C\u9019\u4E9B\u8A71\u5F8C\u53C8\u9677\u5165\u4E86\u6C89\u601D\uFF0C\u4F46\u773C\u4E0B\u57CE\u5E02\u7684\u8FFD\u5175\u5DF2\u7D93\u8D8A\u4F86\u8D8A\u63A5\u8FD1\u4E86\uFF0C\u4F60\u5F97\u8D95\u5FEB\u9760\u81EA\u5DF1\u60F3\u51FA\u812B\u8EAB\u7684\u8FA6\u6CD5\u3002)\r\n\u9727\u5C3C\uFF1A\u8DDF\u6211\u5011\u8D70\u5427\uFF01\r\n\u4E3B\u89D2\uFF1A\u4EC0\u9EBC\uFF1F\u4F46\u4F60\u525B\u525B\u4E0D\u662F\u8AAA\u2026\u2026\r\n\u9727\u5C3C\uFF1A\u6211\u53EA\u662F\u64D4\u5FC3\u4F60\u7684\u5230\u4F86\u6703\u4E0D\u6703\u5C0D\u6211\u5011\u539F\u672C\u548C\u5E73\u7684\u751F\u6D3B\u5E36\u4F86\u6539\u8B8A\uFF0C\u4F46\u65E2\u7136\u4F60\u5E6B\u52A9\u4E86\u6211\u5011\u7684\u5925\u4F34\uFF0C\u4ED6\u9078\u64C7\u76F8\u4FE1\u4E86\u4F60\u2026\u2026\r\n\u9727\u5C3C\uFF1A\u90A3\u6211\u5011\u6216\u8A31\u53EF\u4EE5\u8A66\u8457\u63A5\u7D0D\u4F60\u3002\r\n\u65C1\u767D\uFF1A(\u8AAA\u6642\u9072\u90A3\u6642\u5FEB\uFF0C\u5E95\u4E0B\u7684\u8FFD\u5175\u6CE8\u610F\u5230\u9019\u88E1\u4E86\u3002\u9727\u5C3C\u8DDF\u70CF\u9D09\u7FA4\u5011\u793A\u610F\u4F60\u8DDF\u8457\u4ED6\u5011\u4E00\u8D77\u96E2\u958B\uFF0C\u524D\u5F80\u4E0B\u4E00\u7247\u68EE\u6797\u3002)\r\n\u65C1\u767D\uFF1A(\u4E00\u6BB5\u6642\u9593\u7684\u98DB\u884C\u5F8C\uFF0C\u5DF2\u7D93\u770B\u4E0D\u5230\u5E95\u4E0B\u7684\u8FFD\u5175\u4E86\u3002)\r\n\u65C1\u767D\uFF1A(\u5F9E\u73FE\u5728\u958B\u59CB\uFF0C\u4F60\u5C07\u6703\u548C\u9019\u7FA4\u70CF\u9D09\u5171\u5EA6\u9918\u751F\uFF0C\u7562\u7ADF\u4F60\u662F\u4ED6\u5011\u7684\u300C\u540C\u985E\u300D\u3002)\r\n\u65C1\u767D\uFF1A(\u4F46\u9019\u6A23\uFF0C\u771F\u7684\u662F\u4F60\u60F3\u8981\u7684\u751F\u6D3B\u55CE\uFF1F)\t\r\n\r\n\r\n\u5F9E\u5FEB\u600E\u6027\u60C5\u60F3\u611F\u61C9\u6211\u6216\u6232\u624B\u624D\u6253\u627E\u628A\u62D2\u62FF\u6309\u6389\u63A2\u63A5\u63A7\u63D0\u64BF\u64C7\u5C0D\u8C61\u555F\u5287\u60C5\u5927\u7DB1\uFF1A\r\n\u4E3B\u89D2\u5728\u5BE6\u9A57\u5BA4\u4E2D\u9192\u4F86\uFF0C\u4E26\u4E0D\u77E5\u9053\u81EA\u5DF1\u8EAB\u8655\u54EA\u88E1\u3002\u4ED6\u8A18\u5F97\u81EA\u5DF1\u7684\u540D\u5B57\uFF0C\u4F46\u6C92\u6709\u95DC\u65BC\u5BB6\u7684\u8A18\u61B6\u3002\u4ED6\u767C\u73FE\u4ED6\u7684\u8A18\u61B6\u5F88\u597D\uFF0C\u4F46\u6C92\u6709\u5BB6\u7684\u8A18\u61B6\u5F88\u5947\u602A\uFF0C\u65BC\u662F\u4E3B\u89D2\u6C7A\u5B9A\u53BB\u5C0B\u627E\u6240\u8B02\u7684\u201D\u5BB6\u201D\u3002\u5F9E\u5BE6\u9A57\u5BA4\u5F97\u77E5\u81EA\u5DF1\u7684\u7269\u7A2E\u5F8C\uFF0C\u9593\u63A5\u5F97\u77E5\u81EA\u5DF1\u61C9\u8A72\u8981\u4F4F\u5728\u68EE\u6797\u88E1\u3002\r\n\u5C0B\u627E\u7684\u904E\u7A0B\u4E2D\u4E3B\u89D2\u88AB\u6162\u6162\u5F15\u5C0E\u524D\u5F80\u4E0D\u540C\u7684\u5730\u9EDE\uFF0C\u4ED6\u6703\u6162\u6162\u767C\u73FE\u4E00\u4E9B\u8207\u8A8D\u77E5\u4E2D\u5F88\u4E0D\u4E00\u6A23\u7684\u4E8B\u60C5\u3002\r\n\u4F46\u5728\u6700\u5F8C\u624D\u767C\u73FE\uFF0C\u539F\u4F86\u4ED6\u548C\u5176\u4ED6\u52D5\u7269\u8207\u773E\u4E0D\u540C\u3002\r\n\r\n\r\n\u2003\r\n\u6545\u4E8B\u8173\u672C\uFF1A\r\n\u6BB5\u843D\t\u756B\u9762\u8207\u5C0D\u8A71\t\u5099\u8A3B\r\n\u5BE6\u9A57\u5BA4\r\n\u5287\u60C5\u8D70\u5411\uFF1A\r\n\u4E3B\u89D2\u5728\u5BE6\u9A57\u5BA4\u9192\u4F86\uFF0C\u4ED6\u8A18\u5F97\u81EA\u5DF1\u7684\u540D\u5B57\u548C\u8EAB\u5206\uFF0C\u5F88\u591A\u5C0F\u7D30\u7BC0\u7684\u8A18\u61B6\u90FD\u8A18\u5F97\u6E05\u695A\uFF0C\u4F46\u4ED6\u4E0D\u8A18\u5F97\u5BB6\u5728\u54EA\u88E1\u3002\u5F9E\u5BE6\u9A57\u5BA4\u4EBA\u54E1\u53E3\u4E2D\u77E5\u9053\u81EA\u5DF1\u7684\u5BB6\u61C9\u8A72\u662F\u68EE\u6797\uFF0C\u4E0D\u61C9\u8A72\u662F\u5BE6\u9A57\u5BA4\uFF0C\u56E0\u6B64\u8E0F\u4E0A\u56DE\u5BB6\u7684\u65C5\u7A0B\u3002\r\n\u9019\u6BB5\u5287\u60C5\u6211\u5011\u5229\u7528\u62FE\u7372\u7684\u7269\u4EF6\uFF0C\u4F86\u63ED\u9732\u4E3B\u89D2\u4F7F\u7528\u7684\u7269\u4EF6\u8DDF\u73A9\u5BB6\u4E00\u822C\u8A8D\u77E5\u4E0D\u540C\u3002\u4F8B\u5982\u73A9\u5BB6\u8A8D\u77E5\u4E2D\u53EF\u4EE5\u559D\u7684\u6C34\uFF0C\u5C0D\u65BC\u4E3B\u89D2\u4F86\u8AAA\u662F\u4E0D\u80FD\u559D\u7684\uFF1B\u800C\u4FEE\u7406\u6A5F\u68B0\u7684\u6A5F\u6CB9\uFF0C\u7576\u73A9\u5BB6\u4F01\u5716\u53BB\u4F7F\u7528\u7684\u6642\u5019\u537B\u662F\u53EF\u4EE5\u7528\u7684\uFF0C\u4E26\u4E14\u4F7F\u7528\u5F8C\u4E3B\u89D2\u95DC\u65BC\u300C\u751F\u547D\u9700\u6C42\u300D\u7684\u6578\u503C\u6703\u63D0\u5347\u3002\r\n\u5287\u60C5\u4E2D\u6240\u6709\u8CC7\u8A0A\u6703\u56E0\u4E3B\u89D2\u7684\u884C\u70BA\u5F71\u97FF\uFF0C\u5C0D\u8A71\u4E2D\u53EF\u4EE5\u7372\u5F97\u7684\u8CC7\u8A0A\u6703\u96A8\u8457\u4E3B\u89D2\u7684\u8A8D\u77E5\u6EFE\u52D5\u66F4\u65B0\u3002\r\n
      \r\n\u968E\u6BB501\t\u756B\u9762\t\u7728\u773C\u7684\u52D5\u756B\u7D50\u675F\u5F8C\uFF0C\u9032\u5165\u5C0D\u8A71\u3002\t\u904A\u6232\u958B\u59CB\u5F8C\u6703\u76F4\u63A5\u9032\u5165\u7728\u773C\u52D5\u756B\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u2026\u2026\r\n\u65C1\u767D\uFF1A\uFF08\u4F60\u5DE6\u53F3\u89C0\u5BDF\uFF09\r\n\u4E3B\u89D2\uFF1A\u9019\u662F\u54EA\u88E1\u2026?\r\n\u4E3B\u89D2\uFF1A\u6211\u53C8\u662F\u8AB0?\r\n\u4E3B\u89D2\uFF1A\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u7D93\u904E\u4E00\u756A\u56DE\u60F3\u4E4B\u5F8C\uFF0C\u4F60\u60F3\u8D77\u4F86\u4E86\u4F60\u662F\u96BB\u9CE5\uFF0C\u4F46\u9019\u88E1\u53C8\u662F\u54EA\u88E1\uFF1F)\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u4F60\u600E\u9EBC\u6703\u5728\u9019\u88E1?\u3000[1]\r\n\u65C1\u767D\uFF1A\uFF08\u6709\u4EBA\u8D70\u4E86\u904E\u4F86\uFF09\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u6211\u770B\u4F60\u7684\u6A23\u5B50\uFF0C\u4F60\u4E0D\u8A72\u51FA\u73FE\u5728\u9019\u88E1\u624D\u5C0D\u3002\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u4F60\u8D95\u7DCA\u96E2\u958B\u9019\u88E1\u5427\uFF01\t[1]
      \u7576\u524D\u73A9\u5BB6\u5C1A\u4E0D\u77E5\u9053\u642D\u8A71\u8005\u662F\u8AB0\u3002\r\n\u968E\u6BB502\t\u756B\u9762\t\u51FA\u73FE\u5169\u500B\u9078\u9805\u300C\u8A62\u554F\u300D\u3001\u300C\u7121\u8996\u300D\uFF0C\u9078\u64C7\u8A62\u554F\u6703\u89F8\u767C\u4E0B\u5217\u5C0D\u8A71\uFF0C\u9078\u64C7\u7121\u8996\u6703\u8DF3\u904E\u5269\u9918\u5C0D\u8A71\u76F4\u63A5\u9032\u5165\u5BE6\u9A57\u5BA4\u7684\u63A2\u7D22\u74B0\u7BC0\u3002\t[1]\u9078\u64C7\u8A62\u554F\u4E0D\u61C9\u8A72\u51FA\u73FE\u7684\u7406\u7531\uFF0C\u89F8\u767C\u5BE6\u9A57\u5BA4\u4EBA\u54E1\u89E3\u91CB\u7684\u5287\u60C5\uFF1B\u82E5\u9078\u7121\u8996\u9078\u9805\u5247\u4E0D\u6703\u89F8\u767C\u4E0B\u5217\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t[1]
      \r\n\u4E3B\u89D2\uFF1A\u70BA\u4EC0\u9EBC\uFF1F\u9019\u88E1\u662F\u54EA\uFF1F\r\n\uFF1F\uFF1F\uFF1F\uFF1A\uFF1F\uFF01\u4F60\u9084\u6703\u8AAA\u8A71\uFF1F\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u7B97\u4E86\uFF0C\u9019\u4E16\u4EE3\u6703\u51FA\u73FE\u4EC0\u9EBC\u90FD\u4E0D\u7A00\u5947\u4E86\u3002\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u4F60\u8D95\u5FEB\u8D70\u5C31\u5C0D\u4E86\uFF0C\u4E0D\u8981\u554F\u90A3\u9EBC\u591A\uFF0C\u4E0D\u95DC\u4F60\u7684\u4E8B\u60C5\u3002\r\n\u4E3B\u89D2\uFF1A\u70BA\u4EC0\u9EBC\u6211\u6703\u5728\u9019\u88E1\uFF1F\u662F\u4F60\u5011\u628A\u6211\u6293\u5230\u9019\u88E1\u7684\u55CE\uFF1F\r\n\uFF1F\uFF1F\uFF1F\uFF1A\u6211\u600E\u9EBC\u6703\u77E5\u9053\u4F60\u4E00\u96BB\u9CE5\u70BA\u4EC0\u9EBC\u6703\u51FA\u73FE\u5728\u9019\u88E1\uFF1F\uFF01\u6211\u53EA\u662F\u4E00\u500B\u505A\u6253\u96DC\u7684\u5C0F\u54E1\u5DE5\u3002\r\n\u54E1\u5DE5\uFF1A\u800C\u4E14\u4F60\u597D\u597D\u7684\u68EE\u6797\u4E0D\u5F85\u8457\u8DD1\u4F86\u5BE6\u9A57\u5BA4\u88E1\u9762\uFF0C\u5C0D\u4F60\u6709\u4EC0\u9EBC\u597D\u8655\u55CE\uFF1F\uFF01\r\n\u65C1\u767D\uFF1A(\u6C92\u932F\uFF0C\u4F60\u60F3\u8D77\u4F86\u4E86\uFF0C\u4F60\u662F\u96BB\u70CF\u9D09---\u9019\u4E5F\u5F88\u660E\u986F\uFF0C\u9CE5\u7684\u5916\u89C0\uFF0C\u9ED1\u6F06\u6F06\u7684\u7FBD\u6BDB\uFF0C\u9664\u4E86\u662F\u70CF\u9D09\u4F60\u9084\u80FD\u662F\u4EC0\u9EBC\uFF1F)\r\n\u65C1\u767D\uFF1A(\u800C\u4E14\u4ED6\u8AAA\u7684\u4E5F\u6C92\u6709\u932F\uFF0C\u4E00\u96BB\u70CF\u9D09\u5C31\u61C9\u8A72\u5728\u6A39\u6797\u4E2D\u7684\u5929\u7A7A\u4E2D\u81EA\u7531\u7684\u98DB\uFF0C\u800C\u4E0D\u662F\u88AB\u56F0\u5728\u9019\u500B\u53EB\u505A\u5BE6\u9A57\u5BA4\u7684\u5730\u65B9\u3002)\r\n\u54E1\u5DE5\uFF1A\u4F60\u5FEB\u9EDE\u96E2\u958B\u5427\uFF0C\u9580\u53E3\u5C31\u5728\u90A3\u908A\u3002\r\n\u4E3B\u89D2\uFF1A\u597D\uFF0C\u6211\u77E5\u9053\u4E86\uFF0C\u8B1D\u8B1D\u4F60\u3002\r\n\u54E1\u5DE5\uFF1A\u53BB\u53BB\u53BB\uFF0C\u4E0D\u8981\u628A\u5730\u677F\u5F04\u9AD2\u4E86\uFF01\uFF01\t\r\n\u968E\u6BB503\t\u756B\u9762\t\u9032\u5165\u90FD\u5E02\u5F8C\uFF0C\u5F85\u7576\u524D\u5834\u666F\u6587\u5B57\u63D0\u793A\u7D50\u675F\u5F8C\u9032\u5165\u5C0D\u8A71\u3002\t\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u2026\u2026\r\n\u4E3B\u89D2\uFF1A\u2026\u2026\u9019\u53C8\u662F\u54EA\u88E1\uFF1F\t\r\n\u968E\u6BB504\t\u756B\u9762\t[1]
      \u8CA9\u8CE3\u6A5F\u653E\u5927\u5716\u793A\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u653E\u5927\u5716\u793A\u7684\u4E0A\u5C64\u3002\t[1]\u82E5\u73A9\u5BB6\u884C\u8D70\u904E\u7A0B\u4E2D\u767C\u73FE\u8CA9\u8CE3\u6A5F\uFF0C\u9078\u64C7\u8207\u8CA9\u8CE3\u6A5F\u4E92\u52D5\u4FBF\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u73A9\u5BB6\u8207\u8CA9\u8CE3\u6A5F\u4E92\u52D5\uFF0C\u53EF\u4EE5\u7372\u5F97\u9053\u5177\uFF1A\u4E00\u74F6\u6C34\u3002\r\n\u6C34\u7684\u63CF\u8FF0\uFF1A\u770B\u8D77\u4F86\u6709\u9EDE\u9ED1\u9ED1\u7684\uFF0C\u4E0D\u77E5\u9053\u662F\u4E0D\u662F\u4E0D\u592A\u4E7E\u6DE8\u3002\r\n[3]\u73A9\u5BB6\u4F7F\u7528\u6389\u6C34\u6703\u89F8\u767C\u5287\u60C5\uFF0C\u4E3B\u89D2\u751F\u547D\u9700\u6C42\u6578\u503C\u56DE\u5FA9\u81F3\u6EFF\u3002\r\n[4]\u6771\u897F\u6389\u4E0B\u4F86\u7684\u97F3\u6548\u3002\r\n[5]\u5982\u679C\u627E\u7684\u5230\u4E86\u8A71\uFF0C\u6703\u662F\u541E\u56A5\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u9019\u662F\u4E00\u53F0\u820A\u6587\u660E\u6642\u4EE3\u907A\u7559\u7684\u98F2\u6599\u6A5F\uFF0C\u53EF\u4EE5\u62FF\u5230\u60F3\u8981\u7684\u98F2\u54C1\u3002\uFF09\r\n\u4E3B\u89D2\uFF1A\u6B63\u597D\u6211\u6709\u9EDE\u6E34\u4E86\uFF0C\u4F86\u62FF\u4E00\u9EDE\u6C34\u5427\uFF01\r\n\u65C1\u767D\uFF1A\uFF08\u6389\u51FA\u4E86\u4E00\u74F6\u201D\u6C34\u201D\uFF09
      [2][4]\r\n\u65C1\u767D\uFF1A\u4F60\u6709\u9EDE\u6E34\u4E86\uFF0C\u8ACB\u7528\u6389\u9019\u74F6\u6C34\u3002\uFF08\u9019\u74F6\u6C34\u53EF\u4EE5\u5728\u80CC\u5305\u88E1\u627E\u5230\u3002\uFF09\r\n\u4E3B\u89D2\uFF1A\uFF08\u5927\u53E3\u559D\uFF09
      [3][5]\r\n\r\n\u4E3B\u89D2\uFF1A\u611F\u89BA\u597D\u591A\u4E86\uFF0C\u6574\u500B\u8EAB\u9AD4\u90FD\u6709\u52D5\u529B\u4E86\u3002\t\r\n\u968E\u6BB505\t\u756B\u9762\t[1]\u5C0F\u5B69\u7684\u653E\u5927\u5716\u793A\u8DF3\u51FA\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u756B\u9762\u4E0B\u65B9\uFF0C\u8986\u84CB\u5728\u5C0F\u5B69\u4E0A\u5C64\u3002\t[1]\u73A9\u5BB6\u9078\u64C7\u8207\u5C0F\u5B69\u4E92\u52D5\u5F8C\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u5C0F\u5B69\uFF1A\u54C7\uFF01\r\n\u5C0F\u5B69\uFF1A\u4F60\u662F\u4EC0\u9EBC\u6771\u897F\uFF1F\r\n\u4E3B\u89D2\uFF1A\uFF08\u662F\u5728\u8AAA\u6211\u55CE\uFF1F\uFF09\r\n\u4E3B\u89D2\uFF1A\u311C\u2026\u4F60\u597D\u2026.\u807D\u8AAA\u6211\u662F\u4E00\u96BB\u9CE5\u3002\r\n\u5C0F\u5B69\uFF1A\u597D\u9177\uFF01\u6211\u8981\u628A\u4F60\u5E36\u56DE\u5BB6\uFF01\r\n\u4E3B\u89D2\uFF1A
      \u554A\uFF1F\r\n\u4E3B\u89D2\uFF1A \u6211\u77E5\u9053\u4F60\u5F88\u6FC0\u52D5\uFF0C\u4F46\u4F60\u5148\u5225\u6FC0\u52D5\u3002\r\n\u4E3B\u89D2\uFF1A
      \u6211\u73FE\u5728\u6B63\u5728\u627E\u68EE\u6797\u7684\u8DEF\uFF0C\u4F60\u77E5\u9053\u600E\u9EBC\u8D70\u55CE\uFF1F\r\n\u5C0F\u5B69\uFF1A\u68EE\u6797\uFF1F\u6211\u6709\u807D\u8AAA\u904E\u9019\u500B\u5730\u65B9\uFF01\t\r\n\u968E\u6BB506\t\u756B\u9762\t\u7070\u8272\u534A\u900F\u660E\u906E\u7F69\u8986\u84CB\u6240\u6709\u756B\u9762\uFF0C\u660E\u4FE1\u7247\u51FA\u73FE\u4E26\u4E14\u4E0A\u9762\u756B\u8457\u68EE\u6797\u7684\u5716\u7247\u3002\t[1]\u9EDE\u9078\u7A7A\u767D\u8655\u95DC\u9589\u5F8C\u7E7C\u7E8C\u5287\u60C5\u3002
      \r\n\t\u5C0D\u8A71\t[1]\r\n\u5C0F\u5B69\uFF1A\u9019\u662F\u6211\u5728xxx\u627E\u5230\u7684\u6771\u897F\uFF0C\u807D\u8AAA\u4E0A\u9762\u9019\u500B\u5730\u65B9\u5C31\u662F\u68EE\u6797\u3002\r\n\u4E3B\u89D2\uFF1A\uFF08\u9019\u908A\u61C9\u8A72\u5C31\u662F\u6211\u4E4B\u524D\u4F4F\u7684\u5730\u65B9\u4E86\u2026\u4F46\u6211\u8981\u600E\u9EBC\u53BB\u9019\u908A\u5462\uFF1F\uFF09\r\n\u4E3B\u89D2\uFF1A\u9019\u5F35\u660E\u4FE1\u7247\u53EF\u4EE5\u7D66\u6211\u55CE\uFF1F\u6211\u5F88\u9700\u8981\u5B83\u3002\r\n\u5C0F\u5B69\uFF1A\u53EF\u4EE5\uFF0C\u4F46\u4F60\u8981\u8B93\u6211\u6478\u4E00\u4E0B\uFF01\t\r\n\u968E\u6BB507\t\u756B\u9762\t\u756B\u9762\u88AB\u9ED1\u8272\u4E0D\u660E\u7269\u9AD4\u906E\u4F4F\u5DE6\u4E0A\u65B9\u89D2\u843D\uFF0C\u906E\u4E86\u53C8\u79FB\u958B\u5169\u6B21\u5F8C\u7E7C\u7E8C\u5287\u60C5\u3002\t[1]\u53EA\u80FD\u9078\u64C7\u300C\u597D\u300D\uFF0C\u6478\u5B8C\u5F8C\u89F8\u767C\u5287\u60C5\uFF0C\u4E26\u4E14\u6703\u7372\u5F97\u4E00\u5F35\u660E\u4FE1\u7247\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u5C0F\u5B69\uFF1A\u8036\uFF01\u6211\u8981\u56DE\u53BB\u8DDF\u7238\u7238\u70AB\u8000\u6211\u9047\u5230\u4E00\u96BB\u9CE5\uFF01\t\r\n\u968E\u6BB508\t\u756B\u9762\t\u4E3B\u89D2\u7E7C\u7E8C\u5F80\u524D\u8D70\u3002[1]\t[1]\u73A9\u5BB6\u9047\u5230\u6A5F\u5668\u4EBA\uFF0C\u9078\u64C7\u8207\u6A5F\u5668\u4EBA\u4E92\u52D5\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u6771\u897F\u7838\u843D\u6216\u6389\u843D\u6216\u649E\u64CA\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u9762\u524D\u7684\u6A5F\u5668\u4EBA\u624B\u4E0A\u62FF\u8457\u5F88\u591A\u6771\u897F\u3002\uFF09\r\n\u9CE5\uFF1A\u90A3\u500B\u2026\u8ACB\u554F\u2026\uFF1F\r\n\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u7B49\u4E00\u4E0B\u2026\u54C7\u554A\u554A\u554A\uFF01\r\n\u65C1\u767D\uFF1A\uFF08\u91AB\u751F\u624B\u4E0A\u7684\u6771\u897F\u5168\u90E8\u7838\u5230\u4E86\u4F60\u8EAB\u4E0A\u3002\uFF09[2]\t\r\n\u968E\u6BB509\t\u756B\u9762\t\u77ED\u66AB\u5E7E\u6B21\u756B\u9762\u9ED1\u6697\uFF0C\u4EE5\u8868\u793A\u88AB\u7269\u54C1\u7838\u5230\u906E\u4F4F\u8996\u7DDA\u3002\t\r\n\t\u5C0D\u8A71\t\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u554A\u554A\u554A\u6211\u5F88\u62B1\u6B49\uFF0C\u4F60\u9084\u597D\u55CE\uFF1F\r\n\u65C1\u767D\uFF1A\uFF08\u4F60\u7684\u610F\u8B58\u6A21\u7CCA\u4E86\u3002\uFF09\t\r\n\u968E\u6BB510\t\u756B\u9762\t\u7728\u773C\u4E26\u4E14\u756B\u9762\u9010\u6F38\u6A21\u7CCA\uFF0C\u4E26\u4E14\u5728\u775C\u958B\u773C\u775B\u5F8C\u756B\u9762\u4F9D\u820A\u6A21\u7CCA\u3002\t[1]\u756B\u9762\u6DE1\u51FA\u8B8A\u9ED1\u3002\r\n\t\u5C0D\u8A71\t\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u6B38\u6B38\u6B38\uFF01\u5582\uFF01\r\n\u65C1\u767D\uFF1A\uFF08\u56E0\u70BA\u53D7\u5230\u649E\u64CA\uFF0C\u4F60\u660F\u4E86\u904E\u53BB\u3002\uFF09[1]\t\r\n\u968E\u6BB511\t\u756B\u9762\t\u756B\u9762\u7728\u4E86\u5169\u6B21\u773C\uFF0C\u6DE1\u5165\u5F8C\u89F8\u767C\u5287\u60C5\u3002\t[1]\u91D1\u5C6C\u6572\u64CA\u8072\u3001\u96FB\u947D\u8072\u7B49\uFF0C\u6703\u51FA\u73FE\u5728\u6A5F\u68B0\u5BE6\u9A57\u5BA4\u7684\u97F3\u6548\uFF0C\u662F\u4E00\u7A2E\u63D0\u793A\uFF0C\u63D0\u793A\u73A9\u5BB6\u4E3B\u89D2\u4F3C\u4E4E\u4E0D\u662F\u4E00\u822C\u7684\u9CE5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u4E0D\u77E5\u9053\u904E\u4E86\u591A\u4E45\uFF0C\u4F60\u5728\u4E00\u9663\u91D1\u5C6C\u6572\u64CA\u8072\u4E2D\u9192\u904E\u4F86\u3002\uFF09[1]\r\n\u4E3B\u89D2\uFF1A\u5443\u2026\u73FE\u5728\u662F\u4EC0\u9EBC\u60C5\u6CC1\uFF1F\r\n\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u62B1\u6B49\u554A\uFF01\u6211\u7E3D\u662F\u9019\u6A23\u7B28\u624B\u7B28\u8173\u7684\u2026\u2026\u4F60\u73FE\u5728\u597D\u9EDE\u4E86\u55CE\uFF1F\t\r\n\u968E\u6BB512\t\u756B\u9762\t\u6A5F\u5668\u4EBA(\u91AB\u751F)\u7684\u653E\u5927\u5716\u793A\u51FA\u73FE\u5728\u756B\u9762\u4E2D\u592E\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u5176\u4E0A\u9762\u3002\t[1]\u63D0\u793A\u73A9\u5BB6\uFF0C\u9019\u88E1\u9700\u8981\u4F7F\u7528\u660E\u4FE1\u7247\uFF0C\u5982\u679C\u4E0D\u4F7F\u7528\u5C31\u7121\u6CD5\u89F8\u767C\u63A5\u4E0B\u4F86\u7684\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u6211\u60F3\u61C9\u8A72\u662F\u597D\u591A\u4E86\u2026\u2026\u662F\u4F60\u628A\u6211\u6CBB\u597D\u7684\u55CE\uFF1F\r\n\u7B28\u62D9\u7684\u6A5F\u5668\u4EBA\uFF1A\u7B97\u662F\u5427\uFF01\u5927\u5BB6\u90FD\u53EB\u6211\u91AB\u751F\uFF0C\u9019\u9644\u8FD1\u7684\u5C45\u6C11\u90FD\u8A8D\u8B58\u6211\u3002\u4F60\u7684\u60C5\u6CC1\u4E0D\u56B4\u91CD\uFF0C\u6211\u5F88\u5FEB\u5C31\u5E6B\u4F60\u8655\u7406\u597D\u4E86\u3002\r\n\u91AB\u751F\uFF1A\u7136\u5F8C\u5462\uFF1F\u4F60\u539F\u672C\u627E\u6211\u662F\u6709\u4EC0\u9EBC\u4E8B\u60C5\u55CE\uFF1F\u6709\u4EC0\u9EBC\u6771\u897F\u8981\u7DAD\u4FEE\u55CE\uFF1F\r\n\u4E3B\u89D2\uFF1A\u7DAD\u4FEE\uFF1F\r\n\u4E3B\u89D2\uFF1A\uFF08\u600E\u9EBC\u4E0D\u662F\u300C\u91AB\u6CBB\u300D\uFF1F\u2026\u2026\u7B97\u4E86\uFF0C\u53EF\u80FD\u53EA\u662F\u53E3\u8AA4\u5427\uFF01\uFF09\r\n\u4E3B\u89D2\uFF1A\u6211\u662F\u60F3\u8981\u554F\u4F60\u8DEF\u7684\u3002\r\n\u4E3B\u89D2\uFF1A\u5982\u4F60\u6240\u898B\uFF0C\u6211\u662F\u4E00\u96BB\u9CE5\uFF0C\u4F46\u6211\u8FF7\u8DEF\u4E86\u3002\u6211\u60F3\u8981\u56DE\u68EE\u6797\uFF0C\u4F46\u6211\u4E0D\u8A18\u5F97\u68EE\u6797\u600E\u9EBC\u8D70\u3002\r\n\u4E3B\u89D2\uFF1A\u6211\u9019\u88E1\u6709\u4E00\u5F35\u660E\u4FE1\u7247\uFF0C\u53EF\u4EE5\u5E6B\u6211\u770B\u4E00\u4E0B\u9019\u662F\u54EA\u88E1\u7684\u68EE\u6797\u55CE\uFF1F[1]\t\r\n\u968E\u6BB513\t\u756B\u9762\t[1]\u660E\u4FE1\u7247\u51FA\u73FE\uFF0C\u4E26\u4E14\u6703\u8986\u84CB\u5230\u5C0D\u8A71\u6846\u4E0A\uFF0C\u80CC\u666F\u6703\u7531\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u84CB\u4F4F\u3002[2]\t[1]\u4F7F\u7528\u660E\u4FE1\u7247\u624D\u80FD\u5920\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u9EDE\u9078\u7A7A\u767D\u8655\u6703\u95DC\u6389\u660E\u4FE1\u7247\uFF0C\u4F46\u660E\u4FE1\u7247\u6703\u88AB\u4F7F\u7528\u6389\u3002\r\n[3]\u6536\u5230\u9053\u5177\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A\uFF08\u91AB\u751F\u63A5\u904E\u4F60\u7684\u660E\u4FE1\u7247\u3002\uFF09\r\n\u91AB\u751F\uFF1A\u55EF\uFF1F\u4F60\u8AAA\u9019\u662F\u4F60\u5BB6\u55CE\uFF1F\r\n\u65C1\u767D\uFF1A\uFF08\u91AB\u751F\u4F4E\u8457\u982D\uFF0C\u82E5\u6709\u6240\u601D\u3002\uFF09\r\n\u91AB\u751F\uFF1A\u55EF\u2026\u6211\u77E5\u9053\u4E86\uFF0C\u6211\u4E0D\u592A\u77E5\u9053\u68EE\u6797\u7684\u8DEF\u8981\u600E\u9EBC\u8D70\u3002\r\n\u91AB\u751F\uFF1A\u4F46\u4F60\u5F80\u524D\u4E00\u76F4\u8D70\u7684\u8A71\uFF0C\u61C9\u8A72\u6703\u9047\u5230\u4E00\u53F0\u5730\u5716\u6A5F\u5668\u4EBA\u3002\u4ED6\u77E5\u9053\u6240\u6709\u7684\u8DEF\u8A72\u600E\u9EBC\u8D70\uFF0C\u4F60\u628A\u660E\u4FE1\u7247\u7D66\u4ED6\u770B\uFF0C\u6216\u8A31\u6703\u6709\u4F60\u8981\u7684\u7B54\u6848\u3002\r\n\u91AB\u751F\uFF1A\u9084\u6709\u2026\u9019\u4E9B\u6771\u897F\u4F60\u62FF\u8457\uFF01\u5927\u6982\u662F\u4F60\u6389\u7684\u5427\uFF1F[3]\t\r\n\u968E\u6BB514\t\u756B\u9762\t\u7372\u5F97\u7684\u9053\u5177\u6703\u64FA\u6210\u4E00\u5B57\u5728\u756B\u9762\u4E0A\uFF0C\u73A9\u5BB6\u9EDE\u64CA\u5C31\u53EF\u4EE5\u62FE\u53D6\u3002[1]\t[1]\u9053\u5177\u9EDE\u64CA\u53EF\u4EE5\u62FE\u53D6\uFF0C\u9053\u5177\u672C\u8EAB\u5468\u570D\u6703\u6709\u4E00\u5708\u5149\u63D0\u793A\u662F\u53EF\u4EE5\u9EDE\u7684\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u597D\u7684\uFF0C\u8B1D\u8B1D\u4F60\uFF0C\u91AB\u751F\uFF01\r\n\u9CE5\uFF1A\uFF08\u5947\u602A\uFF0C\u9019\u5169\u584A\u91D1\u5C6C\u662F\u6211\u6389\u7684\u55CE\uFF1F\uFF09\r\n\u91AB\u751F\uFF1A\u5982\u679C\u6709\u9047\u5230\u4EC0\u9EBC\u56F0\u96E3\uFF0C\u5118\u7BA1\u4F86\u627E\u6211\u5427\uFF01\t\r\n\u968E\u6BB515\t\u756B\u9762\t\u6597\u7BF7\u602A\u5496\u5728\u756B\u9762\u4E2D\u592E\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u602A\u5496\u4E0A\u5C64\u3002\t\r\n\t\u5C0D\u8A71\t\u6597\u7BF7\u602A\u5496\uFF1A\u2026\u2026\r\n\u65C1\u767D\uFF1A\uFF08\u773C\u524D\u7684\u4EBA\u62AB\u8457\u4E00\u4EF6\u6597\u7BF7\uFF0C\u4E00\u8A00\u4E0D\u767C\u7684\u770B\u8457\u4F60\u3002\uFF09\r\n\u4E3B\u89D2\uFF1A\uFF08\u9019\u500B\u4EBA\u770B\u8D77\u4F86\u6709\u9EDE\u5947\u602A...\u9084\u662F\u4E0D\u8981\u63A5\u8FD1\u4ED6\u597D\u4E86\u3002\uFF09\t\r\n\u968E\u6BB516\t\u756B\u9762\t\u6597\u7BF7\u602A\u5496\u6703\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5982\u679C\u9078\u64C7\u300C\u518D\u5077\u770B\u4ED6\u4E00\u4E0B\u300D\u624D\u6703\u89F8\u767C\u5287\u60C5\uFF1B\u5426\u5247\u76F4\u63A5\u7D50\u675F\u4E26\u4E14\u7121\u6CD5\u518D\u9032\u5165\u5287\u60C5\u3002\t[1]\u5927\u7B11\uFF0C\u4E26\u4E14\u662F\u5632\u7B11\u610F\u5473\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u6597\u7BF7\u602A\u5496\uFF1A\u4F60\u770B\u4EC0\u9EBC\u770B\uFF1F\r\n\u4E3B\u89D2\uFF1A\uFF08\u5616\uFF0C\u614B\u5EA6\u600E\u9EBC\u9019\u9EBC\u5DEE\uFF0C\u9084\u662F\u5148\u8D70\u70BA\u5999\u5427\uFF01\uFF09\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u7B49\u4E00\u4E0B\uFF0C\u65E2\u7136\u4F60\u90FD\u505C\u4E0B\u4F86\u4E86\u2026\u2026\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u90A3\u4F60\u7D66\u6211\u9EDE\u5403\u7684\u5427\uFF0C\u6211\u5DF2\u7D93\u597D\u5E7E\u5929\u6C92\u6709\u5403\u6771\u897F\u4E86\u3002\r\n\u65C1\u767D\uFF1A\uFF08\u773C\u524D\u9019\u500B\u4EBA\u7684\u8B1B\u8A71\u8A9E\u6C23\u4F3C\u4E4E\u548C\u524D\u9762\u9047\u5230\u7684\u4EBA\u4E0D\u4E00\u6A23\uFF0C\u80FD\u5F88\u8F15\u6613\u7684\u611F\u89BA\u51FA\u4ED6\u7684\u60C5\u7DD2\u3002\uFF09\r\n\u4E3B\u89D2\uFF1A\u6211\u624D\u6C92\u7A7A\u7406\u4F60\uFF0C\u6211\u8981\u8D95\u5FEB\u56DE\u53BB\u68EE\u6797\uFF01\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u5E79\u561B\u56DE\u68EE\u6797\uFF1F\r\n\u4E3B\u89D2\uFF1A\u90A3\u88E1\u662F\u6211\u5BB6\uFF0C\u6211\u7576\u7136\u8981\u56DE\u53BB\u554A\uFF01\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u56DE\u5BB6\uFF1F\r\n\u65C1\u767D\uFF1A\uFF08\u6597\u7BF7\u602A\u5496\u4E0A\u4E0B\u6253\u91CF\u4F60\u4E00\u756A\uFF0C\u7136\u5F8C\u7A81\u7136\u958B\u59CB\u5927\u7B11\u3002\uFF09[1]\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u54C8\u54C8\u54C8\u54C8\u2026\u2026\u4F60\u7ADF\u7136\u8AAA\u8981\u56DE\u5BB6\u2026\u2026\u5BE6\u5728\u662F\u592A\u6709\u8DA3\u4E86\uFF0C\u679C\u7136\u90FD\u5E02\u88E1\u4EC0\u9EBC\u90FD\u6709\uFF01\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u4E0D\u7136\u9019\u6A23\u5427\uFF01\u6211\u770B\u4F60\u62FF\u8457\u5169\u584A\u91D1\u5C6C\uFF0C\u770B\u8D77\u4F86\u633A\u503C\u9322\u7684\u3002\u53CD\u6B63\u4F60\u4E00\u96BB\u9CE5\u4E5F\u7528\u4E0D\u8457\uFF0C\u4E0D\u5982\u8B93\u6211\u62FF\u53BB\u8CE3\u4E86\u63DB\u9EDE\u9322\u3002\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u6211\u6703\u7D66\u4F60\u597D\u6771\u897F\u7684\uFF0C\u7D55\u5C0D\u4E0D\u6703\u8667\u5F85\u4F60\uFF01\r\n\u4E3B\u89D2\uFF1A\uFF08\u4ED6\u5230\u5E95\u662F\u4EC0\u9EBC\u610F\u601D\u2026\u6211\u8981\u7D66\u4ED6\u55CE\uFF1F\uFF09\t\r\n\u968E\u6BB517\t\u756B\u9762\t\u6597\u7BF7\u602A\u5496\u5728\u756B\u9762\u4E2D\u592E\uFF0C\u5C0D\u8A71\u6846\u6703\u8986\u84CB\u5728\u602A\u5496\u4E0A\u5C64\u3002\t[1]\u9078\u64C7\u300C\u7D66\u300D\u89F8\u767C\u968E\u6BB517\u5287\u60C5\uFF0C\u6703\u5931\u53BB\u4E00\u500B\u91D1\u5C6C\u652F\u67B6\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\u597D\u5427\uFF01\u9019\u500B\u652F\u67B6\u7D66\u4F60\u3002\u6211\u7D66\u4F60\u4E86\uFF0C\u90A3\u4F60\u80FD\u7D66\u6211\u4EC0\u9EBC\uFF1F\r\n\u6597\u7BF7\u602A\u5496\uFF1A\u563F\u563F\u563F\u2026\u2026\u9019\u500B\u4F60\u62FF\u8457\u5427\uFF01\u7B49\u4F60\u771F\u7684\u5230\u4E86\u68EE\u6797\u4E4B\u5F8C\u6703\u6D3E\u4E0A\u7528\u5834\u7684\u2026\u2026\t\r\n\u968E\u6BB518\t\u756B\u9762\t\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u906E\u64CB\u4F4F\u6240\u6709\u7269\u4EF6\uFF0C\u5716\u9A30\u6703\u8986\u84CB\u5728\u756B\u9762\u4E2D\u592E\u3001\u906E\u7F69\u4E4B\u4E0A\uFF0C\u9EDE\u64CA\u7A7A\u767D\u8655\u53EF\u4EE5\u95DC\u9589\u3002\t[1]\u7372\u5F97\u9053\u5177\uFF1A\u5947\u602A\u7684\u5716\u9A30\u3002\r\n\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\uFF08\u4EC0\u9EBC\u561B\u2026\u7D66\u4E86\u4E00\u500B\u4E0D\u77E5\u9053\u4EC0\u9EBC\u7684\u6771\u897F\u2026\u9084\u662F\u5FEB\u8D70\u5427\uFF01\uFF09\t\r\n\u968E\u6BB519\t\u756B\u9762\t\u5C0D\u8A71\u6846\u4F4D\u65BC\u756B\u9762\u4E0B\u65B9\u3002\t[1]\u4E0D\u6703\u767C\u751F\u4EFB\u4F55\u4E8B\u3002\r\n[2]\u51B7\u7B11\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\u6211\u624D\u4E0D\u8981\u7D66\u4F60\uFF0C\u6211\u8981\u8D70\u4E86\uFF01\r\n\u6597\u7BF7\u602A\u5496\uFF1A[2]\u90A3\u4F60\u53EF\u5225\u5F8C\u6094\u2026\u2026\t\r\n\u968E\u6BB520\t\u756B\u9762\t[1]\u6A5F\u5668\u4EBA\u653E\u5927\u5716\u793A\u4F4D\u65BC\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5C0D\u8A71\u6846\u4F4D\u65BC\u756B\u9762\u4E0B\u65B9\u4E14\u6703\u8986\u84CB\u5728\u6A5F\u5668\u4EBA\u4E0A\u5C64\u3002\t[1]\u8207\u6A5F\u5668\u4EBA\u4E92\u52D5\u624D\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u9019\u61C9\u8A72\u5C31\u662F\u91AB\u751F\u8AAA\u7684\u5730\u5716\u6A5F\u5668\u4EBA\u4E86\u2026\u2026\uFF1F\r\n\u6A5F\u5668\u4EBA\uFF1A\u55F6\u55F6\u2026\u60A8\u4ECA\u5929\u60F3\u53BB\u54EA\u88E1\uFF1F\t\r\n\u968E\u6BB521\t\u756B\u9762\t[1]\u660E\u4FE1\u7247\u653E\u5927\u5716\u793A\u4F4D\u65BC\u6B63\u4E2D\u592E\uFF0C\u6383\u63CF\u7D05\u7DDA\u6703\u6383\u904E\u660E\u4FE1\u7247\uFF0C\u63A5\u8457\u660E\u4FE1\u7247\u6D88\u5931\u4E26\u89F8\u767C\u5C0D\u8A71\u3002\t[1]\u4F7F\u7528\u660E\u4FE1\u7247\u5F8C\u89F8\u767C(\u5982\u672A\u62FF\u5230\u660E\u4FE1\u7247\u6703\u7121\u6CD5\u89F8\u767C\u5287\u60C5)\u3002\r\n[2]\u55F6\u55F6\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u6A5F\u5668\u4EBA\uFF1A\u8FA8\u8B58\u4E2D\u2026\u2026[2]\r\n\u6A5F\u5668\u4EBA\uFF1A\u60A8\u8981\u524D\u5F80\u7684\u5730\u65B9\u70BA\u68EE\u6797\uFF0C\u5C1A\u672A\u958B\u767C\uFF0C\u6709\u4E00\u5B9A\u7A0B\u5EA6\u5371\u96AA\u3002\r\n\u6A5F\u5668\u4EBA\uFF1A\u82E5\u8981\u524D\u5F80\u68EE\u6797\uFF0C\u8ACB\u7E7C\u7E8C\u5F80\u524D\u884C\uFF0C\u518D\u7A7F\u8D8A\u6C99\u6F20\u5F8C\u5373\u53EF\u62B5\u9054\u3002\r\n\u9CE5\uFF1A(\u6C99\u6F20\u53C8\u662F\u4EC0\u9EBC\u5730\u65B9\uFF1F\u6211\u53EA\u60F3\u8D95\u5FEB\u56DE\u5BB6\u3002)\r\n\u9CE5\uFF1A\u6211\u77E5\u9053\u4E86\uFF0C\u8B1D\u8B1D\u4F60\uFF01\t\r\n\u968E\u6BB522\t\u756B\u9762\t\u5834\u666F\u63D0\u793A\u6587\u5B57\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u80CC\u666F\u662F\u9ED1\u8272\u906E\u7F69\u906E\u4F4F\u6574\u500B\u756B\u9762\uFF0C\u6587\u5B57\u9583\u720D\u5F8C\u6D88\u5931\uFF0C\u7ACB\u523B\u89F8\u767C\u5287\u60C5\u3002\t\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u539F\u4F86\u9019\u908A\u5C31\u662F\u6C99\u6F20\u963F\uFF01\r\n\u65C1\u767D\uFF1A(\u4F60\u653E\u773C\u671B\u53BB\uFF0C\u53EA\u6709\u4E00\u7247\u7684\u6C99\u4E18\u3002)\r\n\u65C1\u767D\uFF1A(\u6C99\u5B50\uFF0C\u6C99\u5B50\uFF0C\u9084\u662F\u7121\u804A\u7684\u6C99\u5B50\u3002\u9019\u8DDF\u4F60\u7684\u5BB6\u5712\u7DA0\u610F\u76CE\u7136\u7684\u6A23\u5B50\u53EF\u4EE5\u8AAA\u662F\u5DEE\u591A\u4E86\u3002)\r\n\u4E3B\u89D2\uFF1A\u9019\u908A\u771F\u7684\u6703\u6709\u751F\u7269\u55CE\u2026\u2026?\t\r\n\u968E\u6BB523\t\u756B\u9762\t\u6A5F\u5668\u4EBA\u653E\u5927\u5716\u793A\u51FA\u73FE\u5728\u756B\u9762\u4E2D\u592E\u3002[1]\t[1]\u8207\u6A5F\u5668\u4EBA\u4E92\u52D5\u5F8C\u89F8\u767C\u5C0D\u8A71\u3002\r\n[2]\u756B\u9762\u6416\u6643\u9707\u52D5\u3002\r\n[3]\u9019\u908A\u5728\u63D0\u793A\u73A9\u5BB6\uFF0C\u4E3B\u89D2\u662F\u6A5F\u5668\u4EBA\u7684\u540C\u4F34\uFF0C\u4E5F\u5C31\u4EE3\u8868\u4E3B\u89D2\u4E5F\u662F\u6A5F\u5668\u4EBA\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u770B\u8457\u773C\u524D\u4E0D\u52D5\u7684\u6A5F\u5668\u4EBA\uFF0C\u9084\u5728\u601D\u8003\u70BA\u4EC0\u9EBC\u6703\u51FA\u73FE\u5728\u9019\u88E1\u3002)\r\n\u6A5F\u5668\u4EBA\uFF1A@#/?%%@!\r\n\u4E3B\u89D2\uFF1A\u55DA\u54C7\u554A\u554A\u554A\u554A\uFF01[2]\r\n\u65C1\u767D\uFF1A(\u4F60\u88AB\u7A81\u7136\u9192\u4F86\u7684\u6A5F\u5668\u4EBA\u5687\u4E86\u4E00\u5927\u8DF3\u3002)\r\n\u6A5F\u5668\u4EBA\uFF1A\u62B1\u6B49\u963F\uFF01\u6211\u525B\u525B\u7A81\u7136\u7576\u6A5F\u4E86\u4E00\u4E0B\uFF0C\u4E0D\u662F\u8981\u6545\u610F\u5687\u4F60\u7684\u3002\r\n\u4E3B\u89D2\uFF1A\u662F\u6C92\u95DC\u4FC2\uFF0C\u4F46\u70BA\u4EC0\u9EBC\u6A5F\u5668\u4EBA\u6703\u51FA\u73FE\u5728\u9019\u88E1\uFF1F\r\n\u6A5F\u5668\u4EBA\uFF1A\u5C31\u50CF\u4F60\u70BA\u4EC0\u9EBC\u6703\u51FA\u73FE\u5728\u9019\u88E1\u7684\u539F\u56E0\u4E00\u6A23\uFF0C\u6211\u7684\u670B\u53CB\u3002\r\n\u6A5F\u5668\u4EBA\uFF1A\u73FE\u5728\u79D1\u6280\u5DF2\u7D93\u975E\u5E38\u767C\u9054\u4E86\uFF0C\u5230\u54EA\u88E1\u90FD\u6709\u6211\u5011\u7684\u540C\u4F34\u3002\u771F\u662F\u7F8E\u597D\uFF01[3]\t\r\n\u968E\u6BB524\t\u756B\u9762\t\u99F1\u99DD\u653E\u5927\u5716\u793A\u986F\u793A\u5728\u756B\u9762\u6B63\u4E2D\u592E[1]\u3002\t[1]\u5982\u679C\u627E\u7684\u5230\u4E86\u8A71\uFF0C\u6703\u6709\u99F1\u99DD\u53EB\u8072\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u5F9E\u4F86\u6C92\u770B\u904E\u9019\u9EBC\u5947\u602A\u7684\u751F\u7269\u3002)\r\n\u65C1\u767D\uFF1A(\u56DB\u96BB\u8173\uFF0C\u9577\u9577\u7684\u8116\u5B50\uFF0C\u80CC\u4E0A\u9084\u6709\u51F8\u8D77\u4F86\u7684\u5C71\u4E18-\u4E0D\u7BA1\u54EA\u9EDE\u5C0D\u4F60\u4F86\u8AAA\u770B\u8D77\u4F86\u90FD\u592A\u53E4\u602A\u4E86\u3002)\r\n\u99F1\u99DD\uFF1A\u5594\uFF1F\u4F60\u9019\u662F\u4EC0\u9EBC\u52D5\u7269\uFF0C\u9577\u7684\u9084\u771F\u5947\u602A\u3002\r\n\u4E3B\u89D2\uFF1A\u6211\u624D\u89BA\u5F97\u4F60\u5947\u602A\u5462\uFF01\u4F60\u7684\u80CC\u4E0A\u600E\u9EBC\u6703\u6709\u5169\u500B\u5C0F\u5C71\u4E18\uFF1F\r\n\u99F1\u99DD\uFF1A\u539F\u4F86\u5982\u6B64\uFF0C\u6211\u61C2\u4E86\u3002\u4F60\u4E0D\u662F\u9019\u88E1\u7684\u5C45\u6C11\u3002\r\n\u99F1\u99DD\uFF1A\u6211\u662F\u96BB\u99F1\u99DD\uFF0C\u80CC\u4E0A\u7684\u7684\u5C0F\u5C71\u4E18\u662F\u6211\u5E73\u5E38\u5132\u5B58\u6C34\u7684\u5730\u65B9\u3002\u5728\u9019\u6C99\u6F20\u751F\u5B58\u53EF\u4E0D\u80FD\u6C92\u6709\u6C34\u5462\uFF01\r\n\u4E3B\u89D2\uFF1A(\u9019\u96BB\u99F1\u99DD\u610F\u5916\u7684\u5F88\u6709\u79AE\u8C8C\uFF1F)\r\n\u4E3B\u89D2\uFF1A\u6211\u77E5\u9053\u4E86\uFF0C\u8B1D\u8B1D\u4F60\u7684\u5FE0\u544A\u3002\u6211\u662F\u4E00\u96BB\u9CE5\uFF0C\u73FE\u5728\u6B63\u5728\u627E\u56DE\u5230\u68EE\u6797\u7684\u8DEF\u3002\u4F60\u77E5\u9053\u8981\u600E\u9EBC\u8D70\u55CE\uFF1F\r\n\u99F1\u99DD\uFF1A\u68EE\u6797\uFF1F\u6211\u6C92\u6709\u807D\u8AAA\u904E\uFF0C\u62B1\u6B49\u5E6B\u4E0D\u4E0A\u4F60\u7684\u5FD9\u3002\r\n\u99F1\u99DD\uFF1A\u4F46\u662F\u76F8\u9022\u5C31\u662F\u6709\u7DE3\uFF0C\u9019\u74F6\u6C34\u7D66\u4F60\u5427\uFF01\t\r\n\u968E\u6BB525\t\u756B\u9762\t\u4E00\u74F6\u6C34\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5176\u9918\u756B\u9762\u6703\u88AB\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u906E\u4F4F\u3002[1]\t[1]\u9EDE\u64CA\u6C34\u6703\u6D88\u5931\uFF0C\u4E26\u4E14\u5728\u756B\u9762\u4E0B\u65B9\u51FA\u73FE\u300C\u7372\u5F97\u9053\u5177\uFF1A\u4E00\u74F6\u6C34\u300D\u7684\u63D0\u793A\u6587\u5B57\u3002\r\n\t\u5C0D\u8A71\t\u99F1\u99DD\uFF1A\u53E6\u5916\uFF0C\u6C99\u6F20\u7684\u591C\u665A\u53EF\u662F\u975E\u5E38\u5BD2\u51B7\u7684\uFF0C\u9019\u689D\u570D\u5DFE\u4F60\u4E5F\u62FF\u8457\u5427\uFF01\u4FDD\u6696\u53EF\u662F\u975E\u5E38\u91CD\u8981\u3002\r\n\u99F1\u99DD\uFF1A\u5E0C\u671B\u4F60\u53EF\u4EE5\u627E\u5230\u56DE\u5BB6\u7684\u8DEF\uFF0C\u6211\u7684\u670B\u53CB\uFF01\t\r\n\u968E\u6BB526\t\u756B\u9762\t\u4E00\u689D\u570D\u5DFE\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5176\u9918\u756B\u9762\u6703\u88AB\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u906E\u4F4F\u3002[1][2]\t[1]
      \u9EDE\u64CA\u570D\u5DFE\u6703\u6D88\u5931\uFF0C\u4E26\u4E14\u5728\u756B\u9762\u4E0B\u65B9\u51FA\u73FE\u300C\u7372\u5F97\u9053\u5177\uFF1A\u4E00\u689D\u570D\u5DFE\u300D\u7684\u63D0\u793A\u6587\u5B57\u3002\r\n[2]\u5F37\u5236\u4F7F\u7528\u570D\u5DFE\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A(\u5BD2\u51B7\uFF1F\u6211\u600E\u9EBC\u6C92\u6709\u611F\u89BA\uFF1F\u800C\u4E14\u9019\u570D\u5DFE\u597D\u5F71\u97FF\u98DB\u884C\u3002)\r\n\u4E3B\u89D2\uFF1A(\u5927\u6982\u662F\u56E0\u70BA\u6211\u7FBD\u6BDB\u6BD4\u8F03\u591A\u624D\u4E0D\u6703\u51B7\u3002\u96D6\u7136\u5F88\u5C0D\u4E0D\u8D77\u99F1\u99DD\uFF0C\u4F46\u9084\u662F\u628A\u570D\u5DFE\u62FF\u4E0B\u4F86\u5427\uFF01)\t\r\n\u968E\u6BB527\t\u756B\u9762\t\u4E00\u96BB\u86C7\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\u3002[1]\t[1]\u86C7\u7684\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u770B\u5230\u4E86\u4E00\u689D\u86C7\u3002)\r\n\u65C1\u767D\uFF1A(\u96D6\u7136\u90FD\u8AAA\u4E0D\u80FD\u4EE5\u8C8C\u53D6\u4EBA\uFF0C\u4F46\u7260\u770B\u8D77\u4F86\u5BE6\u5728\u662F\u592A\u72E1\u733E\u4E86)\r\n\u65C1\u767D\uFF1A(\u5C24\u5176\u662F\u5728\u4F60\u7684\u8A18\u61B6\u4E2D\uFF0C\u4F60\u9084\u807D\u8AAA\u904E\u6709\u4E9B\u86C7\u6703\u6355\u98DF\u9CE5\u985E\u2500\u2500\u5C0D\u65BC\u4E00\u96BB\u60F3\u56DE\u5BB6\u7684\u9CE5\u4F86\u8AAA\uFF0C\u9019\u53EF\u4E0D\u662F\u4F60\u60F3\u767C\u751F\u7684\u4E8B\u60C5\u3002)\t\r\n\u968E\u6BB528\t\u756B\u9762\t\u9078\u64C7\u5F8C\u89F8\u767C\u5C0D\u8A71\u3002[1]\t[1]\u9078\u64C7\u8207\u86C7\u5C0D\u8A71\u6703\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u51FA\u73FE\u9078\u9805\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u4F60\u2026\u4F60\u597D\uFF1F\r\n\u86C7\uFF1A\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u9019\u96BB\u86C7\u5C31\u53EA\u662F\u4E00\u76F4\u770B\u8457\u4F60\uFF0C\u4E00\u53E5\u8A71\u4E5F\u6C92\u6709\u8AAA\u3002)\r\n\u4E3B\u89D2\uFF1A(\u55DA\u54C7\u2026\u4ED6\u771F\u7684\u6709\u5920\u602A\u7684\uFF0C\u65E9\u77E5\u9053\u5C31\u4E0D\u7406\u4ED6\u4E86\u3002)\r\n\u86C7\uFF1A\u4F60\u6709\u6C34\u55CE\uFF1F\r\n\u4E3B\u89D2\uFF1A\u4EC0\u9EBC\uFF1F\r\n\u86C7\uFF1A\u4F60\u807D\u5230\u4E86\uFF0C\u6211\u9700\u8981\u4E00\u9EDE\u6C34\u3002\u4F5C\u70BA\u4EA4\u63DB\uFF0C\u6211\u6703\u7D66\u4F60\u4E00\u4E9B\u597D\u6771\u897F\u7684\u3002\r\n\u4E3B\u89D2\uFF1A\u600E\u9EBC\u8FA6\u2026\u8981\u7D66\u4ED6\u55CE\uFF1F[2]\t\r\n\u968E\u6BB529\t\u756B\u9762\t\u86C7\u51FA\u73FE\u5728\u6B63\u4E2D\u592E\u3002\t[1]\u9078\u64C7\u4E0D\u7D66\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\u6211\u6C92\u6709\u6C34\uFF0C\u62B1\u6B49\u3002\r\n\u65C1\u767D\uFF1A(\u4F60\u5FEB\u901F\u5730\u9060\u96E2\u86C7\u4E86\uFF0C\u4F46\u9019\u6A23\u771F\u7684\u597D\u55CE\uFF1F)\t\r\n\u968E\u6BB530\t\u756B\u9762\t\u9078\u64C7\u8207\u86C7\u4E92\u52D5\uFF0C\u518D\u4F7F\u7528\u6C34\u6703\u89F8\u767C\u5287\u60C5\u3002\t[1]\u9078\u64C7\u7D66\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t[1]\r\n\u4E3B\u89D2\uFF1A\u597D\u5427\uFF0C\u4F46\u4F60\u53EA\u80FD\u559D\u4E00\u9EDE\u9EDE\u5594\uFF01\r\n\u86C7\uFF1A\u597D\u5566\u597D\u5566\uFF0C\u5FEB\u7D66\u6211\u5427\uFF0C\u6211\u5FEB\u6E34\u6B7B\u4E86\u3002\t\r\n\u968E\u6BB531\t\u756B\u9762\t\u9078\u64C7\u8207\u86C7\u4E92\u52D5\uFF0C\u518D\u4F7F\u7528\u6C34\u6703\u89F8\u767C\u5287\u60C5\u3002\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u628A\u6C34\u7D66\u4E86\u86C7\u3002)\r\n\u86C7\uFF1A\u592A\u597D\u4E86\uFF0C\u5728\u9019\u908A\u597D\u4E45\u90FD\u6C92\u559D\u5230\u6C34\u4E86\uFF01\u8B93\u6211\u4F86\u2026.\u54B3\u54B3\u2026\u6B38\uFF01\r\n\u65C1\u767D\uFF1A(\u86C7\u628A\u6C34\u5410\u4E86\u4E00\u5730\uFF0C\u74F6\u5B50\u88E1\u9762\u4E5F\u4E00\u6EF4\u4E0D\u5269\u4E86\u3002)\r\n\u86C7\uFF1A\u4F60\u9019\u54EA\u662F\u4EC0\u9EBC\u6C34\u554A\uFF01\u4F60\u5206\u660E\u662F\u60F3\u5BB3\u6B7B\u8001\u5B50\uFF01\r\n\u65C1\u767D\uFF1A(\u86C7\u8AAA\u5B8C\u5C31\u4E00\u6E9C\u7159\u8DD1\u8D70\u4E86\uFF0C\u8AAA\u597D\u8981\u7D66\u4F60\u7684\u597D\u6771\u897F\u4E5F\u6C92\u6709\u7D66\u4F60\u3002\u539F\u4F86\u4ED6\u771F\u7684\u5F88\u72E1\u733E\u3002)\r\n\u4E3B\u89D2\uFF1A\u4EC0\u9EBC\u561B\u2026\u65E9\u77E5\u9053\u4E0D\u8981\u7576\u597D\u4EBA\u4E86\u2026\t\r\n\u968E\u6BB532\t\u756B\u9762\t\u9078\u64C7\u8207\u99F1\u99DD\u4E92\u52D5\uFF0C\u6703\u89F8\u767C\u5287\u60C5\u3002\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4E0D\u77E5\u9053\u70BA\u4EC0\u9EBC\uFF0C\u4F60\u77E5\u9053\u9019\u662F\u4E00\u96BB\u9D15\u9CE5\u2500\u2500\u5373\u4F7F\u4ED6\u9577\u5F97\u8DDF\u4F60\u4E00\u9EDE\u95DC\u4FC2\u90FD\u6C92\u6709\uFF0C\u9019\u6A23\u4ED6\u9084\u80FD\u53EB\u505A\u4E00\u96BB\u9CE5\u55CE\uFF1F)\r\n\u65C1\u767D\uFF1A(\u4F46\u4F60\u7BA1\u4E0D\u4E86\u90A3\u9EBC\u591A\u4E86\uFF0C\u6B64\u6642\u6B64\u523B\u4F60\u53EA\u60F3\u5FEB\u9EDE\u96E2\u958B\u9019\u500B\u9B3C\u5730\u65B9\u3002)\r\n\u9D15\u9CE5\uFF1A\u6B38\u2026\u4F60\u662F\uFF1F\r\n\u65C1\u767D\uFF1A(\u4F60\u4E0D\u60F3\u7406\u4ED6\uFF0C\u4F46\u4E00\u5207\u90FD\u4F86\u4E0D\u53CA\u4E86\u3002\u9019\u96BB\u300C\u9CE5\u300D\u5BE6\u5728\u662F\u592A\u71B1\u60C5\u4E86\uFF0C\u4F60\u53EA\u80FD\u5E0C\u671B\u4ED6\u4E0D\u6703\u518D\u9A19\u8D70\u4F60\u4EC0\u9EBC\u6771\u897F\u3002)\r\n\u4E3B\u89D2\uFF1A\u5148\u8AAA\u597D\uFF0C\u6211\u53EF\u4E0D\u6703\u7D66\u4F60\u4EC0\u9EBC\u6771\u897F\uFF01\r\n\u9D15\u9CE5\uFF1AWo
      Wo Wo\uFF0C\u4F60\u5148\u51B7\u975C\u9EDE\u6211\u7684\u670B\u53CB\uFF0C\u6211\u4E26\u6C92\u6709\u4EC0\u9EBC\u60E1\u610F\u3002\u53EF\u4EE5\u8DDF\u6211\u8B1B\u767C\u751F\u4EC0\u9EBC\u4E8B\u60C5\u4E86\u55CE\uFF1F\u4F60\u770B\u8D77\u4F86\u5FC3\u4E8B\u91CD\u91CD\u7684\u3002\r\n\u65C1\u767D\uFF1A(\u4F60\u628A\u525B\u525B\u767C\u751F\u7684\u4E8B\u60C5\u90FD\u8DDF\u4ED6\u8AAA\u4E86\uFF0C\u5305\u542B\u4F60\u8981\u56DE\u5BB6\u7684\u4E8B\u60C5\u3002)\r\n\u9D15\u9CE5\uFF1A\u539F\u4F86\u5982\u6B64\uFF0C\u90A3\u53EF\u771F\u662F\u59D4\u5C48\u4F60\u4E86\u3002\r\n\u9D15\u9CE5\uFF1A\u4E0D\u7136\u9019\u6A23\u5427\uFF01\u6211\u65C1\u908A\u525B\u597D\u662F\u4E00\u7247\u7DA0\u6D32\uFF0C\u6211\u5E6B\u4F60\u88DD\u9EDE\u6C34\u5427\uFF01\u5E0C\u671B\u4F60\u56DE\u5BB6\u7684\u8DEF\u7A0B\u9806\u5229\uFF01\t\r\n\u968E\u6BB533\t\u756B\u9762\t\u4E00\u74F6\u6C34\u51FA\u73FE\u5728\u756B\u9762\u6B63\u4E2D\u592E\uFF0C\u5176\u9918\u756B\u9762\u6703\u88AB\u9ED1\u8272\u534A\u900F\u660E\u906E\u7F69\u906E\u4F4F\u3002[1]\t[1]\u9EDE\u64CA\u6C34\u6703\u6D88\u5931\uFF0C\u4E26\u4E14\u5728\u756B\u9762\u4E0B\u65B9\u51FA\u73FE\u300C\u7372\u5F97\u9053\u5177\uFF1A\u4E00\u74F6\u6C34\u300D\u7684\u63D0\u793A\u6587\u5B57\u3002\r\n\t\u5C0D\u8A71\t\u9D15\u9CE5\uFF1A\u5C31\u9019\u6A23\u5427\uFF0C\u90A3\u6211\u5148\u8D70\u4E86\uFF01\r\n\u4E3B\u89D2\uFF1A(\u96D6\u7136\u5F88\u8B1D\u8B1D\u4ED6\uFF0C\u4E0D\u904E\u600E\u9EBC\u611F\u89BA\u4ED6\u7D66\u6211\u7684\u6C34\u559D\u8D77\u4F86\u6709\u9EDE\u4E0D\u592A\u4E00\u6A23\u2026)\t\r\n\u968E\u6BB534\t\u756B\u9762\t\u98F2\u6599\u6A5F\u653E\u5927\u5716\u793A\u3002[1]\t[1]\u9078\u64C7\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u6C34\u5566\uFF0C\u6709\u98F2\u6599\u6A5F\uFF01\r\n\u65C1\u767D\uFF1A(\u4F60\u4ED4\u7D30\u89C0\u5BDF\u4E4B\u5F8C\u767C\u73FE\uFF0C\u9019\u53F0\u6599\u6A5F\u4F3C\u4E4E\u6709\u9EDE\u6545\u969C\u3002)\r\n\u4E3B\u89D2\uFF1A\u4ED6\u597D\u50CF\u6709\u9EDE\u58DE\u6389\u4E86\uFF0C\u600E\u9EBC\u8FA6\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u4F60\u7A81\u7136\u60F3\u8D77\u4F86\u91AB\u751F\u7D66\u4F60\u7684\u96F6\u4EF6\uFF0C\u6216\u8A31\u53EF\u4EE5\u6D3E\u4E0A\u7528\u5834)\t\r\n\u968E\u6BB535\t\u756B\u9762\t\u8CA9\u8CE3\u6A5F\u8B8A\u56DE\u4FEE\u597D\u7684\u6A21\u6A23\u3002\t[1]\u9078\u64C7\u4F7F\u7528\u96F6\u4EF6\uFF0C\u4E26\u4E14\u5177\u6709\u91D1\u5C6C\u652F\u67B6\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u592A\u597D\u4E86\uFF01\u5E78\u597D\u7576\u521D\u6C92\u6709\u7D66\u90A3\u500B\u602A\u4EBA\u96F6\u4EF6\uFF0C\u770B\u4F86\u9084\u662F\u6709\u597D\u4E8B\u60C5\u767C\u751F\u7684\uFF01\t\r\n\u968E\u6BB536\t\u756B\u9762\t\u8CA9\u8CE3\u6A5F\u9084\u662F\u58DE\u6389\u7684\u6A23\u5B50\u3002\t[1]
      \u9078\u64C7\u4F7F\u7528\u96F6\u4EF6\uFF0C\u4E26\u4E14\u4E0D\u5177\u6709\u91D1\u5C6C\u652F\u67B6\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u4E3B\u89D2\uFF1A\u5509\u2026\u2026\u6211\u600E\u9EBC\u8001\u662F\u505A\u51FA\u932F\u8AA4\u7684\u9078\u64C7\u2026\u2026\t\r\n\u968E\u6BB537\t\u756B\u9762\t\u9032\u5165\u68EE\u6797\u5F8C\u51FA\u73FE\u9ED1\u8272\u906E\u7F69\uFF0C\u4E2D\u592E\u6709\u6587\u5B57\u9583\u720D\uFF0C\u4E09\u79D2\u5F8C\u6703\u6D88\u5931\u3002[1]\t[1]\u6587\u5B57\u6D88\u5931\u5F8C\u81EA\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u5728\u7A7F\u8D8A\u4E86\u6574\u500B\u6C99\u6F20\u4E4B\u5F8C\uFF0C\u5728\u4F60\u773C\u524D\u51FA\u73FE\u7684\u662F\u4E00\u7247\u7DA0\u610F\u76CE\u7136\uFF0C\u5145\u6EFF\u751F\u6A5F\u7684\u5730\u65B9\uFF09\r\n\u4E3B\u89D2\uFF1A\u9019\u88E1\u5C31\u662F\u68EE\u6797\u4E86\u55CE\uFF0C\u7D42\u65BC\u56DE\u5230\u5BB6\u4E86\uFF01\r\n\u4E3B\u89D2\uFF1A\u592A\u597D\u4E86\uFF0C\u9019\u88E1\u8DDF\u8A18\u61B6\u4E2D\u770B\u8D77\u4F86\u5DEE\u4E0D\u2026\u2026\r\n\u4E3B\u89D2\uFF1A\u8A18\u61B6\u4E2D\u2026\u2026\uFF1F\t\r\n\u968E\u6BB538\t\u756B\u9762\t[1]\t[1]\u8207\u72FC\u4E92\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u773C\u524D\u7684\u72FC\u66AE\u6C23\u6C89\u6C89\u7684\u6A21\u6A23\uFF0C\u5F77\u5F7F\u88AB\u4EC0\u9EBC\u7D66\u675F\u7E1B\u4F4F\u7684\u6A23\u5B50\u3002)\r\n\u4E3B\u89D2\uFF1A\u4E0D\u597D\u610F\u601D\u2026\u2026\u60F3\u8ACB\u554F\u4E00\u4E0B\uFF0C\u9019\u88E1\u662F\u68EE\u6797\u55CE\uFF1F\r\n\u65C1\u767D\uFF1A(\u773C\u524D\u7684\u72FC\u53EA\u662F\u773C\u795E\u7280\u5229\u7684\u770B\u8457\u4F60\u2500\u2500\u4F60\u80FD\u5F9E\u4ED6\u7684\u773C\u775B\u88E1\u770B\u51FA\u4ED6\u90A3\u4E9B\u66FE\u7D93\u98A8\u5149\u7684\u65E5\u5B50\uFF0C\u4F46\u7D42\u7A76\u62B5\u64CB\u4E0D\u904E\u6B72\u6708\u7684\u6D41\u901D\u3002)\r\n\u72FC\uFF1A\u4F60\u662F\u8AB0\uFF1F\r\n\u4E3B\u89D2\uFF1A\u6211\u662F\u4E00\u96BB\u70CF\u9D09\uFF0C\u6211\u5F9E\u57CE\u5E02\u4F86\u5230\u9019\u88E1\uFF0C\u662F\u70BA\u4E86\u627E\u5230\u6211\u7684\u5BB6\u9109\u8DDF\u5BB6\u4EBA\u3002\r\n\u72FC\uFF1A\u5BB6\u963F\u2026\u2026\u8A71\u8AAA\u6211\u7684\u5169\u500B\u5152\u5B50\u4E5F\u51FA\u9580\u597D\u4E45\u4E86\u2026\u2026\r\n\u72FC\uFF1A\u4F60\u6C92\u4F86\u932F\u5730\u65B9\uFF0C\u9019\u88E1\u5C31\u662F\u68EE\u6797\u3002\u4F46\u6211\u4E0D\u6E05\u695A\u4F60\u7684\u5925\u4F34\u5728\u54EA\u88E1\uFF0C\u6211\u53EA\u80FD\u5E6B\u4F60\u5230\u9019\u88E1\u4E86\u3002\r\n\u65C1\u767D\uFF1A(\u525B\u525B\u767C\u751F\u7684\u4E00\u9023\u4E32\u4E8B\u60C5\uFF0C\u5C0E\u81F4\u4F60\u73FE\u5728\u5C0D\u65BC\u6BCF\u500B\u4EBA\u90FD\u4E0D\u662F\u5F88\u4FE1\u4EFB\u3002)\r\n\u4E3B\u89D2\uFF1A\u90A3\u500B\u2026\u2026\u4F60\u78BA\u5B9A\u55CE\uFF1F\u7576\u7136\u4E0D\u662F\u8981\u61F7\u7591\u4F60\u5566\u2026\u2026\u54C8\u54C8\u54C8\u2026\u2026\r\n\u72FC\uFF1A\u4F60\u662F\u5728\u61F7\u7591\u6211\uFF1F\u6211\u6700\u8A0E\u53AD\u9A19\u5B50\u4E86\uFF0C\u600E\u9EBC\u9084\u6703\u9A19\u4F60\u3002\r\n\u65C1\u767D\uFF1A(\u5F9E\u4ED6\u7684\u8A9E\u6C23\u53CA\u773C\u795E\u88E1\u4F60\u611F\u53D7\u5230\u4ED6\u5728\u904E\u53BB\u53EF\u80FD\u767C\u751F\u4E86\u4EC0\u9EBC\u4E8B\u60C5\uFF0C\u624D\u4F7F\u4ED6\u5C0D\u65BC\u6B3A\u9A19\u8005\u7121\u6CD5\u5BB9\u5FCD\u3002)\r\n\u65C1\u767D\uFF1A(\u4F46\u4F60\u5BE6\u5728\u662F\u7BA1\u4E0D\u8457\u90A3\u9EBC\u591A\u4E86\uFF0C\u4F60\u53EA\u60F3\u8D95\u5FEB\u96E2\u958B\u9019\u96BB\u6050\u6016\u7684\u751F\u7269\uFF0C\u4E26\u627E\u5230\u4F60\u7684\u5BB6\u4EBA\u5011\u3002)\r\n\u4E3B\u89D2\uFF1A\u597D\u6211\u77E5\u9053\u4E86\uFF0C\u8B1D\u8B1D\u4F60\u7684\u5E6B\u5FD9\uFF01\t\r\n\u968E\u6BB539\t\u756B\u9762\t[1]\t[1]\u8207\u677E\u9F20\u4E92\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u7D42\u65BC\u51FA\u73FE\u4E86\u4E00\u96BB\u9AD4\u578B\u548C\u4F60\u5DEE\u4E0D\u591A\u7684\u52D5\u7269\uFF0C\u4F60\u611F\u5230\u975E\u5E38\u6B23\u6170\u3002)\r\n\u65C1\u767D\uFF1A(\u9019\u4E0B\u5B50\u4F60\u975E\u5E38\u6709\u4FE1\u5FC3\u53EF\u4EE5\u548C\u773C\u524D\u7684\u52D5\u7269\u4F86\u4E00\u5834\u548C\u5E73\u7684\u5C0D\u8A71\u3002)\r\n\u4E3B\u89D2\uFF1A\u54C8\u56C9\uFF01\u60F3\u8ACB\u554F\u4E00\u4E0B\u4F60\u77E5\u4E0D\u77E5\u9053\u2026\u2026\r\n\u677E\u9F20\uFF1A\u5594\uFF1F\u4F60\u662F\u8AB0\uFF1F\u7B49\u4E00\u4E0B\u7B49\u4E00\u4E0B\uFF0C\u4F60\u5148\u4E0D\u8981\u8AAA\u3002\r\n\u677E\u9F20\uFF1A\u770B\u4F60\u7684\u5916\u8868\u770B\u8D77\u4F86\u61C9\u8A72\u662F\u9CE5\u3002\u563F\u563F\u563F\uFF0C\u5C31\u8DDF\u90A3\u96BB\u7B28\u8001\u9DF9\u4E00\u6A23\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u9019\u96BB\u677E\u9F20\u975E\u5E38\u7C97\u9B6F\u7684\u6253\u65B7\u4E86\u4F60\u7684\u554F\u984C\uFF0C\u800C\u4E14\u6ED4\u6ED4\u4E0D\u7D55\u5730\u8B1B\u500B\u4E0D\u505C\u3002\u5728\u9019\u500B\u77AC\u9593\uFF0C\u4F60\u5DF2\u7D93\u77E5\u9053\u826F\u597D\u7684\u5C0D\u8A71\u5DF2\u7D93\u662F\u4E0D\u53EF\u80FD\u4E86\u3002)\r\n\u677E\u9F20\uFF1A\u6211\u525B\u525B\u5DF2\u7D93\u6253\u807D\u5230\u4E86\uFF0C\u4F60\u662F\u8981\u4F86\u627E\u4F60\u7684\u5925\u4F34\u7684\u3002\u6211\u662F\u4E0D\u77E5\u9053\u4F60\u7684\u5925\u4F34\u5728\u54EA\u88E1\u5566\uFF0C\u6211\u771F\u7684\u4E0D\u77E5\u9053\u5594\uFF01\r\n\u4E3B\u89D2\uFF1A\u4F60\u53EF\u4EE5\u5148\u8B93\u6211\u2026\u2026\r\n\u677E\u9F20\uFF1A\u4E0D\u904E\u4F60\u53EF\u4EE5\u554F\u770B\u770B\u5728\u6A39\u4E0A\u7684\u90A3\u96BB\u8001\u9DF9\uFF0C\u7562\u7ADF\u4ED6\u53EF\u4EE5\u98DB\u5F97\u5F88\u9AD8\uFF0C\u8AAA\u4E0D\u5B9A\u53EF\u4EE5\u770B\u5230\u4F60\u7684\u5BB6\u4EBA\u3002\r\n\u677E\u9F20\uFF1A\u4E0D\u904E\u9084\u4E0D\u662F\u88AB\u6211\u7684\u8A71\u641E\u7684\u5718\u5718\u8F49\uFF0C\u563F\u563F\u563F\u2026\u2026\r\n\u4E3B\u89D2\uFF1A\u90A3\u2026\u2026\r\n\u677E\u9F20\uFF1A\u4F60\u771F\u7684\u4E0D\u7528\u8B1D\u8B1D\u6211\u5566\uFF0C\u771F\u7684\u4E0D\u7528\u5566\uFF01\r\n\u65C1\u767D\uFF1A(\u677E\u9F20\u5C31\u9019\u6A23\u8DD1\u6389\u4E86\uFF0C\u4F60\u9023\u500B\u5B8C\u6574\u7684\u53E5\u5B50\u90FD\u6C92\u8AAA\u51FA\u4F86\uFF0C\u4F46\u81F3\u5C11\u4F60\u7372\u5F97\u4E86\u4E0D\u932F\u7684\u8CC7\u8A0A\u3002)\r\n\u4E3B\u89D2\uFF1A(\u600E\u9EBC\u5728\u9019\u88E1\u7684\u5927\u5BB6\u4E5F\u90FD\u602A\u602A\u7684\u2026\u2026)\t\r\n\u968E\u6BB540\t\u756B\u9762\t[1]\t[1]\u8207\u8001\u9DF9\u4E92\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u98DB\u4E86\u5F88\u9AD8\u5F88\u9AD8\uFF0C\u4F60\u624D\u9047\u5230\u4E86\u4E00\u96BB\u8001\u9DF9\u3002\u96D6\u7136\u4F60\u4E00\u76F4\u90FD\u662F\u5728\u98DB\u884C\uFF0C\u4F46\u4F60\u9084\u662F\u64D4\u5FC3\u4F60\u4E4B\u524D\u5728\u57CE\u5E02\u53D7\u7684\u50B7\u6703\u4E0D\u6703\u8B93\u4F60\u7A81\u7136\u5F9E\u9AD8\u7A7A\u6389\u4E0B\u4F86\u3002)\r\n\u8001\u9DF9\uFF1A\u6211\u77E5\u9053\u4F60\u662F\u8AB0\uFF0C\u677E\u9F20\u5DF2\u7D93\u8DDF\u6211\u8AAA\u904E\u4E86\u3002\r\n\u8001\u9DF9\uFF1A\u5305\u542B\u4F60\u5728\u6C99\u6F20\u9047\u5230\u86C7\u7684\u4E8B\u60C5\uFF0C\u6211\u5C31\u77E5\u9053\u86C7\u90FD\u4E0D\u662F\u4EC0\u9EBC\u597D\u6771\u897F\uFF01\r\n\u4E3B\u89D2\uFF1A(\u9019\u96BB\u677E\u9F20\u53EF\u771F\u662F\u516B\u5366\u3002)\r\n\u4E3B\u89D2\uFF1A\u90A3\u6211\u60F3\u8ACB\u554F\u4E00\u4E0B\uFF0C\u4F60\u6709\u770B\u5230\u6211\u7684\u5925\u4F34\u5011\u55CE\uFF1F\r\n\u8001\u9DF9\uFF1A\u4F60\u5925\u4F34\u7684\u5DE2\u5C31\u5728\u524D\u9762\uFF0C\u4E0D\u904E\u4ED6\u5011\u633A\u6392\u5916\u7684\uFF0C\u4F60\u53EF\u8981\u81EA\u5DF1\u5C0F\u5FC3\u3002\r\n\u8001\u9DF9\uFF1A\u8A71\u8AAA\u4F60\u4E00\u8DEF\u5F9E\u57CE\u5E02\u98DB\u904E\u4F86\u9019\u88E1\uFF0C\u7406\u8AD6\u4E0A\u4F86\u8AAA\u4F60\u61C9\u8A72\u7D2F\u58DE\u4E86\u2026\u2026\r\n\u8001\u9DF9\uFF1A\u4F60\u771F\u7684\u662F\u96BB\u9CE5\u55CE\uFF1F//\u9019\u53E5\u8A71\u5728\u904A\u6232\u88E1\u9762\u6539\u7D05\u8272\u7684\u5B57\r\n\u4E3B\u89D2\uFF1A(\u4ED6\u600E\u9EBC\u958B\u59CB\u8B1B\u4E00\u4E9B\u5947\u602A\u7684\u8A71\u2026\u2026\u6211\u4E0D\u662F\u96BB\u9CE5\u9084\u80FD\u662F\u4EC0\u9EBC\uFF1F)\r\n\u4E3B\u89D2\uFF1A\u6211\u7576\u7136\u662F\u96BB\u9CE5\uFF0C\u662F\u96BB\u70CF\u9D09\uFF0C\u4F60\u770B\u770B\u6211\u7684\u6A23\u5B50\u5C31\u77E5\u9053\u4E86\uFF01\r\n\u65C1\u767D\uFF1A(\u8001\u9DF9\u610F\u5473\u6DF1\u9577\u5730\u770B\u8457\u4F60\uFF0C\u4E00\u8A00\u4E0D\u767C\u7684\u5C31\u96E2\u958B\u4E86)\t\r\n\u968E\u6BB541\t\u756B\u9762\t\u70CF\u9D09\u7FA4[1][2]\u3002\t[1]
      \u8207\u70CF\u9D09\u7FA4\u4E92\u52D5\u89F8\u767C\u5287\u60C5\u3002\r\n[2]\u70CF\u9D09\u53EB\u8072\u97F3\u6548\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u7D42\u65BC\uFF01\u4F60\u6B77\u7D93\u4E86\u5343\u8F9B\u842C\u82E6\uFF0C\u4F60\u7D42\u65BC\u770B\u5230\u4E86\u4F60\u7684\u5BB6\u4EBA\u2500\u2500\u4ED6\u5011\u9577\u5F97\u8DDF\u4F60\u4E00\u6A21\u4E00\u6A23\uFF0C\u6709\u4E00\u6A23\u7684\u984F\u8272\uFF0C\u4E00\u6A23\u7684\u6BDB\u9AEE\u3002\u4F60\u5E7E\u4E4E\u53EF\u4EE5\u78BA\u5B9A\uFF0C\u4F60\u7D42\u65BC\u56DE\u5230\u2026\u2026)\r\n\u4E3B\u89D2\uFF1A\u5404\u4F4D\uFF0C\u6211\u56DE\u4F86\u4E86\uFF01\r\n\u65C1\u767D\uFF1A(\u7136\u800C\uFF0C\u4F60\u9810\u60F3\u4E2D\u7684\u611F\u4EBA\u91CD\u9022\u6C92\u6709\u767C\u751F\u3002)\r\n\u65C1\u767D\uFF1A(\u4F60\u773C\u524D\u7684\u70CF\u9D09\u7FA4\u53EA\u662F\u51B7\u51B7\u5730\u770B\u8457\u4F60\uFF0C\u9732\u51FA\u4E00\u81C9\u964C\u751F\u7684\u8868\u60C5\uFF0C\u4E26\u4E14\u4E0D\u505C\u7ACA\u7ACA\u79C1\u8A9E\u3002)\r\n\u4E3B\u89D2\uFF1A\u5404\u4F4D\u2026\u2026\uFF1F\r\n\u4E3B\u89D2\uFF1A\u5C0D\u4E86\uFF0C\u4F60\u5011\u4E00\u5B9A\u53EA\u662F\u9694\u4E86\u592A\u4E45\u8A8D\u4E0D\u51FA\u6211\uFF01\u6211\u8DDF\u4F60\u5011\u4E00\u6A23\uFF0C\u6211\u5728\u57CE\u5E02\u88E1\u8FF7\u8DEF\u4E86\uFF0C\u6211\u98DB\u4E86\u597D\u4E45\u624D\u2026\u2026\r\n\u70CF\u9D09\uFF1A\u6211\u5011\u70CF\u9D09\u662F\u4E0D\u6703\u5206\u958B\u884C\u52D5\u7684\uFF0C\u4F60\u662F\u8AB0\uFF1F\r\n\u65C1\u767D\uFF1A(\u4F60\u591A\u9EBC\u5E0C\u671B\u9019\u53EA\u662F\u5834\u6574\u4EBA\u7BC0\u76EE\uFF0C\u4F46\u4ED6\u5011\u7684\u8A9E\u6C23\u5DF2\u7D93\u5145\u8DB3\u7684\u8868\u9054\u51FA\u2500\u2500\u4F60\u548C\u4ED6\u5011\u4E26\u4E0D\u662F\u540C\u985E\u3002)\r\n\u4E3B\u89D2\uFF1A\u600E\u9EBC\u6703\u2026\u2026\u6211\u53EA\u662F\u8FF7\u8DEF\u4E86\u800C\u5DF2\u2026\u2026\r\n\u70CF\u9D09\uFF1A\u90A3\u4F60\u4ED4\u7D30\u60F3\u60F3\uFF0C\u4F60\u8A8D\u5F97\u6211\u5011\u55CE\uFF1F\r\n\u4E3B\u89D2\uFF1A\u7576\u7136\uFF0C\u6211\u2026\u2026\t\r\n\u968E\u6BB542\t\u756B\u9762\t\u50CF\u64A5\u653E\u6295\u5F71\u7247\u4E00\u6A23\u6ED1\u904E\u5E7E\u5F35\u5716\u7247\uFF0C\u5206\u5225\u662F\u5BE6\u9A57\u5BA4\u3001\u90FD\u5E02\u9047\u5230\u7684\u89D2\u8272\u3001\u6C99\u6F20\u9047\u5230\u7684\u89D2\u8272\u3001\u548C\u9032\u5165\u68EE\u6797\u5F8C\u9047\u5230\u7684\u89D2\u8272\u3002\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u5728\u9019\u77AC\u9593\uFF0C\u4F60\u56DE\u60F3\u4E86\u4E00\u4E9B\u4E4B\u524D\u767C\u751F\u7684\u4E8B\u60C5\u3002)\r\n\u65C1\u767D\uFF1A(\u4F46\u4E0D\u8AD6\u4F60\u600E\u9EBC\u601D\u8003\uFF0C\u8A18\u61B6\u53EA\u5F9E\u4F60\u5F9E\u5BE6\u9A57\u5BA4\u9192\u4F86\u90A3\u4E00\u5E55\u958B\u59CB\uFF0C\u4F60\u6C92\u6709\u66F4\u4E45\u4E4B\u524D\u7684\u8A18\u61B6\u3002)\r\n\u4E3B\u89D2\uFF1A\u2026\u2026\r\n\u70CF\u9D09\uFF1A\u6211\u662F\u9019\u7FA4\u70CF\u9D09\u7684\u9996\u9818\uFF0C\u53EB\u505A\u9727\u5C3C\u3002\r\n\u9727\u5C3C\uFF1A\u6211\u5C31\u76F4\u63A5\u8AAA\u4E86\u5427\uFF0C\u6211\u5011\u5F9E\u4F86\u6C92\u6709\u770B\u904E\u4F60\u9019\u96BB\u70CF\u9D09\u2500\u2500\u81F3\u5C11\u6211\u8A18\u61B6\u4E2D\u6C92\u6709\uFF0C\u4F46\u6211\u7684\u8A18\u61B6\u662F\u4E0D\u53EF\u80FD\u51FA\u932F\u7684\u3002\r\n\u9727\u5C3C\uFF1A\u4F60\u4ED4\u7D30\u89C0\u5BDF\u81EA\u5DF1\u5427\uFF01\u4F60\u90A3\u7FC5\u8180\u5DF2\u7D93\u53D7\u50B7\u7684\u90A3\u9EBC\u56B4\u91CD\u4E86\uFF0C\u70BA\u4EC0\u9EBC\u4F60\u9084\u80FD\u82E5\u7121\u5176\u4E8B\u7684\u98DB\u884C\uFF1F\r\n\u4E3B\u89D2\uFF1A\u56E0\u70BA\u91AB\u751F\u6709\u5E6B\u6211\u6CBB\u7642\uFF0C\u4ED6\u9084\u8DDF\u6211\u8AAA\u6709\u4E8B\u60C5\u53EF\u4EE5\u627E\u4ED6\u2026\u2026\r\n\t\r\n\u968E\u6BB543\t\u756B\u9762\t\u9ED1\u8272\u906E\u7F69\u906E\u4F4F\u756B\u9762\uFF0C\u6D6E\u73FE\u51FA\u5169\u500B\u91D1\u5C6C\u652F\u67B6\u548C\u5728\u90FD\u5E02\u9047\u5230\u7684\u91AB\u751F\u3002\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u4F60\u731B\u7136\u60F3\u8D77\uFF0C\u70BA\u4EC0\u9EBC\u91AB\u751F\u6703\u7D66\u4F60\u5169\u584A\u91D1\u5C6C\u652F\u67B6\uFF1F\u800C\u4E14\u9084\u662F\u6709\u53D7\u5230\u640D\u50B7\u7684\u91D1\u5C6C\u2026\u2026)\r\n\u4E3B\u89D2\uFF1A\u4E0D\u6703\u5427\u2026\u2026\r\n\u9727\u5C3C\uFF1A\u770B\u4F86\u4F60\u6CE8\u610F\u5230\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u6211\u597D\u6B79\u4E5F\u6D3B\u4E86\u5F88\u9577\u4E00\u6BB5\u6642\u9593\uFF0C\u4E5F\u77E5\u9053\u4E86\u4E0D\u5C11\u4E8B\u60C5\u3002\r\n\u9727\u5C3C\uFF1A\u6211\u6709\u807D\u8AAA\u73FE\u5728\u5916\u9762\u7684\u4E16\u754C\u79D1\u6280\u8D8A\u4F86\u8D8A\u767C\u9054\uFF0C\u5DF2\u7D93\u9060\u8D85\u51FA\u6211\u5011\u7684\u60F3\u50CF\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u6211\u539F\u672C\u9084\u5728\u64D4\u5FC3\u6703\u4E0D\u6703\u5F15\u60F3\u5230\u6211\u5011\u9019\u7247\u68EE\u6797\uFF0C\u6C92\u60F3\u5230\u9019\u4E00\u5929\u9019\u9EBC\u5FEB\u5C31\u4F86\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u4F60\u6839\u672C\u4E0D\u662F\u96BB\u70CF\u9D09\uFF0C\u4F60\u53EA\u662F\u96BB\u6A5F\u5668\u4EBA\u3002\r\n\u9727\u5C3C\uFF1A\u4F60\u53EA\u662F\u8A8D\u70BA\u81EA\u5DF1\u662F\u96BB\u70CF\u9D09\uFF0C\u4F46\u5BE6\u969B\u4E0A\u4F60\u6839\u672C\u4E0D\u5C6C\u65BC\u9019\u88E1\u3002\u4F60\u53EA\u662F\u5F9E\u4F60\u300C\u8166\u888B\u300D\u88E1\u641C\u5C0B\u51FA\u4E86\u6700\u9069\u5408\u4F60\u5C45\u4F4F\u7684\u5730\u65B9\u3002\t\r\n\u968E\u6BB544\t\u756B\u9762\t\t\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u5C0D\u65BC\u4ED6\u5011\u8AAA\u7684\u4E8B\u60C5\uFF0C\u4F60\u4E0D\u9858\u76F8\u4FE1\uFF0C\u4F46\u4ED4\u7D30\u56DE\u60F3\u9019\u4E00\u8DEF\u767C\u751F\u7684\u4E8B\u60C5\uFF0C\u6709\u592A\u591A\u4E0D\u5408\u7406\u7684\u5730\u65B9\u4E86)\r\n\u65C1\u767D\uFF1A(\u70BA\u4EC0\u9EBC\u6211\u6C92\u6709\u4E4B\u524D\u7684\u8A18\u61B6\uFF1F\u70BA\u4EC0\u9EBC\u6211\u4E0D\u611F\u89BA\u4E0D\u5230\u99F1\u99DD\u8AAA\u7684\u51B7\uFF1F\u70BA\u4EC0\u9EBC\u9D15\u9CE5\u7D66\u6211\u7684\u6C34\u8DDF\u5728\u57CE\u5E02\u62FF\u5230\u7684\u6C34\u4E0D\u4E00\u6A23\uFF1F)\r\n\u65C1\u767D\uFF1A(\u5230\u6700\u5F8C\uFF0C\u4F60\u4E0D\u5F97\u4E0D\u627F\u8A8D\u2026\u2026)\r\n\u65C1\u767D\uFF1A(\u4F60\u4E26\u4E0D\u662F\u96BB\u70CF\u9D09\uFF0C\u4F60\u53EA\u662F\u9AD8\u79D1\u6280\u4E0B\u7684\u7522\u7269\u3002)\r\n\u65C1\u767D\uFF1A(\u4F60\u6C92\u6709\u547C\u5438\uFF0C\u4F60\u6C92\u6709\u5FC3\u8DF3\uFF0C\u4F60\u6240\u6709\u7684\u4E00\u5207\u53EA\u662F\u75311\u548C0\u7D44\u5408\u8D77\u4F86\u7684\u3002)\t\r\n\u968E\u6BB545\t\u756B\u9762\t\u6A5F\u5668\u4EBA\u653E\u5927\u5716\u793A\u3002\t\r\n\t\u5C0D\u8A71\t\u5435\u96DC\u7684\u6A5F\u5668\u4EBA\u8072\u97F3\uFF1A\u6211\u525B\u525B\u770B\u5230\u4ED6\u5F80\u9019\u88E1\u8D70\u4E86\uFF01\u8A72\u6B7B\u7684\u5BE6\u9A57\u54C1\uFF0C\u600E\u9EBC\u9019\u9EBC\u80FD\u8DD1\uFF01\r\n\u65C1\u767D\uFF1A(\u56DE\u982D\u671B\u53BB\uFF0C\u4F60\u770B\u898B\u4E86\u8A31\u591A\u57CE\u5E02\u88E1\u898B\u904E\u7684\u6A5F\u5668\u4EBA\u3002\u4F60\u5F88\u5FEB\u7684\u610F\u8B58\u5230\uFF0C\u4ED6\u5011\u53E3\u4E2D\u7684\u5BE6\u9A57\u54C1\u5C31\u662F\u6307\u4F60\uFF0C\u4ED6\u5011\u662F\u4F86\u8FFD\u6355\u4F60\u7684\u3002)\r\n\u4E3B\u89D2\uFF1A\u8A72\u600E\u9EBC\u8FA6\u2026\u2026\u6211\u8A72\u53BB\u54EA\u88E1\uFF1F\r\n\u9727\u5C3C\uFF1A\u4F60\u8DDF\u4ED6\u5011\u8D70\u5427\uFF0C\u4F60\u548C\u6211\u5011\u4E26\u4E0D\u662F\u540C\u985E\uFF0C\u4E0D\u8981\u518D\u5E36\u7D66\u6211\u5011\u56F0\u64FE\u4E86\u3002\t\r\n\u968E\u6BB546\t\u756B\u9762\t[1]\t[1]\u6C92\u6709\u5F9E\u6597\u7BF7\u602A\u5496\u90A3\u88CF\u7372\u5F97\u5716\u9A30(\u7D66\u4E88\u91D1\u5C6C\u652F\u67B6\u5F8C\u6703\u7372\u5F97)\u89F8\u767C\u6B64\u8655\u5287\u60C5\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u807D\u5B8C\u9727\u5C3C\u7684\u8A71\uFF0C\u4F60\u53EA\u80FD\u7D55\u671B\u5730\u770B\u8457\u70CF\u9D09\u5011\u98DB\u96E2\u4F60\uFF0C\u4ED6\u5011\u6C92\u6709\u4E00\u7D72\u7684\u7336\u8C6B\u3002)\r\n\u65C1\u767D\uFF1A(\u4F60\u60F3\u653E\u8072\u5927\u54ED\uFF0C\u4E0D\u9858\u63A5\u53D7\u9019\u500B\u4E8B\u5BE6\u3002\u4F46\u4F60\u4E5F\u53EA\u662F\u96BB\u6A5F\u5668\u9CE5\uFF0C\u4F60\u9023\u54ED\u6CE3\u7684\u529F\u80FD\u90FD\u6C92\u6709\uFF0C\u53EA\u80FD\u773C\u775C\u775C\u7684\u770B\u8457\u6A5F\u5668\u4EBA\u5011\u6293\u4F4F\u4F60\u51B0\u51B7\u7684\u8EAB\u9AD4\u3002)\r\n\u5435\u96DC\u7684\u6A5F\u5668\u4EBA\u8072\u97F3\uFF1A\u7D42\u65BC\u88AB\u6211\u6293\u5230\u4F60\u4E86\uFF01002\u865F\uFF0C\u8DDF\u6211\u56DE\u5BE6\u9A57\u5BA4\u5427\uFF0C\u6211\u5011\u5F97\u597D\u597D\u7814\u7A76\u4F60\u90FD\u505A\u4E86\u4E9B\u4EC0\u9EBC\u4E8B\u60C5\uFF01\r\n\u65C1\u767D\uFF1A(\u5C31\u9019\u6A23\uFF0C\u4F60\u7684\u5C0B\u5BB6\u4E4B\u65C5\u7D50\u675F\u4E86\u3002)\r\n\u65C1\u767D\uFF1A(\u6216\u8005\u8AAA\uFF0C\u73FE\u5728\u624D\u662F\u771F\u7684\u8981\u56DE\u5230\u5C6C\u65BC\u4F60\u7684\u300C\u5BB6\u300D\u2026.)\t\r\n\u968E\u6BB547\t\u756B\u9762\t[1]\u5716\u9A30\u51FA\u73FE\u5728\u756B\u9762\u4E0A\u3002\t[1]\u6709\u62FF\u5230\u5716\u9A30\u5F8C\u5728\u6B64\u8655\u6703\u81EA\u52D5\u4F7F\u7528\u3002\r\n\t\u5C0D\u8A71\t\u65C1\u767D\uFF1A(\u807D\u5B8C\u9727\u5C3C\u8AAA\u7684\u8A71\uFF0C\u4F60\u5446\u5750\u5728\u539F\u5730\uFF0C\u4E0D\u9858\u63A5\u53D7\u9019\u500B\u4E8B\u5BE6\u3002)\r\n\u9727\u5C3C\uFF1A\u4F60\u9019\u662F\u54EA\u4F86\u7684\uFF1F\r\n\u65C1\u767D\uFF1A(\u9727\u5C3C\u9707\u9A5A\u5730\u770B\u8457\u4F60\u63E1\u8457\u7684\u5716\u9A30\u2500\u2500\u662F\u90FD\u5E02\u88E1\u90A3\u500B\u6597\u7BF7\u602A\u5496\u7D66\u4F60\u7684\uFF0C\u4F60\u5728\u6C99\u6F20\u6642\u56E0\u70BA\u6C92\u6709\u559D\u5230\u98F2\u6599\u800C\u611F\u5230\u975E\u5E38\u751F\u6C23\u3002)
      \r\n\u4E3B\u89D2\uFF1A\u9019\u662F\u6211\u5728\u90FD\u5E02\u88E1\u9047\u5230\u4E00\u500B\u7A7F\u8457\u6597\u7BF7\u7684\u602A\u4EBA\uFF0C\u5E6B\u52A9\u4ED6\u4E4B\u5F8C\u4ED6\u7D66\u6211\u7684\u8B1D\u79AE\u3002\r\n\u65C1\u767D\uFF1A(\u9727\u5C3C\u807D\u5B8C\u4E4B\u5F8C\u5F77\u5F7F\u60F3\u8D77\u4E86\u4EC0\u9EBC\uFF0C\u6C89\u601D\u4E86\u4E00\u6703\u3002)\r\n\u9727\u5C3C\uFF1A\u66FE\u7D93\u6211\u5011\u6709\u4E00\u500B\u540C\u4F34\uFF0C\u4ED6\u56AE\u5F80\u81EA\u7531\u3001\u4E0D\u88AB\u5BB6\u65CF\u7BA1\u7406\u7684\u751F\u6D3B\uFF0C\u65BC\u662F\u4ED6\u6BC5\u7136\u6C7A\u7136\u7684\u96E2\u958B\u4E86\u70CF\u9D09\u7FA4\u9AD4\uFF0C\u671D\u8457\u9060\u65B9\u98DB\u53BB\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u5F88\u5947\u602A\u5427\uFF01\u660E\u660E\u5DF2\u7D93\u8EAB\u70BA\u9CE5\u4E86\uFF0C\u537B\u9084\u60F3\u8457\u81EA\u7531\u7684\u751F\u6D3B\u3002\r\n\u4E3B\u89D2\uFF1A\u4F46\u4F60\u4E0D\u662F\u8AAA\u70CF\u9D09\u4E0D\u80FD\u7368\u81EA\u751F\u6D3B\u55CE\uFF1F\r\n\u9727\u5C3C\uFF1A\u5C0D\uFF0C\u6240\u4EE5\u6211\u5011\u5927\u5BB6\u90FD\u8A8D\u70BA\u4ED6\u5DF2\u7D93\u96E2\u4E16\u4E86\u3002\r\n\u9727\u5C3C\uFF1A\u9019\u662F\u6211\u7576\u521D\u4EA4\u4ED8\u7D66\u4ED6\u7684\u4FE1\u7269\uFF0C\u9019\u6A23\u6211\u5011\u624D\u80FD\u8A8D\u51FA\u4F86\u3002\r\n\u9727\u5C3C\uFF1A\u4F60\u62FF\u5230\u4E86\u4FE1\u7269\uFF0C\u90A3\u7576\u521D\u90A3\u500B\u7A7F\u6597\u7BF7\u7684\u602A\u4EBA\u61C9\u8A72\u5C31\u662F\u4ED6\u3002\u5927\u6982\u662F\u4F60\u5E6B\u52A9\u4E86\u4ED6\uFF0C\u4ED6\u624D\u6703\u5C07\u9019\u4FE1\u7269\u4EA4\u7D66\u4F60\u3002\r\n\u9727\u5C3C\uFF1A\u4ED6\u9084\u662F\u4E00\u6A23\u90A3\u9EBC\u50BB\uFF0C\u653E\u68C4\u4E86\u81EA\u5DF1\u56DE\u5BB6\u7684\u6A5F\u6703\u2026\u2026\r\n\u65C1\u767D\uFF1A(\u9727\u5C3C\u8AAA\u5B8C\u9019\u4E9B\u8A71\u5F8C\u53C8\u9677\u5165\u4E86\u6C89\u601D\uFF0C\u4F46\u773C\u4E0B\u57CE\u5E02\u7684\u8FFD\u5175\u5DF2\u7D93\u8D8A\u4F86\u8D8A\u63A5\u8FD1\u4E86\uFF0C\u4F60\u5F97\u8D95\u5FEB\u9760\u81EA\u5DF1\u60F3\u51FA\u812B\u8EAB\u7684\u8FA6\u6CD5\u3002)\r\n\u9727\u5C3C\uFF1A\u8DDF\u6211\u5011\u8D70\u5427\uFF01\r\n\u4E3B\u89D2\uFF1A\u4EC0\u9EBC\uFF1F\u4F46\u4F60\u525B\u525B\u4E0D\u662F\u8AAA\u2026\u2026\r\n\u9727\u5C3C\uFF1A\u6211\u53EA\u662F\u64D4\u5FC3\u4F60\u7684\u5230\u4F86\u6703\u4E0D\u6703\u5C0D\u6211\u5011\u539F\u672C\u548C\u5E73\u7684\u751F\u6D3B\u5E36\u4F86\u6539\u8B8A\uFF0C\u4F46\u65E2\u7136\u4F60\u5E6B\u52A9\u4E86\u6211\u5011\u7684\u5925\u4F34\uFF0C\u4ED6\u9078\u64C7\u76F8\u4FE1\u4E86\u4F60\u2026\u2026\r\n\u9727\u5C3C\uFF1A\u90A3\u6211\u5011\u6216\u8A31\u53EF\u4EE5\u8A66\u8457\u63A5\u7D0D\u4F60\u3002\r\n\u65C1\u767D\uFF1A(\u8AAA\u6642\u9072\u90A3\u6642\u5FEB\uFF0C\u5E95\u4E0B\u7684\u8FFD\u5175\u6CE8\u610F\u5230\u9019\u88E1\u4E86\u3002\u9727\u5C3C\u8DDF\u70CF\u9D09\u7FA4\u5011\u793A\u610F\u4F60\u8DDF\u8457\u4ED6\u5011\u4E00\u8D77\u96E2\u958B\uFF0C\u524D\u5F80\u4E0B\u4E00\u7247\u68EE\u6797\u3002)\r\n\u65C1\u767D\uFF1A(\u4E00\u6BB5\u6642\u9593\u7684\u98DB\u884C\u5F8C\uFF0C\u5DF2\u7D93\u770B\u4E0D\u5230\u5E95\u4E0B\u7684\u8FFD\u5175\u4E86\u3002)\r\n\u65C1\u767D\uFF1A(\u5F9E\u73FE\u5728\u958B\u59CB\uFF0C\u4F60\u5C07\u6703\u548C\u9019\u7FA4\u70CF\u9D09\u5171\u5EA6\u9918\u751F\uFF0C\u7562\u7ADF\u4F60\u662F\u4ED6\u5011\u7684\u300C\u540C\u985E\u300D\u3002)\r\n\u65C1\u767D\uFF1A(\u4F46\u9019\u6A23\uFF0C\u771F\u7684\u662F\u4F60\u60F3\u8981\u7684\u751F\u6D3B\u55CE\uFF1F)\t\r\n\r\n\r\n\u64CA\u6536\u6559\u6574\u6587\u6599\u65B0\u65B9\u65C1\u660E\u662F\u6642\u66F4\u6703\u6709\u6771\u677F\u6797\u679A\u679D\u67E5\u6839\u68B0\u68C4\u68EE\u6A02\u6A23\u6A39\u6A5F\u6A94\u6B04\u6B21\u6B63\u6BCD\u6C34\u6C99\u6CB9\u6CD5\u6E34\u6ED1\u6F20\u7070\u70BA\u7121\u7269\u73A9\u73FE\u74F6\u7528\u754C\u7559\u756B\u767B\u767C\u767D\u7684\u76D2\u76E1\u76E4\u76F4\u770B\u77E5\u786C\u793A\u7A00\u7A31\u7A7A\u7AE0\u7B97\u7BAD\u7BC0\u7CFB\u7D00\u7D22\u7D55\u7D66\u7D71\u7D93\u7DCA\u7E7C\u7E8C\u800C\u80CC\u80E1\u81C2\u820A\u8272\u82F1\u8457\u8655\u88CF\u88E1\u897F\u8981\u8996\u89BA\u89C0\u89D2\u89F8\u8A2D\u8A62\u8A71\u8A72\u8AAA\u8AB0\u8ACB\u8B1D\u8B80\u8CB7\u8D70\u8D77\u8D95\u8DD1\u8DDF\u8DF3\u8EAB\u8FFD\u9000\u9017\u9019\u9032\u904A\u904E\u9053\u9078\u907A\u9084\u908A\u90A3\u90FD\u91CF\u91D1\u9215\u9304\u9375\u9580\u9589\u958B\u95DC\u96BB\u96DC\u96E2\u9707\u9762\u97F3\u9801\u982D\u984D\u986F\u98DF\u98F2\u9996\u9A57\u9AD2\u9AD4\u9CE5\u9EBC\u9EDE\u9F20\uFF01\uFF08\uFF09\uFF0C\uFF1B\uFF1F"
